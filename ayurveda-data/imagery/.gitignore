# ayurveda-data/imagery/.gitignore
#
# The imagery folder is a live working tree: a generation loop writes into it
# continuously. Track the things that define the work, ignore the things that
# record a particular run of it.
#
# TRACKED, deliberately:
#   *.py *.js *.sh      the pipeline
#   README.md
#   jobs.json           2.2 MB, all 1,844 prompts. Regenerable from
#                       build_batches.py, but it pins styleHash c8d83786a68f —
#                       and if that hash moves, every image already downloaded
#                       orphans and gets regenerated. Worth 2.2 MB to freeze.
#   MANIFEST.json
#   reuse-map.json      the 324 dravyas that need no generation at all

# --- run artefacts: specific to one machine and one night ---
__pycache__/
*.log
loop-state.txt

# --- scratch captures from debugging the Flow bridge ---
_flow.png
_spotcheck.png
_inspect*.json

# --- derived, and rebuilt from scratch every time ---
accepted/
rejected/
results/
dist/

# --- the legacy batch model, emitted only behind build_batches.py --batches ---
queue/
done/
failed/

# --- never: the images themselves live outside the repo in ~/wise-eating-images
#     (243 MB and growing past the 90 MB tracked-file limit long ago) ---
*.jpeg
*.jpg
*.png
!../tools/style-reference.png
