# Copy to the server's env file (root-only, not in git). No real values here.
NODE_ENV=production
PORT=3020
DATABASE_URL=postgresql://ayura_assistant:CHANGE_ME@wonek-postgres:5432/ayura_assistant
JWT_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS

# OpenAI (server only; never in the app)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REASONING_MODEL=gpt-6.2-sol
OPENAI_CLIENT_SECRET_SECONDS=120

# Credits (owner decisions)
CREDITS_PER_USD=100
ONBOARDING_GRANT_ENABLED=true
ONBOARDING_GRANT_CREDITS=60
MIN_CREDITS_TO_START=2
VOICE_FLOOR_CREDITS_PER_MINUTE=3
VOICE_SESSION_MAX_MINUTES=20
CREDITS_PACK_SMALL=300
CREDITS_PACK_LARGE=1500
CREDITS_SUB_MONTHLY=500
CREDITS_SUB_YEARLY=6000

# Apple
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_ENVIRONMENT=Production
APP_ATTEST_REQUIRED=true
APP_ATTEST_ALLOW_DEVELOPMENT=false
DEVICECHECK_REQUIRED=true
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
ALLOW_UNVERIFIED_STOREKIT_JWS=false
