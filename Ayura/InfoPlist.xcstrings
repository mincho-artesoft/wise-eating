    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ تطبيق Ayurveda & Asana Yoga تقويمك ويحدّثه لحفظ وجباتك وقوائم تسوقك وتمارينك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga чете и актуализира календара ти, за да запазва твоите хранения, списъци за пазаруване и тренировки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার খাবার, কেনাকাটার তালিকা এবং ওয়ার্কআউট সংরক্ষণ করতে Ayurveda & Asana Yoga আপনার ক্যালেন্ডার পড়ে এবং আপডেট করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga llegeix i actualitza el teu calendari per desar-hi els àpats, les llistes de la compra i els entrenaments."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga čte a aktualizuje váš kalendář, aby mohla ukládat vaše jídla, nákupní seznamy a tréninky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga læser og opdaterer din kalender for at gemme dine måltider, indkøbslister og træninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga liest und aktualisiert deinen Kalender, um deine Mahlzeiten, Einkaufslisten und Workouts zu speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Ayurveda & Asana Yoga διαβάζει και ενημερώνει το ημερολόγιό σου για να αποθηκεύει τα γεύματα, τις λίστες αγορών και τις προπονήσεις σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ayurveda & Asana Yoga reads and updates your calendar to save your meals, shopping lists, and workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lee y actualiza tu calendario para guardar tus comidas, listas de la compra y entrenamientos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lee y actualiza tu calendario para guardar tus comidas, listas de compras y entrenamientos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lukee ja päivittää kalenteriasi tallentaakseen ateriasi, ostoslistasi ja treenisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lit et met à jour ton calendrier pour enregistrer tes repas, tes listes de courses et tes entraînements."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lit et met à jour votre calendrier pour enregistrer vos repas, vos listes d'épicerie et vos entraînements."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga તમારા ભોજન, ખરીદીની યાદીઓ અને વર્કઆઉટ્સ સાચવવા માટે તમારું કૅલેન્ડર વાંચે છે અને અપડેટ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga קוראת ומעדכנת את היומן שלך כדי לשמור את הארוחות, רשימות הקניות והאימונים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga आपके भोजन, खरीदारी सूचियों और वर्कआउट को सहेजने के लिए आपका कैलेंडर पढ़ता और अपडेट करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga čita i ažurira tvoj kalendar za spremanje tvojih obroka, popisa za kupnju i treninga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ayurveda & Asana Yoga olvassa és frissíti a naptáradat, hogy elmenthesse az étkezéseidet, bevásárlólistáidat és edzéseidet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga membaca dan memperbarui kalender Anda untuk menyimpan waktu makan, daftar belanja, dan latihan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga legge e aggiorna il tuo calendario per salvare pasti, liste della spesa e allenamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yogaは、食事、買い物リスト、ワークアウトを保存するためにカレンダーを読み取り・更新します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga тағамдарыңызды, сатып алу тізімдеріңізді және жаттығуларыңызды сақтау үшін күнтізбеңізді оқиды және жаңартады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಊಟಗಳು, ಶಾಪಿಂಗ್ ಪಟ್ಟಿಗಳು ಮತ್ತು ವರ್ಕೌಟ್‌ಗಳನ್ನು ಉಳಿಸಲು Ayurveda & Asana Yoga ನಿಮ್ಮ ಕ್ಯಾಲೆಂಡರ್ ಅನ್ನು ಓದುತ್ತದೆ ಮತ್ತು ನವೀಕರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga는 식단, 장보기 목록 및 워크아웃을 저장하기 위해 캘린더를 읽고 업데이트합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ഭക്ഷണവേളകൾ, ഷോപ്പിംഗ് ലിസ്റ്റുകൾ, വ്യായാമങ്ങൾ എന്നിവ സേവ് ചെയ്യുന്നതിനായി Ayurveda & Asana Yoga നിങ്ങളുടെ കലണ്ടർ വായിക്കുകയും അപ്ഡേറ്റ് ചെയ്യുകയും ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे जेवण, खरेदीच्या याद्या आणि वर्कआउट्स जतन करण्यासाठी Ayurveda & Asana Yoga तुमचे कॅलेंडर वाचते आणि अपडेट करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga membaca dan mengemas kini kalendar anda untuk menyimpan hidangan, senarai beli-belah dan senaman anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga leser og oppdaterer kalenderen din for å lagre måltider, handlelister og treningsøkter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga leest je agenda en werkt deze bij om je maaltijden, boodschappenlijsten en workouts op te slaan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ଭୋଜନ, କିଣାକିଣି ତାଲିକା ଏବଂ ୱାର୍କଆଉଟ୍ ସଞ୍ଚୟ କରିବାକୁ Ayurveda & Asana Yoga ଆପଣଙ୍କ କ୍ୟାଲେଣ୍ଡର ପଢ଼େ ଏବଂ ଅପଡେଟ୍ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga ਤੁਹਾਡੇ ਭੋਜਨ, ਖ਼ਰੀਦਦਾਰੀ ਸੂਚੀਆਂ ਅਤੇ ਵਰਕਆਊਟਾਂ ਨੂੰ ਸੇਵ ਕਰਨ ਲਈ ਤੁਹਾਡਾ ਕੈਲੰਡਰ ਪੜ੍ਹਦੀ ਅਤੇ ਅੱਪਡੇਟ ਕਰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Ayurveda & Asana Yoga odczytuje i aktualizuje Twój kalendarz, aby zapisywać posiłki, listy zakupów i treningi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ayurveda & Asana Yoga lê e atualiza seu calendário para salvar suas refeições, listas de compras e treinos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga lê e atualiza o teu calendário para guardar as tuas refeições, listas de compras e treinos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga citește și actualizează calendarul tău pentru a salva mesele, listele de cumpărături și antrenamentele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga читает и обновляет ваш календарь, чтобы сохранять приёмы пищи, списки покупок и тренировки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga číta a aktualizuje váš kalendár, aby mohla ukladať vaše jedlá, nákupné zoznamy a tréningy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga bere in posodablja vaš koledar za shranjevanje vaših obrokov, nakupovalnih seznamov in vadb."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga läser och uppdaterar din kalender för att spara dina måltider, inköpslistor och träningspass."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் உணவுகள், ஷாப்பிங் பட்டியல்கள் மற்றும் உடற்பயிற்சிகளைச் சேமிக்க Ayurveda & Asana Yoga உங்கள் நாட்காட்டியைப் படித்துப் புதுப்பிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ భోజనాలు, షాపింగ్ జాబితాలు మరియు వర్కవుట్‌లను సేవ్ చేయడానికి Ayurveda & Asana Yoga మీ క్యాలెండర్‌ను చదువుతుంది మరియు అప్‌డేట్ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga จะอ่านและอัปเดตปฏิทินของคุณเพื่อบันทึกมื้ออาหาร รายการซื้อของ และการออกกำลังกาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga, öğünlerinizi, alışveriş listelerinizi ve antrenmanlarınızı kaydetmek için takviminizi okur ve günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga читає та оновлює ваш календар, щоб зберігати ваші прийоми їжі, списки покупок і тренування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga آپ کے کھانوں، خریداری کی فہرستوں اور ورزشوں کو محفوظ کرنے کے لیے آپ کا کیلنڈر پڑھتا اور اپڈیٹ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga đọc và cập nhật lịch của bạn để lưu bữa ăn, danh sách mua sắm và buổi tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga 会读取并更新你的日历，以保存你的餐食、购物清单和训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayurveda & Asana Yoga 會讀取並更新你的行事曆，以儲存你的餐點、購物清單與鍛鍊。"
          }
        }
      }
    },
