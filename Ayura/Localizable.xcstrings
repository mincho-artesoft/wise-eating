        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அனைத்துக் குறிப்புகளையும் பார்க்க, தேதி வரம்பைச் சரிசெய்யவும் அல்லது வடிகட்டியை அழிக்கவும்."
          }
