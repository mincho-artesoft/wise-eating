    "You haven't linked this food item to any notes yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تربط عنصر الطعام هذا بأي ملاحظات بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още нямаш бележки, свързани с тази храна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনো এই খাবারটি কোনো নোটের সাথে যুক্ত করেননি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no has enllaçat aquest aliment a cap nota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto potravinu jste zatím nepropojili s žádnými poznámkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endnu ikke knyttet denne fødevare til nogen noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dieses Lebensmittel noch mit keinen Notizen verknüpft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις συνδέσει αυτή την τροφή με καμία σημείωση ακόμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no has vinculado este alimento a ninguna nota."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has vinculado este alimento a ninguna nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä linkittänyt tätä ruokaa mihinkään muistiinpanoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as encore lié cet aliment à aucune note."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez encore lié cet aliment à aucune note."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હજી સુધી આ ખોરાકને કોઈ નોંધ સાથે લિંક કર્યો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא קישרת פריט מזון זה להערות כלשהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस खाद्य पदार्थ को अभी तक किसी नोट से लिंक नहीं किया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova namirnica još nije povezana ni s jednom bilješkom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem kapcsoltad ezt az élelmiszert egyetlen jegyzethez sem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menautkan makanan ini ke catatan mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora collegato questo alimento ad alcuna nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食品はまだメモにリンクされていません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өнімді әлі ешбір жазбамен байланыстырмағансыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ಈ ಆಹಾರ ಪದಾರ್ಥವನ್ನು ಯಾವುದೇ ಟಿಪ್ಪಣಿಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식품을 연결한 메모가 아직 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ ഭക്ഷണ ഇനം ഇതുവരെ ഒരു കുറിപ്പുമായും ലിങ്ക് ചെയ്തിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही हा अन्नपदार्थ अद्याप कोणत्याही नोंदीशी जोडलेला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum memautkan item makanan ini ke mana-mana nota lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke knyttet denne matvaren til noen notater ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt dit voedingsmiddel nog niet aan notities gekoppeld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏପର୍ଯ୍ୟନ୍ତ ଏହି ଖାଦ୍ୟ ସାମଗ୍ରୀକୁ କୌଣସି ନୋଟ୍ ସହିତ ସଂଯୁକ୍ତ କରିନାହାନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅਜੇ ਤੱਕ ਇਸ ਭੋਜਨ ਨੂੰ ਕਿਸੇ ਵੀ ਨੋਟ ਨਾਲ ਲਿੰਕ ਨਹੀਂ ਕੀਤਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie powiązano jeszcze tego produktu z żadnymi notatkami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não vinculou este alimento a nenhuma nota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não associaste este alimento a nenhuma nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai asociat încă acest aliment cu nicio notă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ещё не привязали этот продукт ни к одной заметке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto potravinu ste zatiaľ neprepojili so žiadnymi poznámkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega živila še niste povezali z nobenimi zapiski."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte länkat detta livsmedel till några anteckningar ännu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உணவுப் பொருளை நீங்கள் இன்னும் எந்தக் குறிப்புகளுடனும் இணைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా ఈ ఆహార పదార్థాన్ని ఏ నోట్స్‌కూ లింక్ చేయలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้เชื่อมโยงรายการอาหารนี้กับโน้ตใด ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu besini henüz hiçbir notla ilişkilendirmediniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не прив’язали цей продукт до жодної нотатки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی تک اس غذائی شے کو کسی نوٹ سے منسلک نہیں کیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa liên kết thực phẩm này với ghi chú nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未将此食物关联到任何笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未將此食物項目連結到任何筆記。"
          }
        }
      }
