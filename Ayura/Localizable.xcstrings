          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът се изтегля или подготвя. Моля, опитай отново след малко."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেলটি ডাউনলোড বা প্রস্তুত হচ্ছে। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El model s'està baixant o preparant. Torna-ho a provar d'aquí a una estona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se stahuje nebo připravuje. Zkuste to prosím za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen downloades eller klargøres. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wird geladen oder vorbereitet. Bitte versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο βρίσκεται σε λήψη ή προετοιμασία. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo se está descargando o preparando. Inténtalo de nuevo en unos instantes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo se está descargando o preparando. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Malli latautuu tai valmistautuu. Yritä pian uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en cours de téléchargement ou de préparation. Réessaie dans quelques instants."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en cours de téléchargement ou de préparation. Veuillez réessayer sous peu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૉડલ ડાઉનલોડ અથવા તૈયાર થઈ રહ્યું છે. કૃપા કરીને થોડી વારમાં ફરી પ્રયાસ કરો."
