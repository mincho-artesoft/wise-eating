    "You'll be notified when your food is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك إشعار عندما يكون طعامك جاهزًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще получиш известие, когато храната ти е готова."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খাবার তৈরি হলে আপনাকে জানানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebràs una notificació quan el teu aliment estigui a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až bude vaše potravina připravena, obdržíte oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får besked, når din fødevare er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst benachrichtigt, sobald dein Lebensmittel fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ειδοποιηθείς όταν το τρόφιμό σου είναι έτοιμο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás una notificación cuando tu alimento esté listo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Te notificaremos cuando tu alimento esté listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun ruokasi on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recevras une notification quand ton aliment sera prêt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une notification lorsque votre aliment sera prêt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ખોરાક તૈયાર થશે ત્યારે તમને સૂચિત કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקבל התראה כשהמזון שלך יהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाद्य पदार्थ तैयार होने पर आपको सूचित किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobit ćeš obavijest kad namirnica bude spremna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítünk, amint elkészült az ételed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan diberi tahu saat makanan Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai una notifica quando il tuo alimento sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品の準備ができたら通知されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағамыңыз дайын болғанда хабарлама аласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಆಹಾರ ಸಿದ್ಧವಾದಾಗ ನಿಮಗೆ ತಿಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식품이 준비되면 알려드립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഭക്ഷണം തയ്യാറാകുമ്പോൾ നിങ്ങളെ അറിയിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पदार्थ तयार झाल्यावर तुम्हाला कळवले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan dimaklumkan apabila makanan anda siap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får varsel når matvaren er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt een melding wanneer je voedingsmiddel klaar is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଖାଦ୍ୟ ପ୍ରସ୍ତୁତ ହେଲେ ଆପଣଙ୍କୁ ସୂଚିତ କରାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਭੋਜਨ ਤਿਆਰ ਹੋਣ 'ਤੇ ਤੁਹਾਨੂੰ ਸੂਚਿਤ ਕੀਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz powiadomienie, gdy produkt będzie gotowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será notificado quando seu alimento estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás uma notificação quando o teu alimento estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei primi o notificare când alimentul este gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, когда продукт будет готов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď bude vaša potravina pripravená, dostanete upozornenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obveščeni boste, ko bo vaše živilo pripravljeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får en notis när ditt livsmedel är klart."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உணவு தயாரானதும் உங்களுக்குத் தெரிவிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆహారం సిద్ధమైనప్పుడు మీకు తెలియజేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับการแจ้งเตือนเมื่ออาหารของคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besininiz hazır olduğunda bildirim alacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримаєте сповіщення, коли ваш продукт буде готовий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کی غذا تیار ہو جائے گی تو آپ کو مطلع کیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được thông báo khi thực phẩm đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食物准备就绪后将通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的食物準備好時會收到通知。"
          }
        }
      }
    },
