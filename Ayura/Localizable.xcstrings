        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα προσθέσει προπονήσεις για %@. Πώς να αντιμετωπιστούν οι προπονήσεις που έχουν συγκεκριμένη ώρα;"
