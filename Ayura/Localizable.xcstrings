    "Open Settings → Apps → Ayura → Notifications and turn on Allow Notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات ← التطبيقات ← Ayura ← الإشعارات وفعّل السماح بالإشعارات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори Настройки → Приложения → Ayura → Известия и включи Разреши известия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস → অ্যাপস → Ayura → বিজ্ঞপ্তি খুলুন এবং “বিজ্ঞপ্তির অনুমতি দিন” চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Configuració → Apps → Ayura → Notificacions i activa Permet les notificacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Nastavení → Aplikace → Ayura → Oznámení a zapněte Povolit oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Indstillinger → Apps → Ayura → Notifikationer, og slå Tillad notifikationer til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen → Apps → Ayura → Mitteilungen und aktiviere „Mitteilungen erlauben“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε Ρυθμίσεις → Εφαρμογές → Ayura → Γνωστοποιήσεις και ενεργοποίησε την επιλογή «Να επιτρέπονται οι γνωστοποιήσεις»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes → Apps → Ayura → Notificaciones y activa Permitir notificaciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Configuración → Apps → Ayura → Notificaciones y activa Permitir notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Asetukset → Apit → Ayura → Ilmoitukset ja laita Salli ilmoitukset päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Réglages → Apps → Ayura → Notifications et active Autoriser les notifications."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages → Apps → Ayura → Notifications et activez Autoriser les notifications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સ → ઍપ્સ → Ayura → સૂચનાઓ ખોલો અને “સૂચનાઓને અનુમતિ આપો” ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח הגדרות ← יישומים ← Ayura ← עדכונים והפעל את ״אפשר עדכונים״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ → ऐप्स → Ayura → सूचनाएँ खोलें और ‘सूचनाओं को अनुमति दें’ चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Postavke → Aplikacije → Ayura → Obavijesti i uključi Dozvoli obavijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Beállítások → Appok → Ayura → Értesítések menüpontot, és kapcsold be az Értesítések engedélyezése opciót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan → App → Ayura → Pemberitahuan lalu nyalakan Izinkan Pemberitahuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni → App → Ayura → Notifiche e attiva Consenti notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」→「アプリ」→「Ayura」→「通知」を開き、「通知を許可」をオンにしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реттеулер → Қолданбалар → Ayura → Хабарландырулар бөлімін ашып, «Хабарландыруға рұқсат беру» параметрін қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಆ್ಯಪ್‌ಗಳು → Ayura → ಅಧಿಸೂಚನೆಗಳು ತೆರೆದು ‘ಅಧಿಸೂಚನೆಗಳನ್ನು ಅನುಮತಿಸಿ’ ಆನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 앱 → Ayura → 알림으로 이동하여 '알림 허용'을 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണം → ആപ്പുകൾ → Ayura → അറിയിപ്പുകൾ തുറന്ന് ‘അറിയിപ്പുകൾ അനുവദിക്കൂ’ ഓൺ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज → ॲप्स → Ayura → सूचना उघडा आणि ‘सूचनांना अनुमती द्या’ चालू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Seting → App → Ayura → Pemberitahuan dan hidupkan Benarkan Pemberitahuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Innstillinger → Apper → Ayura → Varslinger og slå på Tillat varslinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen → Apps → Ayura → Meldingen en schakel 'Sta meldingen toe' in."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଟିଂସ୍ → ଆପ୍ସ୍ → Ayura → ବିଜ୍ଞପ୍ତି ଖୋଲନ୍ତୁ ଏବଂ ‘ବିଜ୍ଞପ୍ତି ଅନୁମତି ଦିଅନ୍ତୁ’ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ → ਐਪਾਂ → Ayura → ਸੂਚਨਾਵਾਂ ਖੋਲ੍ਹੋ ਅਤੇ “ਸੂਚਨਾਵਾਂ ਦੀ ਆਗਿਆ ਦਿਓ” ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia → Aplikacje → Ayura → Powiadomienia i włącz opcję Zezwalaj na powiadomienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes → Apps → Ayura → Notificações e ative Permitir Notificações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Definições → Aplicações → Ayura → Notificações e ativa Permitir notificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Configurări → Aplicații → Ayura → Notificări și activează Permitere notificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки» → «Приложения» → Ayura → «Уведомления» и включите «Допуск уведомлений»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Nastavenia → Apky → Ayura → Hlásenia a zapnite možnosť Povoliť hlásenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite Nastavitve → Aplikacije → Ayura → Obvestila in vklopite Dovoli obvestila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Inställningar → Appar → Ayura → Notiser och aktivera Tillåt notiser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் → செயலிகள் → Ayura → அறிவிப்புகள் என்பதைத் திறந்து, அறிவிப்புகளை அனுமதி என்பதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్‌లు → యాప్‌లు → Ayura → నోటిఫికేషన్‌లు తెరిచి, “నోటిఫికేషన్‌లను అనుమతించండి” ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด การตั้งค่า → แอป → Ayura → การแจ้งเตือน แล้วเปิด อนุญาตการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Uygulamalar → Ayura → Bildirimler yolunu açın ve Bildirimlere İzin Ver seçeneğini etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте «Параметри» → «Програми» → Ayura → «Сповіщення» та увімкніть «Дозволити сповіщення»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز ← ایپس ← Ayura ← اطلاعات کھولیں اور “اطلاعات کی اجازت دیں” کو آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt → Ứng dụng → Ayura → Thông báo và bật Cho phép thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置” → “App” → “Ayura” → “通知”，然后开启“允许通知”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往「設定」→「App」→「Ayura」→「通知」，並開啟「允許通知」。"
          }
        }
      }
