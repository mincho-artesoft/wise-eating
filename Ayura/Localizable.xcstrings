    "Enter your thoughts, notes, or observations...": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أفكارك أو ملاحظاتك أو مشاهداتك..."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведи мислите, бележките или наблюденията си..."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভাবনা, নোট বা পর্যবেক্ষণ লিখুন..."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu els teus pensaments, notes o observacions..."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište své myšlenky, poznámky nebo postřehy..."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine tanker, noter eller observationer..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedanken, Notizen oder Beobachtungen eingeben…"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατάγραψε τις σκέψεις, τις σημειώσεις ή τις παρατηρήσεις σου..."
