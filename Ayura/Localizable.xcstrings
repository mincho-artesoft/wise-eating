        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά Lifetime δεν ακυρώνει τη συνδρομή σας. Διαχειριστείτε τη συνδρομή σας για να αποφύγετε μελλοντικές χρεώσεις ανανέωσης."
          }
