    "Your usual practice time is approaching. Open Ayura when you're ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترب موعد ممارستك المعتاد. افتح Ayura عندما تكون مستعدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обичайното ти време за практика наближава. Отвори Ayura, когато имаш готовност."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিয়মিত অভ্যাসের সময় এগিয়ে আসছে। প্রস্তুত হলে Ayura খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'acosta la teva hora habitual de pràctica. Obre Ayura quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blíží se váš obvyklý čas praxe. Až budete připraveni, otevřete aplikaci Ayura."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sædvanlige øvelsestid nærmer sig. Åbn Ayura, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine übliche Übungszeit rückt näher. Öffne Ayura, sobald du bereit bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλησιάζει η συνηθισμένη ώρα της πρακτικής σου. Άνοιξε το Ayura όταν είσαι έτοιμος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acerca tu hora habitual de práctica. Abre Ayura cuando quieras."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acerca tu hora habitual de práctica. Abre Ayura cuando estés listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavanomainen harjoitusaikasi lähestyy. Avaa Ayura, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton heure habituelle de pratique approche. Ouvre Ayura quand tu es prêt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre heure de pratique habituelle approche. Ouvrez Ayura quand vous êtes prêt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો નિયમિત અભ્યાસનો સમય નજીક આવી રહ્યો છે. તૈયાર હો ત્યારે Ayura ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעת התרגול הרגילה שלך מתקרבת. פתח את Ayura כשתהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नियमित अभ्यास का समय होने वाला है। तैयार होने पर Ayura खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliži se tvoje uobičajeno vrijeme za praksu. Otvori aplikaciju Ayura kad ti odgovara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közeledik a szokásos gyakorlásod ideje. Nyisd meg az Ayura appot, ha készen állsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu latihan rutin Anda hampir tiba. Buka Ayura saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo solito orario di pratica si avvicina. Apri Ayura quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの実践の時間が近づいています。準備ができたらAyuraを開いてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі тәжірибе уақытыңыз жақындап қалды. Дайын болғанда Ayura қолданбасын ашыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಾಮಾನ್ಯ ಅಭ್ಯಾಸದ ಸಮಯ ಹತ್ತಿರವಾಗುತ್ತಿದೆ. ನೀವು ಸಿದ್ಧರಾದಾಗ Ayura ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 수련 시간이 다가오고 있습니다. 준비되면 Ayura를 여세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പതിവ് പരിശീലന സമയം അടുത്തിരിക്കുന്നു. തയ്യാറാകുമ്പോൾ Ayura തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची नेहमीची सरावाची वेळ जवळ येत आहे. तुम्ही तयार असाल तेव्हा Ayura उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa latihan biasa anda semakin hampir. Buka Ayura apabila anda sudah bersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din vanlige øvelsestid nærmer seg. Åpne Ayura når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikelijke oefentijd nadert. Open Ayura wanneer je er klaar voor bent."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନିୟମିତ ଅଭ୍ୟାସ ସମୟ ପାଖେଇ ଆସୁଛି। ପ୍ରସ୍ତୁତ ହେଲେ Ayura ଖୋଲନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਆਮ ਅਭਿਆਸ ਦਾ ਸਮਾਂ ਨੇੜੇ ਆ ਰਿਹਾ ਹੈ। ਜਦੋਂ ਤੁਸੀਂ ਤਿਆਰ ਹੋਵੋ ਤਾਂ Ayura ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbliża się Twoja zwykła pora praktyki. Otwórz aplikację Ayura, gdy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu horário habitual de prática está chegando. Abra o Ayura quando estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua hora habitual de prática está a aproximar-se. Abre Ayura quando estiveres pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se apropie ora ta obișnuită de practică. Deschide Ayura când ești gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приближается ваше обычное время практики. Откройте Ayura, когда будете готовы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blíži sa váš obvyklý čas praxe. Keď budete pripravení, otvorte aplikáciu Ayura."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Približuje se vaš običajni čas za prakso. Odprite Ayuro, ko boste pripravljeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din vanliga övningstid närmar sig. Öppna Ayura när du är redo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வழக்கமான பயிற்சி நேரம் நெருங்குகிறது. தயாரானதும் Ayura-வைத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సాధారణ సాధన సమయం దగ్గరపడుతోంది. సిద్ధంగా ఉన్నప్పుడు Ayura తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใกล้ถึงเวลาฝึกตามปกติของคุณแล้ว เปิด Ayura เมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki pratik saatiniz yaklaşıyor. Hazır olduğunuzda Ayura'yı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наближається ваш звичний час практики. Відкрийте Ayura, коли будете готові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی مشق کا معمول کا وقت قریب آ رہا ہے۔ جب آپ تیار ہوں تو Ayura کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp đến giờ tập thường lệ của bạn. Mở Ayura khi bạn sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你平时的练习时间快到了。准备好后请打开 Ayura。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快到你平時的練習時間了，準備好就開啟 Ayura 吧。"
          }
        }
      }
    },
    "Calendar Access Required for Meals & Workouts": {
      "localizations": {
