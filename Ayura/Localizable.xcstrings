        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è in fase di download o preparazione. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロード中または準備中です。しばらくしてからもう一度お試しください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель жүктелуде немесе дайындалуда. Сәлден кейін қайталап көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಡೆಲ್ ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ ಅಥವಾ ಸಿದ್ಧಗೊಳ್ಳುತ್ತಿದೆ. ದಯವಿಟ್ಟು ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 다운로드하거나 준비 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഡൽ ഡൗൺലോഡ് ചെയ്യുകയോ തയ്യാറാക്കുകയോ ആണ്. അല്പസമയത്തിനകം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडेल डाउनलोड होत आहे किंवा तयार होत आहे. कृपया थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sedang dimuat turun atau disediakan. Sila cuba lagi sebentar nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen lastes ned eller klargjøres. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model wordt gedownload of voorbereid. Probeer het over een moment opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମଡେଲ୍ ଡାଉନଲୋଡ୍ କିମ୍ବା ପ୍ରସ୍ତୁତ ହେଉଛି। ଦୟାକରି କିଛି ସମୟ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਡਲ ਡਾਊਨਲੋਡ ਜਾਂ ਤਿਆਰ ਹੋ ਰਿਹਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model jest pobierany lub przygotowywany. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está sendo baixado ou preparado. Tente novamente em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está a ser descarregado ou preparado. Tenta novamente em breve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul se descarcă sau se pregătește. Încearcă din nou în curând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель загружается или подготавливается. Повторите попытку чуть позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sa sťahuje alebo pripravuje. Skúste to znova o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se prenaša ali pripravlja. Poskusite znova čez nekaj trenutkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen hämtas eller förbereds. Försök igen om en stund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதிரி பதிவிறக்கப்படுகிறது அல்லது தயார்படுத்தப்படுகிறது. சிறிது நேரத்தில் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడల్ డౌన్‌లోడ్ అవుతోంది లేదా సిద్ధమవుతోంది. దయచేసి కాసేపట్లో మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดาวน์โหลดหรือเตรียมโมเดล โปรดลองอีกครั้งในอีกสักครู่"
