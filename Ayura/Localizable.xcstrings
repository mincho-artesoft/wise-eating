            "state": "translated",
            "value": "Dit hår har generelt været?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie war dein Haar im Allgemeinen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μαλλιά σου είναι συνήθως;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por lo general, ¿cómo ha sido tu pelo?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo ha sido tu cabello por lo general?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Millaiset hiuksesi ovat yleensä olleet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cheveux ont généralement été ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En général, comment vos cheveux ont-ils été?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા વાળ સામાન્ય રીતે કેવા રહ્યા છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איך השיער שלך היה בדרך כלל?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बाल आम तौर पर कैसे रहे हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakva je općenito bila tvoja kosa?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen általában a hajad?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rambut Anda umumnya?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sono stati in genere i tuoi capelli?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段の髪質として、最も当てはまるのはどれですか？"
