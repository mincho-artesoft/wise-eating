    "Ready to create a personalized meal plan based on your profile?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت مستعد لإنشاء خطة وجبات مخصصة بناءً على ملفك الشخصي؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Искаш ли да създадеш персонализиран хранителен план според профила си?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইল অনুযায়ী ব্যক্তিগতকৃত খাবার পরিকল্পনা তৈরি করতে প্রস্তুত?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A punt per crear un pla d'àpats personalitzat segons el teu perfil?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete vytvořit jídelníček na míru podle vašeho profilu?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar til at oprette en personlig kostplan baseret på din profil?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit für einen personalisierten Ernährungsplan auf Basis deines Profils?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτοιμος να δημιουργήσεις ένα εξατομικευμένο πλάνο γευμάτων με βάση το προφίλ σου;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Todo listo para crear un plan de comidas personalizado según tu perfil?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Listo para crear un plan de comidas personalizado según tu perfil?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko valmis luomaan profiiliisi perustuvan yksilöllisen ateriasuunnitelman?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à créer un plan alimentaire personnalisé selon ton profil ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à créer un plan alimentaire personnalisé selon votre profil?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે તમારી પ્રોફાઇલના આધારે વ્યક્તિગત ભોજન યોજના બનાવવા માટે તૈયાર છો?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוכן ליצור תוכנית ארוחות מותאמת אישית על סמך הפרופיל שלך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप अपनी प्रोफ़ाइल के आधार पर व्यक्तिगत भोजन योजना बनाने के लिए तैयार हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li izraditi personalizirani plan prehrane na temelju svog profila?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készen állsz egy személyre szabott étkezési terv elkészítésére a profilod alapján?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap membuat rencana makan yang dipersonalisasi sesuai profil Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto pronto per creare un piano alimentare personalizzato in base al tuo profilo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールに基づいてパーソナライズされた食事プランを作成しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиліңізге негізделген жеке тамақтану жоспарын жасауға дайынсыз ба?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಆಧರಿಸಿ ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಊಟದ ಯೋಜನೆಯನ್ನು ರಚಿಸಲು ಸಿದ್ಧರಿದ್ದೀರಾ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 바탕으로 맞춤 식단 플랜을 만들 준비가 되셨나요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രൊഫൈലിനെ അടിസ്ഥാനമാക്കി വ്യക്തിഗതമാക്കിയ ഭക്ഷണ പ്ലാൻ സൃഷ്ടിക്കാൻ തയ്യാറാണോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या प्रोफाइलवर आधारित वैयक्तिकृत आहार योजना तयार करायची आहे का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersedia untuk mencipta pelan hidangan yang diperibadikan berdasarkan profil anda?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar til å lage en personlig måltidsplan basert på profilen din?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar om een persoonlijk maaltijdplan te maken op basis van je profiel?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ରୋଫାଇଲ୍ ଆଧାରରେ ଏକ ବ୍ୟକ୍ତିଗତ ଭୋଜନ ଯୋଜନା ତିଆରି କରିବାକୁ ପ୍ରସ୍ତୁତ କି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਆਪਣੇ ਪ੍ਰੋਫਾਈਲ ਦੇ ਆਧਾਰ 'ਤੇ ਵਿਅਕਤੀਗਤ ਭੋਜਨ ਯੋਜਨਾ ਬਣਾਉਣ ਲਈ ਤਿਆਰ ਹੋ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcesz utworzyć spersonalizowany plan posiłków na podstawie swojego profilu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para criar um plano alimentar personalizado com base no seu perfil?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pronto para criar um plano alimentar personalizado com base no teu perfil?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești gata să creezi un plan alimentar personalizat pe baza profilului tău?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовы создать персональный план питания на основе вашего профиля?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste pripravení vytvoriť prispôsobený stravovací plán podľa vášho profilu?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste pripravljeni ustvariti prilagojen načrt obrokov glede na vaš profil?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo att skapa en personlig måltidsplan baserad på din profil?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சுயவிவரத்தின் அடிப்படையில் தனிப்பயனாக்கப்பட்ட உணவுத் திட்டத்தை உருவாக்கத் தயாரா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రొఫైల్ ఆధారంగా వ్యక్తిగతీకరించిన భోజన ప్రణాళికను రూపొందించడానికి సిద్ధంగా ఉన్నారా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมสร้างแผนมื้ออาหารเฉพาะบุคคลตามโปรไฟล์ของคุณหรือยัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilinize göre kişiselleştirilmiş bir öğün planı oluşturmaya hazır mısınız?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готові створити персоналізований план харчування на основі вашого профілю?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ اپنی پروفائل کی بنیاد پر ذاتی نوعیت کا غذائی منصوبہ بنانے کے لیے تیار ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã sẵn sàng tạo kế hoạch bữa ăn cá nhân hóa dựa trên hồ sơ của mình chưa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好根据你的档案创建个性化膳食计划了吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好根據你的個人檔案建立專屬膳食計畫了嗎？"
          }
        }
      }
    },
