    "Your existing data has not been deleted. Please close and reopen the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحذف بياناتك الحالية. يُرجى إغلاق التطبيق وإعادة فتحه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съществуващите ти данни не са изтрити. Моля, затвори и отвори отново приложението."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিদ্যমান ডেটা মুছে ফেলা হয়নি। অনুগ্রহ করে অ্যাপটি বন্ধ করে পুনরায় খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves dades existents no s'han suprimit. Tanca l'app i torna-la a obrir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše stávající data nebyla smazána. Zavřete aplikaci a znovu ji otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine eksisterende data er ikke blevet slettet. Luk appen, og åbn den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine vorhandenen Daten wurden nicht gelöscht. Bitte schließe die App und öffne sie erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υπάρχοντα δεδομένα σου δεν έχουν διαγραφεί. Κλείσε και άνοιξε ξανά την εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han eliminado tus datos actuales. Cierra la app y vuelve a abrirla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se eliminaron tus datos existentes. Cierra y vuelve a abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olemassa olevia tietojasi ei ole poistettu. Sulje sovellus ja avaa se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données existantes n'ont pas été supprimées. Ferme l'application et rouvre-la."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données existantes n'ont pas été supprimées. Veuillez fermer l'application et la rouvrir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો હાલનો ડેટા કાઢી નાખવામાં આવ્યો નથી. કૃપા કરીને ઍપ બંધ કરીને ફરીથી ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים הקיימים שלך לא נמחקו. אנא סגור את האפליקציה ופתח אותה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका मौजूदा डेटा हटाया नहीं गया है। कृपया ऐप को बंद करके फिर से खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji postojeći podaci nisu izbrisani. Zatvori aplikaciju i ponovno je otvori."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meglévő adataid nem törlődtek. Zárd be, majd nyisd meg újra az alkalmazást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda yang ada tidak dihapus. Harap tutup dan buka kembali aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati esistenti non sono stati eliminati. Chiudi e riapri l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のデータは削除されていません。アプリを閉じて再度開いてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бар деректеріңіз жойылған жоқ. Қолданбаны жауып, қайта ашыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಈಗಿರುವ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿಲ್ಲ. ದಯವಿಟ್ಟು ಆ್ಯಪ್ ಅನ್ನು ಮುಚ್ಚಿ ಮತ್ತೆ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 데이터는 삭제되지 않았습니다. 앱을 종료한 후 다시 열어 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നിലവിലുള്ള ഡാറ്റ ഇല്ലാതാക്കിയിട്ടില്ല. ആപ്പ് അടച്ച് വീണ്ടും തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा विद्यमान डेटा हटवला गेलेला नाही. कृपया ॲप बंद करून पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data sedia ada anda belum dipadamkan. Sila tutup dan buka semula aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De eksisterende dataene dine er ikke slettet. Lukk appen og åpne den på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestaande gegevens zijn niet verwijderd. Sluit de app en open deze opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପୂର୍ବରୁ ଥିବା ଡାଟା ଡିଲିଟ୍ ହୋଇନାହିଁ। ଦୟାକରି ଆପ୍ ବନ୍ଦ କରି ପୁଣି ଖୋଲନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਮੌਜੂਦਾ ਡੇਟਾ ਮਿਟਾਇਆ ਨਹੀਂ ਗਿਆ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਐਪ ਨੂੰ ਬੰਦ ਕਰਕੇ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje istniejące dane nie zostały usunięte. Zamknij aplikację i otwórz ją ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados existentes não foram apagados. Feche e reabra o aplicativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados existentes não foram apagados. Fecha e volta a abrir a aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale existente nu au fost șterse. Închide și redeschide aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши существующие данные не удалены. Закройте приложение и откройте его снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše existujúce údaje neboli vymazané. Zavrite aplikáciu a znova ju otvorte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši obstoječi podatki niso bili izbrisani. Zaprite aplikacijo in jo znova odprite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina befintliga data har inte raderats. Stäng appen och öppna den igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தற்போதைய தரவு நீக்கப்படவில்லை. செயலியை மூடி மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రస్తుత డేటా తొలగించబడలేదు. దయచేసి యాప్‌ను మూసివేసి మళ్లీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลเดิมของคุณไม่ได้ถูกลบ โปรดปิดแอปแล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut verileriniz silinmedi. Lütfen uygulamayı kapatıp yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші наявні дані не видалено. Закрийте й знову відкрийте програму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا موجودہ ڈیٹا حذف نہیں ہوا ہے۔ براہ کرم ایپ بند کر کے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu hiện có của bạn chưa bị xóa. Vui lòng đóng và mở lại ứng dụng."
          }
