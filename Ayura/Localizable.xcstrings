        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕೂದಲು ಸಾಮಾನ್ಯವಾಗಿ ಹೇಗಿದೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 모발 상태는 전반적으로 어떠한가요?"
