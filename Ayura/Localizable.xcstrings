        "kk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Бұл өнім %lld рецепт, мәзір немесе тамақтану жоспарында қолданылады.\nОны жойсаңыз, ол сол жерлерден де өшіріледі.\n\nЖалғастырғыңыз келетініне сенімдісіз бе?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Бұл өнім %lld рецепт, мәзір немесе тамақтану жоспарында қолданылады.\nОны жойсаңыз, ол сол жерлерден де өшіріледі.\n\nЖалғастырғыңыз келетініне сенімдісіз бе?"
