    "Over the past week or two, your energy has been?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الأسبوع أو الأسبوعين الماضيين، كيف كانت طاقتك؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През последните една-две седмици енергията ти беше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত এক-দুই সপ্তাহে আপনার শক্তি কেমন ছিল?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant les últimes una o dues setmanes, com ha estat la teva energia?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaká byla za poslední týden nebo dva vaše energie?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste par uger har din energi været?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie war deine Energie in den letzten ein bis zwei Wochen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τις τελευταίες μία με δύο εβδομάδες, η ενέργειά σου ήταν;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo ha estado tu energía?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo ha estado tu energía?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Millainen energiasi on ollut viimeisen viikon tai kahden aikana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, ton énergie a été ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, comment a été votre énergie?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા એક-બે અઠવાડિયામાં તમારી ઊર્જા કેવી રહી છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשבוע או בשבועיים האחרונים, איך הייתה האנרגיה שלך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक-दो सप्ताह में आपकी ऊर्जा कैसी रही है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakva je bila tvoja energija u proteklih tjedan ili dva?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt egy-két hétben milyen volt az energiád?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama satu atau dua minggu terakhir, energi Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'ultima settimana o due, com'è stata la tua energia?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここ1〜2週間のエネルギーはどのような状態でしたか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы бір-екі аптада энергияңыз қандай болды?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಒಂದು ಅಥವಾ ಎರಡು ವಾರಗಳಿಂದ, ನಿಮ್ಮ ಶಕ್ತಿ ಹೇಗಿದೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 1~2주 동안 에너지는 어떠했나요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ ഒന്നോ രണ്ടോ ആഴ്ചയായി, നിങ്ങളുടെ ഊർജം എങ്ങനെയായിരുന്നു?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या एक-दोन आठवड्यांत तुमची ऊर्जा कशी राहिली आहे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang satu atau dua minggu lalu, tenaga anda?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De siste én til to ukene har energien din vært?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe was je energie de afgelopen week of twee?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତ ଏକ ବା ଦୁଇ ସପ୍ତାହରେ, ଆପଣଙ୍କ ଶକ୍ତି କିପରି ରହିଛି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਇੱਕ-ਦੋ ਹਫ਼ਤਿਆਂ ਵਿੱਚ, ਤੁਹਾਡੀ ਊਰਜਾ ਕਿਹੋ ਜਿਹੀ ਰਹੀ ਹੈ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaka była Twoja energia w ciągu ostatniego tygodnia lub dwóch?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, sua energia tem sido?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, como tem estado a tua energia?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultimele una-două săptămâni, cum a fost energia ta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой была ваша энергия в последние неделю-две?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aká bola vaša energia za posledný týždeň alebo dva?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakšna je bila vaša energija v zadnjem tednu ali dveh?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur har din energi varit under de senaste en till två veckorna?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த ஒரு வாரம் அல்லது இரண்டு வாரங்களில், உங்கள் ஆற்றல் எப்படி இருந்தது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత ఒకటి రెండు వారాలుగా, మీ శక్తి ఎలా ఉంది?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในช่วงสัปดาห์หรือสองสัปดาห์ที่ผ่านมา พลังงานของคุณเป็นอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir iki haftada enerjiniz nasıldı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Протягом останніх тижня-двох ваша енергія була?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گزشتہ ایک دو ہفتوں میں آپ کی توانائی کیسی رہی ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong một hoặc hai tuần qua, năng lượng của bạn thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一两周里，你的精力如何？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一兩週，你的精力如何？"
          }
        }
      }
    },
