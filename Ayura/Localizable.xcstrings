        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл партияны (%@ %@, мерзімі: %@) жойғыңыз келетініне сенімдісіз бе? Бұл әрекетті қайтару мүмкін емес."
          }
