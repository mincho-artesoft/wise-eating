    "Add an optional traditional profile to personalize Ayurvedic food ranking and explanations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملفًا تقليديًا اختياريًا لتخصيص ترتيب الأطعمة والشروحات الأيورفيدية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави незадължителен традиционен профил, за да персонализираш аюрведичната подредба на храните и обясненията."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খাবারের আয়ুর্বেদিক ক্রম ও ব্যাখ্যা ব্যক্তিগতকৃত করতে একটি ঐচ্ছিক প্রথাগত প্রোফাইল যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un perfil tradicional opcional per personalitzar l'ordenació ayurvèdica dels aliments i les explicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte volitelný tradiční profil pro přizpůsobení ájurvédského řazení potravin a vysvětlení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en valgfri traditionel profil for at tilpasse den ayurvediske rangering af fødevarer og forklaringerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge optional ein traditionelles Profil hinzu, um die ayurvedische Reihenfolge der Lebensmittel und die Erklärungen zu personalisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε ένα προαιρετικό παραδοσιακό προφίλ για να εξατομικεύσεις την αγιουρβεδική κατάταξη τροφών και τις εξηγήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un perfil tradicional opcional para personalizar el orden y las explicaciones ayurvédicas de los alimentos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un perfil tradicional opcional para personalizar el orden y las explicaciones ayurvédicas de los alimentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää valinnainen perinteinen profiili mukauttaaksesi ruokien ayurvedista järjestystä ja selityksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un profil traditionnel facultatif pour personnaliser le classement et les explications ayurvédiques des aliments."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un profil traditionnel facultatif pour personnaliser le classement ayurvédique des aliments et les explications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયુર્વેદિક ખોરાકના ક્રમાંક અને સમજૂતીઓને વ્યક્તિગત બનાવવા માટે વૈકલ્પિક પરંપરાગત પ્રોફાઇલ ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף פרופיל מסורתי אופציונלי כדי להתאים אישית את דירוג המזונות וההסברים האיורוודיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयुर्वेदिक खाद्य रैंकिंग और व्याख्याओं को व्यक्तिगत बनाने के लिए एक वैकल्पिक पारंपरिक प्रोफ़ाइल जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj neobavezni tradicionalni profil za personalizaciju ayurvedskog rangiranja namirnica i objašnjenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy opcionális hagyományos profilt az ájurvédikus ételrangsorolás és magyarázatok személyre szabásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan profil tradisional opsional untuk mempersonalisasi peringkat makanan Ayurveda dan penjelasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un profilo tradizionale opzionale per personalizzare l'ordinamento ayurvedico degli alimenti e le spiegazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で伝統的プロフィールを追加すると、アーユルヴェーダに基づく食品の並び順と解説をパーソナライズできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнімдердің аюрведалық реттілігі мен түсіндірмелерін жекелендіру үшін қалауыңызша дәстүрлі профиль қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯುರ್ವೇದ ಆಹಾರ ಶ್ರೇಣೀಕರಣ ಮತ್ತು ವಿವರಣೆಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಐಚ್ಛಿಕ ಸಾಂಪ್ರದಾಯಿಕ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전통 프로필(선택 사항)을 추가하여 아유르베다 식품 순위와 설명을 맞춤 설정하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആയുർവേദ ഭക്ഷണ റാങ്കിംഗും വിശദീകരണങ്ങളും വ്യക്തിഗതമാക്കാൻ വേണമെങ്കിൽ ഒരു പരമ്പരാഗത പ്രൊഫൈൽ ചേർക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्नपदार्थांचा आयुर्वेदिक क्रम आणि स्पष्टीकरणे वैयक्तिकृत करण्यासाठी ऐच्छिक पारंपरिक प्रोफाइल जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah profil tradisional (pilihan) untuk memperibadikan kedudukan makanan dan penjelasan Ayurveda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en valgfri tradisjonell profil for å tilpasse ayurvedisk matvarerangering og forklaringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een optioneel traditioneel profiel toe om de ayurvedische voedingsrangschikking en uitleg te personaliseren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆୟୁର୍ବେଦୀୟ ଖାଦ୍ୟ କ୍ରମ ଏବଂ ବ୍ୟାଖ୍ୟାଗୁଡ଼ିକୁ ବ୍ୟକ୍ତିଗତ କରିବାକୁ ଏକ ଇଚ୍ଛାଧୀନ ପାରମ୍ପରିକ ପ୍ରୋଫାଇଲ୍ ଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਯੁਰਵੈਦਿਕ ਭੋਜਨ ਦਰਜਾਬੰਦੀ ਅਤੇ ਵਿਆਖਿਆਵਾਂ ਨੂੰ ਵਿਅਕਤੀਗਤ ਬਣਾਉਣ ਲਈ ਇੱਕ ਵਿਕਲਪਿਕ ਪਰੰਪਰਾਗਤ ਪ੍ਰੋਫਾਈਲ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj opcjonalny profil tradycyjny, aby spersonalizować ajurwedyjską kolejność produktów i wyjaśnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um perfil tradicional opcional para personalizar a classificação e as explicações ayurvédicas dos alimentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um perfil tradicional opcional para personalizar a ordenação e as explicações ayurvédicas dos alimentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un profil tradițional opțional pentru a personaliza ordonarea ayurvedică a alimentelor și explicațiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При желании добавьте традиционный профиль, чтобы персонализировать ранжирование продуктов и пояснения по Аюрведе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte voliteľný tradičný profil na prispôsobenie ajurvédskeho poradia potravín a vysvetlení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po želji dodajte tradicionalni profil, da prilagodite ajurvedsko razvrščanje živil in pojasnila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en valfri traditionell profil för att anpassa ayurvedisk livsmedelsrangordning och förklaringar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆயுர்வேத உணவு வரிசைப்படுத்தலையும் விளக்கங்களையும் தனிப்பயனாக்க, விருப்பப்பட்டால் ஒரு மரபுச் சுயவிவரத்தைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆయుర్వేద ఆహార ర్యాంకింగ్ మరియు వివరణలను వ్యక్తిగతీకరించడానికి ఐచ్ఛిక సంప్రదాయ ప్రొఫైల్‌ను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโปรไฟล์แบบดั้งเดิม (ไม่บังคับ) เพื่อปรับการจัดอันดับอาหารและคำอธิบายทางอายุรเวทให้เหมาะกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayurvedik besin sıralamasını ve açıklamalarını kişiselleştirmek için isteğe bağlı geleneksel bir profil ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте необов’язковий традиційний профіль, щоб персоналізувати аюрведичне ранжування продуктів і пояснення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غذاؤں کی آیورویدک ترتیب اور وضاحتوں کو ذاتی نوعیت کا بنانے کے لیے ایک اختیاری روایتی پروفائل شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một hồ sơ truyền thống tùy chọn để cá nhân hóa việc xếp hạng thực phẩm và phần giải thích theo Ayurveda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加可选的传统档案，获取个性化的阿育吠陀食物排序与说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增選填的傳統體質檔案，以個人化阿育吠陀食物排序與說明。"
          }
        }
      }
    },
    "I already know my constitution": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعرف بنيتي مسبقًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече знам конституцията си"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি ইতিমধ্যে আমার প্রকৃতি জানি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja conec la meva constitució"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už znám svou konstituci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kender allerede min konstitution"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kenne meine Konstitution bereits"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γνωρίζω ήδη την ιδιοσυστασία μου"
          }
        },
        "es": {
