        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es in den Einstellungen, um AI zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποίησέ το στις Ρυθμίσεις για να χρησιμοποιήσεις το AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivada. Actívala en Ajustes para usar la IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Configuración para usar la AI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on pois päältä. Ota se käyttöön Asetuksissa käyttääksesi AI:ta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages pour utiliser AI."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivée. Activez-la dans Réglages pour utiliser l'AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence બંધ છે. AI નો ઉપયોગ કરવા માટે તેને સેટિંગ્સમાં ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence כבוי. הפעל אותו בהגדרות כדי להשתמש ב-AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है। AI का उपयोग करने के लिए इसे सेटिंग्ज़ में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je isključen. Uključi ga u Postavkama za korištenje AI-ja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence ki van kapcsolva. Kapcsold be a Beállításokban az AI használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Aktifkan di Pengaturan untuk menggunakan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivata. Attivala in Impostazioni per usare l'AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。AIを使用するには「設定」で有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence өшірулі. AI пайдалану үшін оны Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಆಫ್ ಆಗಿದೆ. AI ಬಳಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. AI를 사용하려면 설정에서 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ഓഫ് ആണ്. AI ഉപയോഗിക്കാൻ ക്രമീകരണങ്ങളിൽ ഇത് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद आहे. AI वापरण्यासाठी ते सेटिंग्जमध्ये सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Dayakannya dalam Seting untuk menggunakan AI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slått av. Slå den på i Innstillinger for å bruke AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is uitgeschakeld. Schakel het in bij Instellingen om AI te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ବନ୍ଦ ଅଛି। AI ବ୍ୟବହାର କରିବାକୁ ସେଟିଂସ୍‌ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਬੰਦ ਹੈ। AI ਵਰਤਣ ਲਈ ਇਸ ਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Apple Intelligence jest wyłączona. Włącz ją w Ustawieniach, aby korzystać z AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes para usar a AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ativa-a nas Definições para usar a AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence este dezactivat. Activează-l în Configurări pentru a folosi AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence отключён. Включите его в Настройках, чтобы использовать AI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Ak chcete používať AI, zapnite ju v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je izklopljen. Omogočite ga v Nastavitvah za uporabo AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är avstängt. Aktivera det i Inställningar för att använda AI."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence முடக்கப்பட்டுள்ளது. AI-ஐப் பயன்படுத்த அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఆఫ్‌లో ఉంది. AIని ఉపయోగించడానికి సెట్టింగ్‌లలో దీన్ని ప్రారంభించండి."
          }
