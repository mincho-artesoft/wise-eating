          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre ájurvédikus profilt %@ számára a személyes illeszkedés megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat profil Ayurveda untuk %@ guna melihat kecocokan pribadi."
