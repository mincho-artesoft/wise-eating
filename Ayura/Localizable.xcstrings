        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayurveda & Asana Yoga gebruikt je agenda om je maaltijden, boodschappenlijsten en workouts op te slaan. Geef toestemming in Instellingen om deze functies te gebruiken."
