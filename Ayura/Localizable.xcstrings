        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambah senaman untuk %@. Bagaimanakah senaman bagi slot masa tertentu harus dikendalikan?"
          }
        },
        "nb": {
          "stringUnit": {
