    "You'll be notified when your plan is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك إشعار عندما تكون خطتك جاهزة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще получиш известие, когато планът ти е готов."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিকল্পনা তৈরি হলে আপনাকে জানানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebràs una notificació quan el teu pla estigui a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až bude váš plán připraven, obdržíte oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får besked, når din plan er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst benachrichtigt, sobald dein Plan fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ειδοποιηθείς όταν το πλάνο σου είναι έτοιμο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás una notificación cuando tu plan esté listo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Te notificaremos cuando tu plan esté listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun suunnitelmasi on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recevras une notification quand ton programme sera prêt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une notification lorsque votre plan sera prêt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી યોજના તૈયાર થશે ત્યારે તમને સૂચિત કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקבל התראה כשהתוכנית שלך תהיה מוכנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी योजना तैयार होने पर आपको सूचित किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobit ćeš obavijest kad plan bude spreman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítünk, amint elkészült a terved."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan diberi tahu saat rencana Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai una notifica quando il tuo piano sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランの準備ができたら通知されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспарыңыз дайын болғанда хабарлама аласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಯೋಜನೆ ಸಿದ್ಧವಾದಾಗ ನಿಮಗೆ ತಿಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜이 준비되면 알려드립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്ലാൻ തയ്യാറാകുമ്പോൾ നിങ്ങളെ അറിയിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची योजना तयार झाल्यावर तुम्हाला कळवले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan dimaklumkan apabila pelan anda siap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får varsel når planen er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt een melding wanneer je plan klaar is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଯୋଜନା ପ୍ରସ୍ତୁତ ହେଲେ ଆପଣଙ୍କୁ ସୂଚିତ କରାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਯੋਜਨਾ ਤਿਆਰ ਹੋਣ 'ਤੇ ਤੁਹਾਨੂੰ ਸੂਚਿਤ ਕੀਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz powiadomienie, gdy plan będzie gotowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será notificado quando seu plano estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás uma notificação quando o teu plano estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei primi o notificare când planul este gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, когда ваш план будет готов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď bude váš plán pripravený, dostanete upozornenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obveščeni boste, ko bo vaš načrt pripravljen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får en notis när din plan är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் திட்டம் தயாரானதும் உங்களுக்குத் தெரிவிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రణాళిక సిద్ధమైనప్పుడు మీకు తెలియజేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับการแจ้งเตือนเมื่อแผนของคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planınız hazır olduğunda bildirim alacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримаєте сповіщення, коли ваш план буде готовий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کا منصوبہ تیار ہو جائے گا تو آپ کو مطلع کیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được thông báo khi kế hoạch đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划准备就绪后将通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的計畫準備好時會收到通知。"
          }
        }
      }
    },
