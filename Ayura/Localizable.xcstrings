        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je dit maaltijdplan wilt verwijderen?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ ଭାବରେ ଏହି ଭୋଜନ ଯୋଜନାଟିକୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ ਇਸ ਭੋਜਨ ਯੋਜਨਾ ਨੂੰ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "pl": {
          "stringUnit": {
