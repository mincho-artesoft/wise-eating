        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "یہ مشق %lld ورزش یا تربیتی منصوبے میں استعمال ہو رہی ہے۔\nاگر آپ اسے حذف کرتے ہیں، تو یہ اس ورزش یا منصوبے سے ہٹا دی جائے گی۔\n\nکیا آپ واقعی جاری رکھنا چاہتے ہیں؟"
                }
              },
              "other": {
                "stringUnit": {
