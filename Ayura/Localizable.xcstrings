    "Irregular — big some days, absent on others": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير منتظمة — قوية أحيانًا وغائبة أحيانًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нередовен — в едни дни силен, в други липсва"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনিয়মিত — কোনো দিন বেশি, কোনো দিন একদমই নয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular: molta uns dies i nul·la uns altres"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravidelná — někdy velká, jindy žádná"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uregelmæssig — stor nogle dage, væk andre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unregelmäßig — an manchen Tagen groß, an anderen kaum da"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άστατη — μεγάλη κάποιες μέρες, ανύπαρκτη άλλες"
