    "⚠️ This recipe contains allergens the user is sensitive to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ تحتوي هذه الوصفة على مسببات حساسية يتحسس منها المستخدم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Тази рецепта съдържа алергени, към които потребителят е чувствителен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ এই রেসিপিতে এমন অ্যালার্জেন রয়েছে যার প্রতি ব্যবহারকারীর সংবেদনশীলতা আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aquesta recepta conté al·lèrgens als quals l'usuari és sensible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Tento recept obsahuje alergeny, na které je uživatel citlivý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Denne opskrift indeholder allergener, som brugeren er følsom over for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Dieses Rezept enthält Allergene, auf die der Nutzer empfindlich reagiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Αυτή η συνταγή περιέχει αλλεργιογόνα στα οποία ο χρήστης έχει ευαισθησία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receta contiene alérgenos a los que el usuario es sensible."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receta contiene alérgenos a los que el usuario es sensible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Tämä resepti sisältää allergeeneja, joille käyttäjä on herkkä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cette recette contient des allergènes auxquels l'utilisateur est sensible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cette recette contient des allergènes auxquels l'utilisateur est sensible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ આ રેસીપીમાં એવા એલર્જન્સ છે જેના પ્રત્યે વપરાશકર્તા સંવેદનશીલ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ מתכון זה מכיל אלרגנים שהמשתמש רגיש אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ इस व्यंजन में ऐसे एलर्जेन हैं जिनके प्रति उपयोगकर्ता संवेदनशील है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Ovaj recept sadrži alergene na koje je korisnik osjetljiv."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Ez a recept olyan allergéneket tartalmaz, amelyekre a felhasználó érzékeny."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Resep ini mengandung alergen yang memicu sensitivitas pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Questa ricetta contiene allergeni a cui l'utente è sensibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ このレシピには、ユーザーが過敏反応を示すアレルゲンが含まれています。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Бұл рецептте пайдаланушы сезімтал аллергендер бар."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ ಈ ಪಾಕವಿಧಾನವು ಬಳಕೆದಾರರು ಸೂಕ್ಷ್ಮತೆ ಹೊಂದಿರುವ ಅಲರ್ಜಿಕಾರಕಗಳನ್ನು ಹೊಂದಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 이 레시피에는 사용자가 민감한 알레르기 유발 성분이 포함되어 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ ഉപയോക്താവിന് അലർജിയുണ്ടാക്കുന്ന ഘടകങ്ങൾ ഈ പാചകക്കുറിപ്പിൽ അടങ്ങിയിട്ടുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ या पाककृतीमध्ये असे ॲलर्जीकारक घटक आहेत ज्यांप्रती वापरकर्ता संवेदनशील आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Resipi ini mengandungi alergen yang pengguna sensitif terhadapnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Denne oppskriften inneholder allergener som brukeren er sensitiv for."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Dit recept bevat allergenen waarvoor de gebruiker gevoelig is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ ଏହି ରେସିପିରେ ଏପରି ଆଲର୍ଜେନ୍ ଅଛି ଯାହା ପ୍ରତି ବ୍ୟବହାରକାରୀ ସମ୍ବେଦନଶୀଳ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ ਇਸ ਰੈਸਿਪੀ ਵਿੱਚ ਅਜਿਹੇ ਐਲਰਜਨ ਹਨ ਜਿਨ੍ਹਾਂ ਪ੍ਰਤੀ ਵਰਤੋਂਕਾਰ ਸੰਵੇਦਨਸ਼ੀਲ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Ten przepis zawiera alergeny, na które użytkownik jest wrażliwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receita contém alérgenos aos quais o usuário tem sensibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receita contém alergénios aos quais o utilizador é sensível."
