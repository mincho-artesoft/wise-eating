    "Price: %@. The subscription renews automatically unless cancelled at least 24 hours before the end of the current period.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السعر: %@. يتجدد الاشتراك تلقائيًا ما لم يتم إلغاؤه قبل 24 ساعة على الأقل من نهاية الفترة الحالية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена: %@. Абонаментът се подновява автоматично, освен ако не бъде отменен поне 24 часа преди края на текущия период."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য: %@। বর্তমান মেয়াদ শেষ হওয়ার অন্তত 24 ঘণ্টা আগে বাতিল না করলে সাবস্ক্রিপশন স্বয়ংক্রিয়ভাবে নবায়ন হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Preu: %@. La subscripció es renova automàticament tret que es cancel·li com a mínim 24 hores abans del final del període actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena: %@. Předplatné se automaticky obnovuje, pokud není zrušeno alespoň 24 hodin před koncem aktuálního období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris: %@. Abonnementet fornyes automatisk, medmindre det opsiges mindst 24 timer før udløbet af den aktuelle periode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preis: %@. Das Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τιμή: %@. Η συνδρομή ανανεώνεται αυτόματα, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν από τη λήξη της τρέχουσας περιόδου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precio: %@. La suscripción se renueva automáticamente salvo que se cancele al menos 24 horas antes del final del periodo actual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Precio: %@. La suscripción se renueva automáticamente a menos que se cancele al menos 24 horas antes del final del periodo actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinta: %@. Tilaus uusiutuu automaattisesti, ellei sitä peruta vähintään 24 tuntia ennen nykyisen jakson päättymistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix : %@. L'abonnement est renouvelé automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix : %@. L'abonnement est renouvelé automatiquement, sauf s'il est annulé au moins 24 heures avant la fin de la période en cours."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કિંમત: %@. વર્તમાન સમયગાળો સમાપ્ત થવાના ઓછામાં ઓછા 24 કલાક પહેલાં રદ કરવામાં ન આવે તો સબ્સ્ક્રિપ્શન આપમેળે રિન્યૂ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיר: %@. המנוי מתחדש אוטומטית אלא אם בוטל לפחות 24 שעות לפני תום התקופה הנוכחית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमत: %@। वर्तमान अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न किए जाने पर सदस्यता स्वतः नवीनीकृत हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijena: %@. Pretplata se automatski obnavlja ako se ne otkaže najmanje 24 sata prije kraja trenutačnog razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ár: %@. Az előfizetés automatikusan megújul, hacsak nem mondod le legalább 24 órával az aktuális időszak vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga: %@. Langganan diperpanjang secara otomatis kecuali dibatalkan setidaknya 24 jam sebelum akhir periode berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezzo: %@. L'abbonamento si rinnova automaticamente salvo annullamento almeno 24 ore prima della fine del periodo in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格: %@。現在の期間が終了する少なくとも24時間前までにキャンセルしない限り、サブスクリプションは自動的に更新されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағасы: %@. Ағымдағы кезең аяқталуына кемінде 24 сағат қалғанда бас тартпасаңыз, жазылым автоматты түрде жаңартылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೆಲೆ: %@. ಪ್ರಸ್ತುತ ಅವಧಿ ಮುಗಿಯುವ ಕನಿಷ್ಠ 24 ಗಂಟೆಗಳ ಮೊದಲು ರದ್ದುಗೊಳಿಸದಿದ್ದರೆ ಚಂದಾದಾರಿಕೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격: %@. 현재 기간이 종료되기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വില: %@. നിലവിലെ കാലയളവ് അവസാനിക്കുന്നതിന് കുറഞ്ഞത് 24 മണിക്കൂർ മുമ്പെങ്കിലും റദ്ദാക്കിയില്ലെങ്കിൽ സബ്സ്ക്രിപ്ഷൻ സ്വയമേവ പുതുക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किंमत: %@. सध्याचा कालावधी संपण्याच्या किमान 24 तास आधी रद्द न केल्यास सदस्यतेचे आपोआप नूतनीकरण होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga: %@. Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris: %@. Abonnementet fornyes automatisk med mindre det sies opp minst 24 timer før utløpet av gjeldende periode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijs: %@. Het abonnement wordt automatisch verlengd, tenzij het ten minste 24 uur voor het einde van de huidige periode wordt geannuleerd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୂଲ୍ୟ: %@। ବର୍ତ୍ତମାନର ଅବଧି ଶେଷ ହେବାର ଅତିକମରେ 24 ଘଣ୍ଟା ପୂର୍ବରୁ ବାତିଲ୍ ନ କରାଗଲେ ସବ୍‌ସ୍କ୍ରିପ୍‌ସନ୍ ସ୍ୱୟଂଚାଳିତ ଭାବେ ନବୀକରଣ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀਮਤ: %@। ਮੌਜੂਦਾ ਮਿਆਦ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ ਰੱਦ ਨਾ ਕੀਤੇ ਜਾਣ 'ਤੇ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਆਪਣੇ ਆਪ ਰੀਨਿਊ ਹੋ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena: %@. Subskrypcja odnawia się automatycznie, chyba że zostanie anulowana co najmniej 24 godziny przed końcem bieżącego okresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preço: %@. A assinatura é renovada automaticamente, a menos que seja cancelada pelo menos 24 horas antes do término do período atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preço: %@. A subscrição é renovada automaticamente, salvo cancelamento pelo menos 24 horas antes do fim do período atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Preț: %@. Abonamentul se reînnoiește automat, cu excepția cazului în care este anulat cu cel puțin 24 de ore înainte de sfârșitul perioadei curente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена: %@. Подписка продлевается автоматически, если не отменить её как минимум за 24 часа до окончания текущего периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena: %@. Predplatné sa automaticky obnovuje, ak ho nezrušíte najmenej 24 hodín pred koncom aktuálneho obdobia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena: %@. Naročnina se samodejno podaljša, razen če jo prekličete najmanj 24 ur pred koncem trenutnega obdobja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris: %@. Prenumerationen förnyas automatiskt om den inte sägs upp minst 24 timmar före slutet av den aktuella perioden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விலை: %@. தற்போதைய காலகட்டம் முடிவதற்குக் குறைந்தது 24 மணி நேரத்திற்கு முன்பு ரத்து செய்யப்படாவிட்டால், சந்தா தானாகவே புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధర: %@. ప్రస్తుత వ్యవధి ముగియడానికి కనీసం 24 గంటల ముందు రద్దు చేయకపోతే సబ్‌స్క్రిప్షన్ స్వయంచాలకంగా పునరుద్ధరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคา: %@ การสมัครรับจะต่ออายุโดยอัตโนมัติ เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat: %@. Abonelik, mevcut dönemin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна: %@. Підписка поновлюється автоматично, якщо її не скасовано щонайменше за 24 години до завершення поточного періоду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت: %@۔ سبسکرپشن کی تجدید خودکار طور پر ہو جاتی ہے، جب تک کہ اسے موجودہ مدت کے اختتام سے کم از کم 24 گھنٹے پہلے منسوخ نہ کیا جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá: %@. Gói đăng ký sẽ tự động gia hạn trừ khi được hủy ít nhất 24 giờ trước khi kết thúc chu kỳ hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格：%@。除非在当前订阅期结束前至少 24 小时取消，否则订阅将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格：%@。除非在目前訂閱期結束前至少 24 小時取消，否則訂閱將會自動續訂。"
          }
        }
      }
    },
