          "stringUnit": {
            "state": "translated",
            "value": "Még nem kapcsoltad ezt a gyakorlatot egyetlen jegyzethez sem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menautkan gerakan ini ke catatan mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora collegato questo esercizio ad alcuna nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエクササイズにはまだメモがリンクされていません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жаттығуды әлі ешбір жазбамен байланыстырмағансыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ಈ ವ್ಯಾಯಾಮವನ್ನು ಯಾವುದೇ ಟಿಪ್ಪಣಿಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이 운동을 메모에 연결하지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ ഈ വ്യായാമം ഒരു കുറിപ്പിലേക്കും ലിങ്ക് ചെയ്തിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही हा व्यायाम अद्याप कोणत्याही नोंदीशी जोडलेला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum memautkan latihan ini kepada sebarang nota lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke knyttet denne øvelsen til noen notater ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze oefening nog niet aan notities gekoppeld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏପର୍ଯ୍ୟନ୍ତ ଏହି ବ୍ୟାୟାମକୁ କୌଣସି ନୋଟ୍ ସହିତ ସଂଯୁକ୍ତ କରିନାହାନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅਜੇ ਤੱਕ ਇਸ ਕਸਰਤ ਨੂੰ ਕਿਸੇ ਵੀ ਨੋਟ ਨਾਲ ਨਹੀਂ ਜੋੜਿਆ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ćwiczenie nie ma jeszcze powiązanych notatek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não vinculou este exercício a nenhuma nota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não associaste este exercício a nenhuma nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai asociat încă acest exercițiu cu nicio notă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ещё не связали это упражнение ни с одной заметкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto cvičenie ste zatiaľ neprepojili so žiadnymi poznámkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vaje še niste povezali z nobenim zapiskom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte kopplat den här övningen till några anteckningar ännu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உடற்பயிற்சியை நீங்கள் இன்னும் எந்தக் குறிப்புகளுடனும் இணைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా ఈ వ్యాయామాన్ని ఏ గమనికలకూ లింక్ చేయలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้เชื่อมโยงท่าออกกำลังกายนี้กับโน้ตใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu egzersizi henüz hiçbir nota bağlamadınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не пов’язали цю вправу з жодною нотаткою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی تک اس مشق کو کسی نوٹ سے منسلک نہیں کیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa liên kết bài tập này với ghi chú nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未将此运动关联到任何笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未將此運動連結至任何筆記。"
          }
        }
      }
    },
