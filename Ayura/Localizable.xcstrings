        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunato iz sastojaka povezanih s USDA bazom. Nedostupni USDA podaci o nutrijentima prikazani su kao —."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "USDA-adatbázishoz kapcsolt összetevők alapján számítva. A nem elérhető USDA tápanyagadatok — jellel láthatók."
