        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のワークアウトを追加します。特定の時間帯のワークアウトをどのように処理しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %@ күніне жаттығуларды қосады. Белгілі бір уақыт аралығындағы жаттығулар қалай өңделсін?"
