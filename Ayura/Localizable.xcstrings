          "stringUnit": {
            "state": "translated",
            "value": "Мәзіріңіз дайын болғанда хабарландыру аласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೆನು ಸಿದ್ಧವಾದಾಗ ನಿಮಗೆ ಸೂಚಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴가 준비되면 알림을 보내드립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മെനു തയ്യാറാകുമ്പോൾ നിങ്ങളെ അറിയിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा मेनू तयार झाल्यावर तुम्हाला सूचित केले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan dimaklumkan apabila menu anda sedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får varsel når menyen er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ontvangt een melding zodra je menu klaar is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମେନୁ ପ୍ରସ୍ତୁତ ହେଲେ ଆପଣଙ୍କୁ ସୂଚନା ଦିଆଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਮੀਨੂ ਤਿਆਰ ਹੋਣ 'ਤੇ ਤੁਹਾਨੂੰ ਸੂਚਿਤ ਕੀਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz powiadomienie, gdy Twoje menu będzie gotowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você receberá uma notificação quando seu menu estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás uma notificação quando a tua ementa estiver pronta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei primi o notificare când meniul tău este gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, когда ваше меню будет готово."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď bude vaše menu hotové, dostanete upozornenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko bo vaš jedilnik pripravljen, boste prejeli obvestilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får en notis när din meny är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மெனு தயாரானதும் உங்களுக்கு அறிவிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మెనూ సిద్ధమైనప్పుడు మీకు తెలియజేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับการแจ้งเตือนเมื่อเมนูของคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menünüz hazır olduğunda bildirim alacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримаєте сповіщення, коли ваше меню буде готове."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کا مینو تیار ہو جائے گا تو آپ کو مطلع کیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được thông báo khi thực đơn sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单准备好后我们会通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "菜單準備好時會通知你。"
          }
        }
      }
    },
