    "AI is creating your exercises. You'll be notified.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم AI بإنشاء تمارينك. سيصلك إشعار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "AI създава упражненията ти. Ще получиш известие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI আপনার ব্যায়াম তৈরি করছে। তৈরি হলে আপনাকে জানানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'AI està creant els teus exercicis. Rebràs una notificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI vytváří vaše cvičení. Obdržíte oznámení."
          }
