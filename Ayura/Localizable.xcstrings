          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી બધી નોંધો જોવા માટે તારીખ શ્રેણી બદલી જુઓ અથવા ફિલ્ટર સાફ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה לשנות את טווח התאריכים או לנקות את המסנן כדי לראות את כל ההערות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी नोट्स देखने के लिए दिनांक सीमा समायोजित करें या फ़िल्टर हटाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušaj prilagoditi raspon datuma ili očistiti filtar kako bi se prikazale sve tvoje bilješke."
          }
        },
        "hu": {
          "stringUnit": {
