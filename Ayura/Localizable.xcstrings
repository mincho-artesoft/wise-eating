        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst hälften av övningstiden behöver Ayurveda-data."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது பாதி உடற்பயிற்சி நேரத்திற்காவது ஆயுர்வேதத் தரவு தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనీసం సగం వ్యాయామ వ్యవధికి ఆయుర్వేద డేటా అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาการออกกำลังกายอย่างน้อยครึ่งหนึ่งต้องมีข้อมูลอายุรเวท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz süresinin en az yarısının Ayurveda verisine sahip olması gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше половина тривалості вправ має містити дані Аюрведи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشق کے کم از کم آدھے دورانیے کا آیوروید ڈیٹا ہونا ضروری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần ít nhất một nửa thời lượng bài tập có dữ liệu Ayurveda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少一半的运动时长需要包含阿育吠陀数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一半的運動時間具備阿育吠陀資料。"
          }
        }
      }
    },
