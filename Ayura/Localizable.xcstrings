        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ದಾಸ್ತಾನಿನಿಂದ '%@' ಅನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
