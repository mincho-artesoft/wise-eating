    "Search 14,000 foods and see how each one affects vata, pitta and kapha.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في 14,000 طعام واعرف كيف يؤثر كل منها في فاتا وبيتا وكافا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търси сред 14 000 храни и виж как всяка от тях влияе на вата, пита и кафа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000টি খাবারের মধ্যে খুঁজুন এবং দেখুন প্রতিটি কীভাবে বাত, পিত্ত ও কফের ওপর প্রভাব ফেলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca entre 14.000 aliments i mira com cadascun afecta vata, pitta i kapha."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohledejte 14 000 potravin a podívejte se, jak každá působí na vatu, pittu a kaphu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg i 14.000 fødevarer og se, hvordan hver enkelt påvirker vata, pitta og kapha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche 14.000 Lebensmittel und erfahre, wie jedes auf Vata, Pitta und Kapha wirkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτησε ανάμεσα σε 14.000 τροφές και δες πώς επηρεάζει καθεμία το βάτα, το πίτα και το κάφα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca entre 14.000 alimentos y consulta cómo afecta cada uno a vata, pitta y kapha."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca entre 14,000 alimentos y observa cómo afecta cada uno a vata, pitta y kapha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae 14 000 ruoasta ja katso, miten kukin niistä vaikuttaa vataan, pittaan ja kaphaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche parmi 14 000 aliments et découvre comment chacun agit sur vata, pitta et kapha."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez parmi 14 000 aliments et voyez comment chacun agit sur vata, pitta et kapha."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 ખોરાકમાં શોધો અને જુઓ કે દરેક ખોરાક વાત, પિત્ત અને કફ પર કેવી અસર કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש בין 14,000 מזונות וראה כיצד כל אחד מהם משפיע על ואטה, פיטה וקאפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 खाद्य पदार्थ खोजें और देखें कि हर एक का वात, पित्त और कफ पर कैसा प्रभाव पड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretraži 14.000 namirnica i saznaj kako svaka utječe na vatu, pittu i kaphu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keress 14 000 élelmiszer között, és nézd meg, hogyan hat mindegyik a vata, pitta és kapha doshára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari 14.000 makanan dan lihat pengaruh masing-masing terhadap vata, pitta, dan kapha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca tra 14.000 alimenti e vedi come ciascuno influisce su vata, pitta e kapha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000種類の食品を検索して、それぞれがヴァータ、ピッタ、カパに与える影響を確認できます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "14 000 өнімнің ішінен іздеп, әрқайсысының вата, питта және капхаға қалай әсер ететінін көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 ಆಹಾರಗಳಲ್ಲಿ ಹುಡುಕಿ, ಪ್ರತಿಯೊಂದೂ ವಾತ, ಪಿತ್ತ ಮತ್ತು ಕಫಗಳ ಮೇಲೆ ಹೇಗೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ ಎಂದು ನೋಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000개 식품을 검색하고 각 식품이 바타, 피타, 카파에 미치는 영향을 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 ഭക്ഷണങ്ങളിൽ തിരഞ്ഞ്, ഓരോന്നും വാതം, പിത്തം, കഫം എന്നിവയെ എങ്ങനെ ബാധിക്കുന്നുവെന്ന് കാണുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 अन्नपदार्थ शोधा आणि प्रत्येकाचा वात, पित्त आणि कफ यांवर काय परिणाम होतो ते पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari 14,000 makanan dan lihat kesan setiap satunya terhadap vata, pitta dan kapha."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk blant 14 000 matvarer og se hvordan hver enkelt påvirker vata, pitta og kapha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzoek 14.000 voedingsmiddelen en bekijk hoe elk ervan vata, pitta en kapha beïnvloedt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000ଟି ଖାଦ୍ୟ ଖୋଜନ୍ତୁ ଏବଂ ପ୍ରତ୍ୟେକଟି ବାତ, ପିତ୍ତ ଓ କଫ ଉପରେ କିପରି ପ୍ରଭାବ ପକାଏ ଦେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 ਭੋਜਨਾਂ ਵਿੱਚੋਂ ਖੋਜੋ ਅਤੇ ਦੇਖੋ ਕਿ ਹਰ ਇੱਕ ਦਾ ਵਾਤ, ਪਿੱਤ ਅਤੇ ਕਫ਼ 'ਤੇ ਕੀ ਪ੍ਰਭਾਵ ਪੈਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuj 14 000 produktów i zobacz, jak każdy wpływa na dosze vata, pitta i kapha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque entre 14.000 alimentos e veja como cada um afeta vata, pitta e kapha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa 14 000 alimentos e vê como cada um afeta vata, pitta e kapha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută printre 14.000 de alimente și vezi cum afectează fiecare dintre ele vata, pitta și kapha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите среди 14 000 продуктов и смотрите, как каждый влияет на вату, питту и капху."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehľadávajte 14 000 potravín a zistite, ako každá ovplyvňuje vatu, pittu a kaphu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preiščite 14.000 živil in poglejte, kako vsako vpliva na vato, pitto in kapho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök bland 14 000 livsmedel och se hur vart och ett påverkar vata, pitta och kapha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 உணவுகளைத் தேடி, ஒவ்வொன்றும் வாதம், பித்தம், கபம் ஆகியவற்றில் என்ன விளைவை ஏற்படுத்துகிறது எனப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 ఆహారాలలో వెతికి, ప్రతి ఒక్కటి వాతం, పిత్తం మరియు కఫంపై ఎలాంటి ప్రభావం చూపుతుందో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาอาหาร 14,000 รายการ และดูว่าแต่ละรายการส่งผลต่อวาตะ ปิตตะ และกผะอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14.000 besin arasında arama yapın ve her birinin vata, pitta ve kapha üzerindeki etkisini görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте серед 14 000 продуктів і дивіться, як кожен із них впливає на вату, пітту й капху."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "14,000 غذائیں تلاش کریں اور دیکھیں کہ ہر غذا واتا، پتا اور کفا پر کیا اثر ڈالتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm trong 14.000 thực phẩm và xem từng món ảnh hưởng thế nào đến vata, pitta và kapha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索 14,000 种食物，查看每种食物对瓦塔、皮塔和卡法的影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋 14,000 種食物，查看每一項對瓦塔、皮塔與卡法的影響。"
          }
        }
      }
    },
