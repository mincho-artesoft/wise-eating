    "Apple Intelligence is turned off. Enable it in Settings to use AI exercise generation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence متوقف. فعّله في الإعدادات لاستخدام توليد التمارين عبر AI."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence е изключен. Включи го в Настройки, за да използваш AI генериране на упражнения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ আছে। AI দিয়ে ব্যায়াম তৈরি করতে সেটিংস থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence està desactivat. Activa'l a Configuració per fer servir la generació d'exercicis amb AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Chcete-li generovat cvičení pomocí AI, zapněte ji v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slået fra. Slå det til i Indstillinger for at bruge AI-øvelsesgenerering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es in den Einstellungen, um die AI-Übungsgenerierung zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποίησέ το στις Ρυθμίσεις για να χρησιμοποιήσεις τη δημιουργία ασκήσεων με AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes para usar la generación de ejercicios con IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Configuración para usar la generación de ejercicios con AI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on pois päältä. Ota se käyttöön Asetuksissa, jotta voit käyttää harjoitusten AI-generointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages pour utiliser la génération d'exercices avec AI."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivée. Activez-la dans Réglages pour utiliser la génération d'exercices par AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence બંધ છે. AI કસરત જનરેશનનો ઉપયોગ કરવા માટે તેને સેટિંગ્સમાં ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence כבוי. הפעל אותו בהגדרות כדי להשתמש ביצירת תרגילים עם AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है। AI व्यायाम जनरेशन का उपयोग करने के लिए इसे सेटिंग्ज़ में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je isključen. Uključi ga u Postavkama za korištenje AI generiranja vježbi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence ki van kapcsolva. Engedélyezd a Beállításokban a gyakorlatok AI-generálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Aktifkan di Pengaturan untuk menggunakan pembuatan gerakan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivata. Attivala in Impostazioni per usare la generazione di esercizi con l'AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。AIエクササイズ生成を使用するには、「設定」でオンにしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence өшірулі. AI арқылы жаттығу жасауды пайдалану үшін оны Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಆಫ್ ಆಗಿದೆ. AI ವ್ಯಾಯಾಮ ರಚನೆಯನ್ನು ಬಳಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. AI 운동 생성을 사용하려면 설정에서 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ഓഫ് ആണ്. AI വ്യായാമ ജനറേഷൻ ഉപയോഗിക്കാൻ ക്രമീകരണങ്ങളിൽ ഇത് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद आहे. AI व्यायाम निर्मिती वापरण्यासाठी ते सेटिंग्जमध्ये सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Dayakannya dalam Seting untuk menggunakan penjanaan latihan AI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slått av. Slå den på i Innstillinger for å bruke AI-generering av øvelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is uitgeschakeld. Schakel het in bij Instellingen om oefeningen met AI te genereren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ବନ୍ଦ ଅଛି। AI ବ୍ୟାୟାମ ଜେନେରେସନ୍ ବ୍ୟବହାର କରିବାକୁ ସେଟିଂସ୍‌ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਬੰਦ ਹੈ। AI ਕਸਰਤ ਜਨਰੇਸ਼ਨ ਵਰਤਣ ਲਈ ਇਸ ਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Apple Intelligence jest wyłączona. Włącz ją w Ustawieniach, aby generować ćwiczenia z AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes para usar a geração de exercícios com AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ativa-a nas Definições para usar a geração de exercícios com AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence este dezactivat. Activează-l în Configurări pentru a folosi generarea de exerciții cu AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функция Apple Intelligence выключена. Включите её в Настройках, чтобы использовать генерацию упражнений с AI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Ak chcete používať generovanie cvičení pomocou AI, zapnite ju v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je izklopljen. Za ustvarjanje vaj z AI ga omogočite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är avstängt. Aktivera det i Inställningar för att använda AI-generering av övningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence முடக்கப்பட்டுள்ளது. AI உடற்பயிற்சி உருவாக்கத்தைப் பயன்படுத்த அமைப்புகளில் இதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఆఫ్ చేయబడింది. AI వ్యాయామ జనరేషన్‌ను ఉపయోగించడానికి సెట్టింగ్‌లలో దీనిని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ปิดอยู่ เปิดใช้งานในการตั้งค่าเพื่อใช้การสร้างท่าออกกำลังกายด้วย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı. AI egzersiz oluşturmayı kullanmak için Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вимкнено. Увімкніть його в Параметрах, щоб користуватися генерацією вправ за допомогою AI."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence بند ہے۔ AI کے ذریعے مشقیں تیار کرنے کے لیے اسے سیٹنگز میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt. Hãy bật trong Cài đặt để dùng tính năng tạo bài tập bằng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能已关闭。请在“设置”中开启以使用 AI 运动生成功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已關閉。請在「設定」中啟用，以使用 AI 運動生成功能。"
          }
        }
      }
    },
    "The model is downloading or preparing. Please try again in a bit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج قيد التنزيل أو التجهيز. يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът се изтегля или подготвя. Моля, опитай отново след малко."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেলটি ডাউনলোড বা প্রস্তুত হচ্ছে। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El model s'està descarregant o preparant. Torna-ho a provar d'aquí a una mica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se stahuje nebo připravuje. Zkuste to prosím za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen downloades eller klargøres. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wird geladen oder vorbereitet. Bitte versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο βρίσκεται σε λήψη ή προετοιμασία. Προσπάθησε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo se está descargando o preparando. Inténtalo de nuevo en un momento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo se está descargando o preparando. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallia ladataan tai valmistellaan. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en cours de téléchargement ou de préparation. Réessaie dans un moment."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en cours de téléchargement ou de préparation. Veuillez réessayer dans un moment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૉડલ ડાઉનલોડ થઈ રહ્યું છે અથવા તૈયાર થઈ રહ્યું છે. કૃપા કરીને થોડી વાર પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל בהורדה או בהכנה. אנא נסה שוב בעוד זמן קצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल डाउनलोड हो रहा है या तैयार हो रहा है। कृपया थोड़ी देर बाद फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se preuzima ili priprema. Pokušaj ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell letöltése vagy előkészítése folyamatban van. Próbáld újra hamarosan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sedang diunduh atau disiapkan. Silakan coba beberapa saat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è in fase di download o preparazione. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロードまたは準備中です。しばらくしてからもう一度お試しください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель жүктеліп немесе дайындалып жатыр. Сәлден кейін қайталап көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಡೆಲ್ ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ ಅಥವಾ ಸಿದ್ಧವಾಗುತ್ತಿದೆ. ದಯವಿಟ್ಟು ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 다운로드하거나 준비하고 있습니다. 잠시 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഡൽ ഡൗൺലോഡ് ചെയ്യുകയോ തയ്യാറാകുകയോ ആണ്. ദയവായി അല്പസമയം കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडेल डाउनलोड किंवा तयार होत आहे. कृपया थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sedang dimuat turun atau disediakan. Sila cuba lagi sebentar nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen lastes ned eller klargjøres. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model wordt gedownload of voorbereid. Probeer het over een ogenblik opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମଡେଲ୍ ଡାଉନଲୋଡ୍ ହେଉଛି କିମ୍ବା ପ୍ରସ୍ତୁତ ହେଉଛି। ଦୟାକରି କିଛି ସମୟ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਡਲ ਡਾਊਨਲੋਡ ਜਾਂ ਤਿਆਰ ਹੋ ਰਿਹਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model jest pobierany lub przygotowywany. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está sendo baixado ou preparado. Tente novamente em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está a ser descarregado ou preparado. Tenta novamente dentro de momentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul se descarcă sau se pregătește. Te rugăm să încerci din nou peste puțin timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель загружается или подготавливается. Попробуйте снова чуть позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sa sťahuje alebo pripravuje. Skúste to znova o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se prenaša ali pripravlja. Prosimo, poskusite znova čez nekaj časa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen hämtas eller förbereds. Försök igen om en stund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதிரி பதிவிறக்கப்படுகிறது அல்லது தயாராகிறது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడల్ డౌన్‌లోడ్ అవుతోంది లేదా సిద్ధమవుతోంది. దయచేసి కొద్దిసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลกำลังดาวน์โหลดหรือเตรียมพร้อม โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model indiriliyor veya hazırlanıyor. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель завантажується або готується. Спробуйте ще раз трохи згодом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل ڈاؤن لوڈ یا تیار ہو رہا ہے۔ براہ کرم تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đang được tải xuống hoặc chuẩn bị. Vui lòng thử lại sau ít phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型正在下载或准备中，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型正在下載或準備中。請稍後再試。"
          }
        }
      }
    },
    "Apple Intelligence requires iOS 26 or newer. Update your OS to use this feature.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب Apple Intelligence نظام iOS 26 أو أحدث. حدّث نظام التشغيل لاستخدام هذه الميزة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence изисква iOS 26 или по-нова версия. Актуализирай операционната система, за да използваш тази функция."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ব্যবহার করতে iOS 26 বা তার চেয়ে নতুন সংস্করণ প্রয়োজন। এই সুবিধা পেতে আপনার OS আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence requereix iOS 26 o posterior. Actualitza el sistema operatiu per fer servir aquesta funció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vyžaduje iOS 26 nebo novější. Chcete-li tuto funkci používat, aktualizujte operační systém."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kræver iOS 26 eller nyere. Opdater dit OS for at bruge denne funktion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence erfordert iOS 26 oder neuer. Aktualisiere dein Betriebssystem, um diese Funktion zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence απαιτεί iOS 26 ή νεότερο. Ενημέρωσε το λειτουργικό σου σύστημα για να χρησιμοποιήσεις αυτή τη λειτουργία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence requiere iOS 26 o posterior. Actualiza tu sistema operativo para usar esta función."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence requiere iOS 26 o posterior. Actualiza tu sistema operativo para usar esta función."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vaatii iOS 26:n tai uudemman. Päivitä käyttöjärjestelmäsi käyttääksesi tätä ominaisuutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nécessite iOS 26 ou version ultérieure. Mets à jour ton système pour utiliser cette fonctionnalité."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nécessite iOS 26 ou une version ultérieure. Mettez à jour votre système pour utiliser cette fonctionnalité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence માટે iOS 26 અથવા નવું વર્ઝન જરૂરી છે. આ સુવિધાનો ઉપયોગ કરવા માટે તમારું OS અપડેટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence דורש iOS 26 ואילך. עדכן את מערכת ההפעלה שלך כדי להשתמש בתכונה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence के लिए iOS 26 या नया संस्करण आवश्यक है। इस सुविधा का उपयोग करने के लिए अपना OS अपडेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence zahtijeva iOS 26 ili noviji. Ažuriraj OS za korištenje ove značajke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence használatához iOS 26 vagy újabb rendszer szükséges. Frissítsd a rendszert a funkció használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence memerlukan iOS 26 atau lebih baru. Perbarui OS Anda untuk menggunakan fitur ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence richiede iOS 26 o versioni successive. Aggiorna il sistema operativo per usare questa funzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple IntelligenceにはiOS 26以降が必要です。この機能を使用するにはOSをアップデートしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence үшін iOS 26 немесе одан жаңа нұсқасы қажет. Бұл мүмкіндікті пайдалану үшін операциялық жүйені жаңартыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಗೆ iOS 26 ಅಥವಾ ಹೊಸ ಆವೃತ್ತಿಯ ಅಗತ್ಯವಿದೆ. ಈ ವೈಶಿಷ್ಟ್ಯವನ್ನು ಬಳಸಲು ನಿಮ್ಮ OS ಅನ್ನು ನವೀಕರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 사용하려면 iOS 26 이상이 필요합니다. 이 기능을 사용하려면 OS를 업데이트하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-ന് iOS 26 അല്ലെങ്കിൽ അതിലും പുതിയ പതിപ്പ് ആവശ്യമാണ്. ഈ ഫീച്ചർ ഉപയോഗിക്കാൻ നിങ്ങളുടെ OS അപ്ഡേറ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence साठी iOS 26 किंवा नवीन आवृत्ती आवश्यक आहे. हे वैशिष्ट्य वापरण्यासाठी तुमची OS अद्ययावत करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence memerlukan iOS 26 atau lebih baharu. Kemas kini OS anda untuk menggunakan ciri ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence krever iOS 26 eller nyere. Oppdater operativsystemet for å bruke denne funksjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vereist iOS 26 of nieuwer. Werk je besturingssysteem bij om deze functie te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ପାଇଁ iOS 26 କିମ୍ବା ପରବର୍ତ୍ତୀ ସଂସ୍କରଣ ଆବଶ୍ୟକ। ଏହି ସୁବିଧା ବ୍ୟବହାର କରିବାକୁ ଆପଣଙ୍କ OS ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਲਈ iOS 26 ਜਾਂ ਨਵਾਂ ਸੰਸਕਰਣ ਲੋੜੀਂਦਾ ਹੈ। ਇਸ ਵਿਸ਼ੇਸ਼ਤਾ ਦੀ ਵਰਤੋਂ ਕਰਨ ਲਈ ਆਪਣਾ OS ਅੱਪਡੇਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wymaga systemu iOS 26 lub nowszego. Zaktualizuj system, aby korzystać z tej funkcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence requer o iOS 26 ou posterior. Atualize seu sistema para usar este recurso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence requer o iOS 26 ou posterior. Atualiza o sistema operativo para usar esta funcionalidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence necesită iOS 26 sau o versiune ulterioară. Actualizează sistemul de operare pentru a folosi această funcție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Apple Intelligence требуется iOS 26 или новее. Обновите систему, чтобы использовать эту функцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vyžaduje iOS 26 alebo novší. Ak chcete túto funkciu používať, aktualizujte svoj operačný systém."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence zahteva iOS 26 ali novejši sistem. Za uporabo te funkcije posodobite sistem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kräver iOS 26 eller senare. Uppdatera ditt OS för att använda den här funktionen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-க்கு iOS 26 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்த வசதியைப் பயன்படுத்த உங்கள் OS-ஐப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence కి iOS 26 లేదా అంతకంటే కొత్త వెర్షన్ అవసరం. ఈ ఫీచర్‌ను ఉపయోగించడానికి మీ OS ను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ต้องใช้ iOS 26 ขึ้นไป อัปเดตระบบปฏิบัติการของคุณเพื่อใช้คุณสมบัตินี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, iOS 26 veya daha yeni bir sürüm gerektirir. Bu özelliği kullanmak için işletim sisteminizi güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Apple Intelligence потрібна iOS 26 або новіша версія. Оновіть ОС, щоб користуватися цією функцією."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence کے لیے iOS 26 یا اس سے نیا ورژن درکار ہے۔ اس فیچر کو استعمال کرنے کے لیے اپنا OS اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence yêu cầu iOS 26 trở lên. Hãy cập nhật hệ điều hành để dùng tính năng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能需要 iOS 26 或更高版本。请更新你的操作系统以使用此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 需要 iOS 26 或更新版本。請更新你的作業系統以使用此功能。"
          }
        }
      }
    },
