        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೀರ್ಣಸಾಧ್ಯತೆ ಮತ್ತು ಅಗ್ನಿ ಪರಿಣಾಮವನ್ನು ಒಟ್ಟಿಗೆ ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
