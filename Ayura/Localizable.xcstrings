        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل ڈاؤن لوڈ یا تیار ہو رہا ہے۔ براہ کرم تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đang tải xuống hoặc chuẩn bị. Vui lòng thử lại sau ít phút."
