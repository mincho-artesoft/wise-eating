    "Are you sure you want to delete the node titled \"%@\"? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في حذف الملاحظة بعنوان «%@»؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш бележката със заглавие „%@“? Това действие не може да бъде отменено."
          }
