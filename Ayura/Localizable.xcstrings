        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makanan ini digunakan di %lld resep, menu, atau rencana makan.\nJika Anda menghapusnya, makanan ini akan dihapus dari tempat-tempat tersebut.\n\nApakah Anda yakin ingin melanjutkan?"
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
