    "⚠️ This recipe contains allergens the user is sensitive to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ تحتوي هذه الوصفة على مسببات حساسية يتحسس منها المستخدم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Тази рецепта съдържа алергени, към които потребителят е чувствителен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ এই রেসিপিতে এমন অ্যালার্জেন রয়েছে যার প্রতি ব্যবহারকারীর সংবেদনশীলতা আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aquesta recepta conté al·lèrgens als quals l'usuari és sensible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Tento recept obsahuje alergeny, na které je uživatel citlivý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Denne opskrift indeholder allergener, som brugeren er følsom over for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Dieses Rezept enthält Allergene, auf die der Nutzer empfindlich reagiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Αυτή η συνταγή περιέχει αλλεργιογόνα στα οποία ο χρήστης έχει ευαισθησία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receta contiene alérgenos a los que el usuario es sensible."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Esta receta contiene alérgenos a los que el usuario es sensible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Tämä resepti sisältää allergeeneja, joille käyttäjä on herkkä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cette recette contient des allergènes auxquels l'utilisateur est sensible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cette recette contient des allergènes auxquels l'utilisateur est sensible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ આ રેસીપીમાં એવા એલર્જન્સ છે જેના પ્રત્યે વપરાશકર્તા સંવેદનશીલ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ מתכון זה מכיל אלרגנים שהמשתמש רגיש אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ इस व्यंजन में ऐसे एलर्जेन हैं जिनके प्रति उपयोगकर्ता संवेदनशील है।"
