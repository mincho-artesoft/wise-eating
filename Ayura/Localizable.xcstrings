        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať túto šaržu (%@ %@, spotrebovať do: %@)? Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati to serijo (%@ %@, poteče: %@)? Tega dejanja ni mogoče razveljaviti."
