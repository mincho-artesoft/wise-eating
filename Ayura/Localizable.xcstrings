        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %@ ಗಾಗಿ ವರ್ಕೌಟ್‌ಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ. ನಿರ್ದಿಷ್ಟ ಸಮಯದ ಸ್ಲಾಟ್‌ನ ವರ್ಕೌಟ್‌ಗಳನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸಬೇಕು?"
