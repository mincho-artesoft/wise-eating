    "No ingredient nutrition could be resolved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد القيمة الغذائية لأي مكوّن."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можаха да се определят хранителните стойности на съставките."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো উপকরণের পুষ্টি তথ্য নির্ণয় করা যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut obtenir la informació nutricional de cap ingredient."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se určit nutriční hodnoty žádné ingredience."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen næringsdata for ingredienser kunne findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für keine Zutat konnten Nährwerte ermittelt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εύρεση διατροφικών στοιχείων για τα υλικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la información nutricional de ningún ingrediente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la información nutricional de ningún ingrediente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdenkään ainesosan ravintotietoja ei voitu selvittää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée nutritionnelle n'a pu être déterminée pour les ingrédients."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer les valeurs nutritives des ingrédients."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ સામગ્રીની પોષણ માહિતી મળી શકી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לאתר ערכים תזונתיים עבור המרכיבים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी सामग्री का पोषण डेटा नहीं मिल सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije bilo moguće odrediti nutritivne vrijednosti sastojaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen összetevő tápértékét sem sikerült meghatározni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada nutrisi bahan yang dapat dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile determinare i valori nutrizionali degli ingredienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料の栄養情報を取得できませんでした。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ингредиенттердің тағамдылық деректерін анықтау мүмкін болмады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಪದಾರ್ಥದ ಪೋಷಕಾಂಶ ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료의 영양 정보를 확인할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചേരുവകളുടെ പോഷക വിവരങ്ങളൊന്നും കണ്ടെത്താനായില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही घटकाचे पोषणमूल्य मिळू शकले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada nutrisi bahan dapat ditentukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finne næringsdata for noen ingredienser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er konden geen voedingswaarden van ingrediënten worden bepaald."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ଉପାଦାନର ପୋଷଣ ତଥ୍ୟ ମିଳିପାରିଲା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਵੀ ਸਮੱਗਰੀ ਦੀ ਪੋਸ਼ਣ ਜਾਣਕਾਰੀ ਨਹੀਂ ਮਿਲ ਸਕੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustalić wartości odżywczych żadnego składnika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter os dados nutricionais de nenhum ingrediente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a nutrição de nenhum ingrediente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au putut determina valorile nutriționale ale ingredientelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить пищевую ценность ингредиентов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa určiť výživové hodnoty žiadnej ingrediencie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatkov o hranilni vrednosti sestavin ni bilo mogoče določiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget näringsvärde kunde hämtas för ingredienserna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தப் பொருளின் ஊட்டச்சத்து விவரமும் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ పదార్థం యొక్క పోషకాహార వివరాలను గుర్తించలేకపోయాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดึงข้อมูลโภชนาการของวัตถุดิบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir malzemenin besin değeri çözümlenemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити поживну цінність жодного інгредієнта."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی جزو کی غذائی معلومات حاصل نہیں ہو سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định dinh dưỡng của nguyên liệu nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
