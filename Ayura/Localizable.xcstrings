    "Notifications are disabled. Please enable them in Settings if you want to use reminders for your meals.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطّلة. يُرجى تفعيلها في الإعدادات إذا أردت استخدام التذكيرات لوجباتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са изключени. Моля, включи ги в Настройки, ако искаш да използваш напомняния за храненията си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি বন্ধ আছে। আপনি যদি আপনার খাবারের জন্য রিমাইন্ডার ব্যবহার করতে চান, তবে অনুগ্রহ করে সেটিংস থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan desactivades. Activa-les a Configuració si vols fer servir recordatoris per als teus àpats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou vypnutá. Pokud chcete používat připomenutí jídel, zapněte je prosím v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er deaktiveret. Aktivér dem i Indstillinger, hvis du vil bruge påmindelser til dine måltider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Bitte aktiviere sie in den Einstellungen, wenn du Erinnerungen für deine Mahlzeiten nutzen möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι απενεργοποιημένες. Ενεργοποίησέ τες στις Ρυθμίσεις αν θέλεις να χρησιμοποιείς υπενθυμίσεις για τα γεύματά σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes si quieres usar recordatorios para tus comidas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Configuración si quieres usar recordatorios para tus comidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat poissa käytöstä. Ota ne käyttöön Asetuksissa, jos haluat käyttää ateriamuistutuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Active-les dans Réglages si tu souhaites utiliser des rappels pour tes repas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Veuillez les activer dans Réglages si vous souhaitez recevoir des rappels pour vos repas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ અક્ષમ છે. જો તમે તમારા ભોજન માટે રિમાઇન્ડર્સનો ઉપયોગ કરવા માંગતા હો, તો કૃપા કરીને સેટિંગ્સમાં તેમને સક્ષમ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות מושבתות. הפעל אותן בהגדרות אם ברצונך להשתמש בתזכורות לארוחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएं अक्षम हैं। यदि आप अपने भोजन के लिए रिमाइंडर उपयोग करना चाहते हैं, तो कृपया उन्हें सेटिंग्ज़ में सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su onemogućene. Omogući ih u Postavkama ako želiš koristiti podsjetnike za obroke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. Kapcsold be őket a Beállításokban, ha emlékeztetőket szeretnél az étkezésekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dinonaktifkan. Harap aktifkan di Pengaturan jika Anda ingin menggunakan pengingat untuk waktu makan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Abilitale in Impostazioni se vuoi usare i promemoria per i tuoi pasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効になっています。食事のリマインダーを使用する場合は、設定で有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар өшірілген. Тамақтану еске салғыштарын пайдаланғыңыз келсе, оларды Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಊಟಗಳಿಗೆ ಜ್ಞಾಪನೆಗಳನ್ನು ಬಳಸಲು ಬಯಸಿದರೆ ದಯವಿಟ್ಟು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 비활성화되어 있습니다. 식사 알림을 사용하려면 설정에서 활성화해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയിപ്പുകൾ പ്രവർത്തനരഹിതമാണ്. നിങ്ങളുടെ ഭക്ഷണങ്ങൾക്കായി ഓർമ്മപ്പെടുത്തലുകൾ ഉപയോഗിക്കണമെങ്കിൽ ക്രമീകരണങ്ങളിൽ അവ പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना बंद आहेत. तुम्हाला तुमच्या जेवणासाठी स्मरणपत्रे वापरायची असल्यास कृपया सेटिंग्जमध्ये त्या सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinyahdayakan. Sila dayakannya dalam Seting jika anda mahu menggunakan peringatan untuk hidangan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er slått av. Slå dem på i Innstillinger hvis du vil bruke påminnelser for måltidene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn uitgeschakeld. Schakel ze in bij Instellingen als je herinneringen voor je maaltijden wilt gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଜ୍ଞପ୍ତିଗୁଡ଼ିକ ଅକ୍ଷମ ଅଛି। ଯଦି ଆପଣ ନିଜ ଭୋଜନ ପାଇଁ ସ୍ମାରକ ବ୍ୟବହାର କରିବାକୁ ଚାହୁଁଛନ୍ତି, ତେବେ ଦୟାକରି ସେଟିଂସ୍‌ରେ ସେଗୁଡ଼ିକୁ ସକ୍ଷମ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਜੇ ਤੁਸੀਂ ਆਪਣੇ ਭੋਜਨਾਂ ਲਈ ਰੀਮਾਈਂਡਰ ਵਰਤਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਜਾ ਕੇ ਇਨ੍ਹਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Włącz je w Ustawieniach, jeśli chcesz otrzymywać przypomnienia o posiłkach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative-as em Ajustes se quiser usar lembretes para suas refeições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ativa-as nas Definições se quiseres usar lembretes para as tuas refeições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate. Activează-le în Configurări dacă dorești să folosești mementouri pentru mese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Включите их в Настройках, если хотите использовать напоминания о приёмах пищи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia sú vypnuté. Ak chcete používať pripomienky jedál, povoľte ich v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila so onemogočena. Če želite uporabljati opomnike za svoje obroke, jih omogočite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är inaktiverade. Aktivera dem i Inställningar om du vill använda påminnelser för dina måltider."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் முடக்கப்பட்டுள்ளன. உங்கள் உணவுகளுக்கான நினைவூட்டல்களைப் பயன்படுத்த விரும்பினால், அமைப்புகளில் அவற்றை இயக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్లు నిలిపివేయబడ్డాయి. మీ భోజనాలకు రిమైండర్లను ఉపయోగించాలనుకుంటే దయచేసి సెట్టింగ్‌లలో వాటిని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการแจ้งเตือนอยู่ โปรดเปิดใช้งานในการตั้งค่าหากคุณต้องการใช้การเตือนสำหรับมื้ออาหารของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler devre dışı. Öğünleriniz için hatırlatıcı kullanmak istiyorsanız lütfen Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Увімкніть їх у Параметрах, якщо хочете отримувати нагадування про прийоми їжі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات بند ہیں۔ اگر آپ اپنے کھانوں کے لیے یاددہانیاں استعمال کرنا چاہتے ہیں تو براہ کرم سیٹنگز میں جا کر انہیں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. Vui lòng bật trong Cài đặt nếu bạn muốn dùng lời nhắc cho các bữa ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已停用。如需使用餐食提醒，请在“设置”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已停用。若要使用餐點提醒，請在「設定」中開啟通知。"
          }
        }
      }
