            "state": "translated",
            "value": "Treci la planul %@ pentru a debloca și folosi acest profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите на тариф «%@», чтобы разблокировать и использовать этот профиль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete tento profil odomknúť a používať, prejdite na plán %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgradite na paket %@, da odklenete in uporabljate ta profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgradera till planen %@ för att låsa upp och använda den här profilen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுயவிவரத்தைத் திறந்து பயன்படுத்த %@ திட்டத்திற்கு மேம்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రొఫైల్‌ను అన్‌లాక్ చేసి ఉపయోగించడానికి %@ ప్లాన్‌కు అప్‌గ్రేడ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเกรดเป็นแผน %@ เพื่อปลดล็อกและใช้งานโปรไฟล์นี้"
          }
        },
        "tr": {
