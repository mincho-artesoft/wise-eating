    "Are you sure you want to delete this prompt? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد حذف هذا الطلب؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш този промпт? Това действие е необратимо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিতভাবে এই প্রম্পটটি মুছতে চান? এই কাজটি আর পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols suprimir aquesta indicació? Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat tento pokyn? Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne prompt? Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diesen Prompt wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις αυτή την προτροπή; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar esta indicación? Esta acción no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar este prompt? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa tämän kehotteen? Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer ce prompt ? Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette invite? Cette action est irréversible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર આ પ્રોમ્પ્ટ કાઢી નાખવા માંગો છો? આ ક્રિયા પૂર્વવત્ કરી શકાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק הנחיה זו? לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई यह प्रॉम्प्ट हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati ovaj upit? Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törlöd ezt a promptot? Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus prompt ini? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare questo prompt? Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロンプトを削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл промптты жойғыңыз келетініне сенімдісіз бе? Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರಾಂಪ್ಟ್ ಅನ್ನು ನೀವು ಖಚಿತವಾಗಿ ಅಳಿಸಲು ಬಯಸುವಿರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프롬프트를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രോംപ്റ്റ് ഇല്ലാതാക്കണമെന്ന് നിങ്ങൾക്ക് ഉറപ്പാണോ? ഈ പ്രവൃത്തി പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्हाला हा प्रॉम्प्ट हटवायचा आहे? ही कृती पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadam gesaan ini? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne ledeteksten? Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze prompt wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ ଭାବେ ଏହି ପ୍ରମ୍ପ୍ଟକୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି? ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରିହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ ਇਹ ਪ੍ਰੌਂਪਟ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਲਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć ten prompt? Tej czynności nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar este prompt? Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar esta instrução? Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur vrei să ștergi acest prompt? Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить этот промпт? Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať tento pokyn? Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati ta poziv? Tega dejanja ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera den här prompten? Åtgärden kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ப்ராம்ப்ட்டை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా ఈ ప్రాంప్ట్‌ను తొలగించాలనుకుంటున్నారా? ఈ చర్యను రద్దు చేయలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบพรอมต์นี้ การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istemi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цей запит? Цю дію неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی یہ پرامپٹ حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa câu lệnh này không? Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此提示词吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除此提示詞嗎？此操作無法復原。"
          }
        }
      }
    },
