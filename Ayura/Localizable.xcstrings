            "state": "translated",
            "value": "Jídla, tréninky a připomínky na jednom místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måltider, træninger og påmindelser samlet ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahlzeiten, Workouts und Erinnerungen an einem Ort."
