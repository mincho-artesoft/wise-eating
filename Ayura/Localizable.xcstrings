        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aquest pla d'entrenament té %lld entrenament vinculat.\n\n• «Suprimeix només el pla» eliminarà el pla però mantindrà l'entrenament a la teva biblioteca d'exercicis.\n• «Suprimeix el pla i els entrenaments» suprimirà el pla i també aquest entrenament vinculat.\n\nQuè vols fer?"
                }
              },
              "other": {
                "stringUnit": {
