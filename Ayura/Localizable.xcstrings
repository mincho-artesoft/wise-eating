    "To use the live preview, allow camera access in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام المعاينة المباشرة، اسمح بالوصول إلى الكاميرا في الإعدادات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да използваш прегледа на живо, разреши достъпа до камерата в Настройки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ পূর্বরূপ ব্যবহার করতে সেটিংসে গিয়ে ক্যামেরা ব্যবহারের অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fer servir la previsualització en directe, permet l'accés a la càmera a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro použití živého náhledu povolte přístup k fotoaparátu v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang til kameraet i Indstillinger for at bruge live-forhåndsvisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff in den Einstellungen, um die Live-Vorschau zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να χρησιμοποιήσεις τη ζωντανή προεπισκόπηση, επίτρεψε την πρόσβαση στην κάμερα από τις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar la vista previa en directo, permite el acceso a la cámara en Ajustes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar la vista previa en vivo, permite el acceso a la cámara en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kameran käyttö Asetuksissa käyttääksesi live-esikatselua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser l'aperçu en direct, autorise l'accès à l'appareil photo dans Réglages."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser l'aperçu en direct, autorisez l'accès à l'appareil photo dans Réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇવ પૂર્વાવલોકનનો ઉપયોગ કરવા માટે, સેટિંગ્સમાં કૅમેરાની ઍક્સેસ આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש בתצוגה החיה, אפשר גישה למצלמה בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव पूर्वावलोकन का उपयोग करने के लिए, सेटिंग्ज़ में कैमरा एक्सेस की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za korištenje pregleda uživo dopusti pristup kameri u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő előnézet használatához engedélyezd a kamerahozzáférést a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan pratinjau langsung, izinkan akses kamera di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare l'anteprima in tempo reale, consenti l'accesso alla fotocamera in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブプレビューを使用するには、設定でカメラへのアクセスを許可してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тікелей қарауды пайдалану үшін Реттеулерде камераға рұқсат беріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈವ್ ಪೂರ್ವವೀಕ್ಷಣೆ ಬಳಸಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಕ್ಯಾಮೆರಾ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 미리보기를 사용하려면 설정에서 카메라 접근을 허용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് പ്രിവ്യൂ ഉപയോഗിക്കാൻ, ക്രമീകരണങ്ങളിൽ ക്യാമറ അനുമതി നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थेट पूर्वावलोकन वापरण्यासाठी, सेटिंग्जमध्ये कॅमेरा प्रवेशास अनुमती द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan pratonton langsung, benarkan akses kamera dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi kameratilgang i Innstillinger for å bruke direktevisning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe in Instellingen om de live voorvertoning te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଇଭ୍ ପୂର୍ବାବଲୋକନ ବ୍ୟବହାର କରିବାକୁ, ସେଟିଂସ୍‌ରେ କ୍ୟାମେରା ଅନୁମତି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਵ ਝਲਕ ਵਰਤਣ ਲਈ, ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕੈਮਰੇ ਦੀ ਪਹੁੰਚ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać podglądu na żywo, zezwól na dostęp do aparatu w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar a visualização ao vivo, permita o acesso à câmera nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar a pré-visualização em direto, permite o acesso à câmara nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a folosi previzualizarea live, permite accesul la cameră în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать предпросмотр, разрешите доступ к камере в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať živý náhľad, povoľte prístup ku kamere v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo predogleda v živo dovolite dostop do kamere v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt kameraåtkomst i Inställningar för att använda liveförhandsvisningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரடி முன்னோட்டத்தைப் பயன்படுத்த, அமைப்புகளில் கேமரா அணுகலை அனுமதிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ ప్రివ్యూను ఉపయోగించడానికి, సెట్టింగ్‌లలో కెమెరా అనుమతిని ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการใช้การแสดงภาพสด โปรดอนุญาตการเข้าถึงกล้องในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı önizlemeyi kullanmak için Ayarlar'dan kamera erişimine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб користуватися живим переглядом, дозвольте доступ до камери в Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو پیش منظر استعمال کرنے کے لیے سیٹنگز میں کیمرا تک رسائی کی اجازت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem trực tiếp, hãy cho phép truy cập camera trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用实时预览，请在“设置”中允许访问相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用即時預覽，請在「設定」中允許存取相機。"
          }
        }
      }
    },
