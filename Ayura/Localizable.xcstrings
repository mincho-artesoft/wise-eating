          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की दिखावट बदलने के लिए कोई थीम या बैकग्राउंड छवि चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi temu ili pozadinsku sliku za promjenu izgleda aplikacije."
          }
