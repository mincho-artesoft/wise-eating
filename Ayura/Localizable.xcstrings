        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन, वर्कआउट और रिमाइंडर एक ही स्थान पर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroci, treninzi i podsjetnici na jednom mjestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Étkezések, edzések és emlékeztetők egy helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu makan, latihan, dan pengingat di satu tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasti, allenamenti e promemoria in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事、ワークアウト、リマインダーを1か所で管理できます。"
