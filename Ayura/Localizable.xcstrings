        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଭୋଜନର ଶେଷ ସମୟ ତାହାର ଆରମ୍ଭ ସମୟ ପରେ ହେବା ଆବଶ୍ୟକ।"
