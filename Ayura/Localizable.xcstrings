    "Over the past week or two, your appetite has been?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الأسبوع أو الأسبوعين الماضيين، كيف كانت شهيتك؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През последните една-две седмици апетитът ти беше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত এক-দুই সপ্তাহে আপনার ক্ষুধা কেমন ছিল?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant les últimes una o dues setmanes, com ha estat la teva gana?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaká byla za poslední týden nebo dva vaše chuť k jídlu?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste par uger har din appetit været?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie war dein Appetit in den letzten ein bis zwei Wochen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τις τελευταίες μία με δύο εβδομάδες, η όρεξή σου ήταν;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo ha sido tu apetito?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo ha estado tu apetito?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Millainen ruokahalusi on ollut viimeisen viikon tai kahden aikana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, ton appétit a été ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, comment a été votre appétit?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા એક-બે અઠવાડિયામાં તમારી ભૂખ કેવી રહી છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשבוע או בשבועיים האחרונים, איך היה התיאבון שלך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक-दो सप्ताह में आपकी भूख कैसी रही है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakav je bio tvoj apetit u proteklih tjedan ili dva?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt egy-két hétben milyen volt az étvágyad?"
          }
        },
