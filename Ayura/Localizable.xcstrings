        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb af Lifetime annullerer ikke dit abonnement. Administrer dit abonnement for at undgå fremtidige fornyelsesgebyrer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat à vie n’annule pas votre abonnement. Gérez votre abonnement pour éviter de futurs frais de renouvellement."
