    "Choose a monthly or yearly plan, or add a credit pack. Local models do not spend credits.": {
      "extractionState": "manual",
      "localizations": {
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਮਹੀਨਾਵਾਰ ਜਾਂ ਸਾਲਾਨਾ ਯੋਜਨਾ ਚੁਣੋ, ਜਾਂ ਇੱਕ ਕ੍ਰੈਡਿਟ ਪੈਕ ਸ਼ਾਮਲ ਕਰੋ। ਸਥਾਨਕ ਮਾਡਲ ਕ੍ਰੈਡਿਟ ਖਰਚ ਨਹੀਂ ਕਰਦੇ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un plan lunar sau anual sau adăugați un pachet de credite. Modelele locale nu cheltuiesc credite."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете месечен или годишен план или добавете кредитен пакет. Местните модели не харчат кредити."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un plan mensual o anual, o agregue un paquete de crédito. Los modelos locales no gastan créditos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih paket bulanan atau tahunan, atau tambahkan paket kredit. Model lokal tidak mengeluarkan kredit."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രതിമാസ അല്ലെങ്കിൽ വാർഷിക പ്ലാൻ തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ ഒരു ക്രെഡിറ്റ് പായ്ക്ക് ചേർക്കുക. പ്രാദേശിക മോഡലുകൾ ക്രെഡിറ്റുകൾ ചെലവഴിക്കുന്നില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதாந்திர அல்லது வருடாந்திர திட்டத்தைத் தேர்வுசெய்யவும் அல்லது கிரெடிட் பேக்கைச் சேர்க்கவும். உள்ளூர் மாதிரிகள் வரவுகளை செலவிடுவதில்லை."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un plan mensual o anual, o agregue un paquete de crédito. Los modelos locales no gastan créditos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plan miesięczny lub roczny albo dodaj pakiet punktów. Lokalne modele nie wydają kredytów."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মাসিক বা বার্ষিক পরিকল্পনা চয়ন করুন, বা একটি ক্রেডিট প্যাক যোগ করুন। স্থানীয় মডেল ক্রেডিট খরচ না."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un piano mensile o annuale oppure aggiungi un pacchetto di crediti. I modelli locali non spendono crediti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ماہانہ یا سالانہ منصوبہ منتخب کریں، یا کریڈٹ پیک شامل کریں۔ مقامی ماڈل کریڈٹ خرچ نہیں کرتے ہیں۔"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trieu un pla mensual o anual, o afegiu un paquet de crèdits. Els models locals no gasten crèdits."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn gói hàng tháng hoặc hàng năm hoặc thêm gói tín dụng. Người mẫu địa phương không chi tín dụng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a monthly or yearly plan, or add a credit pack. Local models do not spend credits."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en månedlig eller årlig plan, eller legg til en kredittpakke. Lokale modeller bruker ikke kreditter."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si mesačný alebo ročný plán alebo pridajte balík kreditov. Miestne modely nemíňajú kredity."
