          "stringUnit": {
            "state": "translated",
            "value": "將餐點、鍛鍊與提醒集於一處。"
          }
        }
      }
    },
    "Four short questions, about a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أربعة أسئلة قصيرة، تستغرق دقيقة تقريبًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Четири кратки въпроса, около минута."
