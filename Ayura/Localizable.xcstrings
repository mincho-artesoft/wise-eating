    "Over the past week or two, your sleep has felt?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الأسبوع أو الأسبوعين الماضيين، كيف بدا نومك؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През последните една-две седмици сънят ти беше?"
