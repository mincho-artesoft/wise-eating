    "Apple Intelligence is turned off. Enable it in Settings to use AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزة Apple Intelligence متوقفة. فعّلها في الإعدادات لاستخدام AI."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence е изключен. Включи го в Настройки, за да използваш AI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ আছে। AI ব্যবহার করতে সেটিংসে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence està desactivat. Activa'l a Configuració per fer servir l'AI."
