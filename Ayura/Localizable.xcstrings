    "Add an optional traditional profile to personalize this explanation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملفًا تقليديًا اختياريًا لتخصيص هذا الشرح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави незадължителен традиционен профил, за да персонализираш това обяснение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যাখ্যাটি ব্যক্তিগতকৃত করতে একটি ঐচ্ছিক প্রথাগত প্রোফাইল যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un perfil tradicional opcional per personalitzar aquesta explicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte volitelný tradiční profil pro přizpůsobení tohoto vysvětlení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en valgfri traditionel profil for at tilpasse denne forklaring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge optional ein traditionelles Profil hinzu, um diese Erklärung zu personalisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε ένα προαιρετικό παραδοσιακό προφίλ για να εξατομικεύσεις αυτή την εξήγηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un perfil tradicional opcional para personalizar esta explicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un perfil tradicional opcional para personalizar esta explicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää valinnainen perinteinen profiili mukauttaaksesi tätä selitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un profil traditionnel facultatif pour personnaliser cette explication."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un profil traditionnel facultatif pour personnaliser cette explication."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સમજૂતીને વ્યક્તિગત બનાવવા માટે વૈકલ્પિક પરંપરાગત પ્રોફાઇલ ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף פרופיל מסורתי אופציונלי כדי להתאים אישית הסבר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस व्याख्या को व्यक्तिगत बनाने के लिए एक वैकल्पिक पारंपरिक प्रोफ़ाइल जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj neobavezni tradicionalni profil za personalizaciju ovog objašnjenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy opcionális hagyományos profilt a magyarázat személyre szabásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan profil tradisional opsional untuk mempersonalisasi penjelasan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un profilo tradizionale opzionale per personalizzare questa spiegazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で伝統的プロフィールを追加すると、この解説をパーソナライズできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл түсіндірмені жекелендіру үшін қалауыңызша дәстүрлі профиль қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವಿವರಣೆಯನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಐಚ್ಛಿಕ ಸಾಂಪ್ರದಾಯಿಕ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전통 프로필(선택 사항)을 추가하여 이 설명을 맞춤 설정하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വിശദീകരണം വ്യക്തിഗതമാക്കാൻ വേണമെങ്കിൽ ഒരു പരമ്പരാഗത പ്രൊഫൈൽ ചേർക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे स्पष्टीकरण वैयक्तिकृत करण्यासाठी ऐच्छिक पारंपरिक प्रोफाइल जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah profil tradisional (pilihan) untuk memperibadikan penjelasan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en valgfri tradisjonell profil for å tilpasse denne forklaringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een optioneel traditioneel profiel toe om deze uitleg te personaliseren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ବ୍ୟାଖ୍ୟାକୁ ବ୍ୟକ୍ତିଗତ କରିବାକୁ ଏକ ଇଚ୍ଛାଧୀନ ପାରମ୍ପରିକ ପ୍ରୋଫାଇଲ୍ ଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਿਆਖਿਆ ਨੂੰ ਵਿਅਕਤੀਗਤ ਬਣਾਉਣ ਲਈ ਇੱਕ ਵਿਕਲਪਿਕ ਪਰੰਪਰਾਗਤ ਪ੍ਰੋਫਾਈਲ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj opcjonalny profil tradycyjny, aby spersonalizować to wyjaśnienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um perfil tradicional opcional para personalizar esta explicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um perfil tradicional opcional para personalizar esta explicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un profil tradițional opțional pentru a personaliza această explicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При желании добавьте традиционный профиль, чтобы персонализировать это пояснение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte voliteľný tradičný profil na prispôsobenie tohto vysvetlenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po želji dodajte tradicionalni profil, da prilagodite to pojasnilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en valfri traditionell profil för att anpassa den här förklaringen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விளக்கத்தைத் தனிப்பயனாக்க, விருப்பப்பட்டால் ஒரு மரபுச் சுயவிவரத்தைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వివరణను వ్యక్తిగతీకరించడానికి ఐచ్ఛిక సంప్రదాయ ప్రొఫైల్‌ను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโปรไฟล์แบบดั้งเดิม (ไม่บังคับ) เพื่อปรับคำอธิบายนี้ให้เหมาะกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu açıklamayı kişiselleştirmek için isteğe bağlı geleneksel bir profil ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте необов’язковий традиційний профіль, щоб персоналізувати це пояснення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وضاحت کو ذاتی نوعیت کا بنانے کے لیے ایک اختیاری روایتی پروفائل شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một hồ sơ truyền thống tùy chọn để cá nhân hóa phần giải thích này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加可选的传统档案，获取个性化的说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增選填的傳統體質檔案，以個人化此說明。"
          }
        }
      }
    },
