    "You haven't linked this exercise to any notes yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تربط هذا التمرين بأي ملاحظات بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още нямаш бележки, свързани с това упражнение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনো এই ব্যায়ামটি কোনো নোটের সাথে যুক্ত করেননি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no has vinculat aquest exercici a cap nota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto cvičení jste zatím nepropojili s žádnými poznámkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endnu ikke knyttet denne øvelse til nogen noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Übung noch nicht mit Notizen verknüpft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις συνδέσει ακόμη αυτή την άσκηση με καμία σημείωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no has vinculado este ejercicio a ninguna nota."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has vinculado este ejercicio a ninguna nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä linkittänyt tätä harjoitusta mihinkään muistiinpanoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as encore lié cet exercice à aucune note."
          }
        },
        "fr-CA": {
          "stringUnit": {
