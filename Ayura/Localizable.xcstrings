    "Food, yoga and guided practices chosen for your constitution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طعام ويوغا وممارسات موجّهة مختارة لبنيتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Храна, йога и водени практики, подбрани за твоята конституция."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রকৃতি অনুযায়ী নির্বাচিত খাবার, যোগব্যায়াম ও নির্দেশিত অভ্যাস।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliments, ioga i pràctiques guiades triats per a la teva constitució."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strava, jóga a řízené praxe vybrané pro vaši konstituci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mad, yoga og guidede øvelser udvalgt til din konstitution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ernährung, Yoga und geführte Übungen, abgestimmt auf deine Konstitution."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τροφές, γιόγκα και καθοδηγούμενες πρακτικές επιλεγμένες για την ιδιοσυστασία σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentos, yoga y prácticas guiadas elegidos para tu constitución."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentos, yoga y prácticas guiadas elegidos para tu constitución."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehotyypillesi valitut ruoat, jooga ja ohjatut harjoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentation, yoga et pratiques guidées adaptés à ta constitution."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentation, yoga et pratiques guidées choisis pour votre constitution."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પ્રકૃતિ મુજબ પસંદ કરેલ ખોરાક, યોગ અને માર્ગદર્શિત અભ્યાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזון, יוגה ותרגולים מודרכים שנבחרו לפי המבנה המולד שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रकृति के लिए चुने गए भोजन, योग और निर्देशित अभ्यास।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrana, joga i vođene prakse odabrane za tvoju konstituciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkatodhoz igazított ételek, jóga és vezetett gyakorlatok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makanan, yoga, dan latihan terpandu yang dipilih sesuai konstitusi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenti, yoga e pratiche guidate scelti per la tua costituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの体質に合わせた食品、ヨガ、ガイド付き実践。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дене бітіміңізге сай таңдалған тағам, йога және жетектелетін тәжірибелер."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರಕೃತಿಗೆ ತಕ್ಕಂತೆ ಆಯ್ಕೆಮಾಡಿದ ಆಹಾರ, ಯೋಗ ಮತ್ತು ಮಾರ್ಗದರ್ಶಿತ ಅಭ್ಯಾಸಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체질에 맞춘 식품, 요가, 가이드 수련."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രകൃതിക്ക് അനുയോജ്യമായി തിരഞ്ഞെടുത്ത ഭക്ഷണം, യോഗ, മാർഗനിർദേശത്തോടെയുള്ള പരിശീലനങ്ങൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या प्रकृतीनुसार निवडलेले अन्नपदार्थ, योग आणि मार्गदर्शित सराव."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makanan, yoga dan latihan berpandu yang dipilih untuk konstitusi anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mat, yoga og veiledede øvelser valgt for konstitusjonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeding, yoga en begeleide oefeningen, afgestemd op je constitutie."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ରକୃତି ପାଇଁ ବଛାଯାଇଥିବା ଖାଦ୍ୟ, ଯୋଗ ଏବଂ ମାର୍ଗଦର୍ଶିତ ଅଭ୍ୟାସ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
