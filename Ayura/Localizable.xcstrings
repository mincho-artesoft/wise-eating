        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш списъка „%@“? Това действие не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিত যে '%@' তালিকাটি মুছে ফেলতে চান? এই কাজটি আর ফিরিয়ে আনা যাবে না।"
