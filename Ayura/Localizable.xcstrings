    "Optionally update how sleep, digestion, appetite, energy and skin have felt over the past week or two.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك اختياريًا تحديث كيف كان حال النوم والهضم والشهية والطاقة والبشرة خلال الأسبوع أو الأسبوعين الماضيين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По желание актуализирай как са били сънят, храносмилането, апетитът, енергията и кожата ти през последните една-две седмици."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাইলে গত এক-দুই সপ্তাহে আপনার ঘুম, হজম, ক্ষুধা, শক্তি ও ত্বক কেমন ছিল তা আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalment, actualitza com han estat el son, la digestió, la gana, l'energia i la pell durant les últimes una o dues setmanes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelně aktualizujte, jak jste za poslední týden nebo dva vnímali svůj spánek, trávení, chuť k jídlu, energii a pokožku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater eventuelt, hvordan søvn, fordøjelse, appetit, energi og hud har føltes de seneste par uger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere optional, wie sich Schlaf, Verdauung, Appetit, Energie und Haut in den letzten ein bis zwei Wochen angefühlt haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωσε προαιρετικά πώς ήταν ο ύπνος, η πέψη, η όρεξη, η ενέργεια και το δέρμα σου τις τελευταίες μία με δύο εβδομάδες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza de forma opcional cómo han estado tu sueño, digestión, apetito, energía y piel en la última semana o dos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza de forma opcional cómo has sentido tu sueño, digestión, apetito, energía y piel en la última semana o dos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä halutessasi, millaisilta uni, ruoansulatus, ruokahalu, energia ja iho ovat tuntuneet viimeisen viikon tai kahden aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets à jour, si tu le souhaites, ton ressenti sur le sommeil, la digestion, l'appétit, l'énergie et la peau depuis une ou deux semaines."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous le souhaitez, mettez à jour l'état de votre sommeil, de votre digestion, de votre appétit, de votre énergie et de votre peau depuis une ou deux semaines."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા એક-બે અઠવાડિયામાં ઊંઘ, પાચન, ભૂખ, ઊર્જા અને ત્વચા કેવી રહી છે તે વૈકલ્પિક રીતે અપડેટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לעדכן איך היו השינה, העיכול, התיאבון, האנרגיה והעור בשבוע או בשבועיים האחרונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाहें तो यह अपडेट करें कि पिछले एक-दो सप्ताह में आपकी नींद, पाचन, भूख, ऊर्जा और त्वचा कैसी रही है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Po želji ažuriraj kakvi su u proteklih tjedan ili dva bili san, probava, apetit, energija i koža."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szeretnéd, frissítheted, hogyan alakult az alvásod, az emésztésed, az étvágyad, az energiád és a bőröd állapota az elmúlt egy-két hétben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara opsional, perbarui bagaimana tidur, pencernaan, nafsu makan, energi, dan kulit Anda terasa selama satu atau dua minggu terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuoi, aggiorna come sono stati sonno, digestione, appetito, energia e pelle nell'ultima settimana o due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここ1〜2週間の睡眠、消化、食欲、エネルギー、肌の状態を任意で更新できます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қаласаңыз, соңғы бір-екі аптада ұйқыңыз, ас қорытуыңыз, тәбетіңіз, энергияңыз және теріңіз қандай болғанын жаңартыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಒಂದು ಅಥವಾ ಎರಡು ವಾರಗಳಿಂದ ನಿಮ್ಮ ನಿದ್ರೆ, ಜೀರ್ಣಕ್ರಿಯೆ, ಹಸಿವು, ಶಕ್ತಿ ಮತ್ತು ಚರ್ಮವು ಹೇಗೆ ಅನಿಸಿದೆ ಎಂಬುದನ್ನು ಐಚ್ಛಿಕವಾಗಿ ನವೀಕರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하시면 최근 1~2주 동안 수면, 소화, 식욕, 에너지 및 피부 상태가 어떠했는지 업데이트해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ ഒന്നോ രണ്ടോ ആഴ്ചയായി ഉറക്കം, ദഹനം, വിശപ്പ്, ഊർജം, ചർമ്മം എന്നിവ എങ്ങനെയായിരുന്നു എന്ന് നിങ്ങൾക്ക് വേണമെങ്കിൽ അപ്ഡേറ്റ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हवे असल्यास, गेल्या एक-दोन आठवड्यांत झोप, पचन, भूक, ऊर्जा आणि त्वचा कशी राहिली आहे ते अद्ययावत करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika mahu, kemas kini bagaimana tidur, penghadaman, selera makan, tenaga dan kulit terasa sepanjang satu atau dua minggu lalu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater eventuelt hvordan søvn, fordøyelse, appetitt, energi og hud har føltes de siste én til to ukene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk eventueel bij hoe je slaap, spijsvertering, eetlust, energie en huid de afgelopen week of twee waren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତ ଏକ ବା ଦୁଇ ସପ୍ତାହରେ ନିଦ, ପାଚନ, ଭୋକ, ଶକ୍ତି ଏବଂ ଚର୍ମ କିପରି ଅନୁଭୂତ ହୋଇଛି ତାହା ଇଚ୍ଛାଧୀନ ଭାବେ ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਚਾਹੋ ਤਾਂ ਅੱਪਡੇਟ ਕਰ ਸਕਦੇ ਹੋ ਕਿ ਪਿਛਲੇ ਇੱਕ-ਦੋ ਹਫ਼ਤਿਆਂ ਵਿੱਚ ਨੀਂਦ, ਪਾਚਨ, ਭੁੱਖ, ਊਰਜਾ ਅਤੇ ਚਮੜੀ ਕਿਵੇਂ ਰਹੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie zaktualizuj informacje o tym, jak w ciągu ostatniego tygodnia lub dwóch wyglądały Twój sen, trawienie, apetyt, energia i skóra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalmente, atualize como estiveram o sono, a digestão, o apetite, a energia e a pele na última semana ou duas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quiseres, atualiza como têm estado o sono, a digestão, o apetite, a energia e a pele na última semana ou duas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează opțional cum au fost somnul, digestia, apetitul, energia și pielea în ultimele una-două săptămâni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При желании обновите данные о сне, пищеварении, аппетите, энергии и состоянии кожи за последние неделю-две."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľne aktualizujte, ako ste za posledný týždeň alebo dva vnímali spánok, trávenie, chuť do jedla, energiu a pokožku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po želji posodobite, kakšni so bili vaš spanec, prebava, tek, energija in koža v zadnjem tednu ali dveh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill kan du uppdatera hur sömn, matsmältning, aptit, energi och hud har känts under de senaste en till två veckorna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த ஒரு வாரம் அல்லது இரண்டு வாரங்களில் உங்கள் தூக்கம், செரிமானம், பசி, ஆற்றல் மற்றும் தோல் ஆகியவை எப்படி இருந்தன என்பதை விருப்பப்பட்டால் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత ఒకటి రెండు వారాలుగా మీ నిద్ర, జీర్ణక్రియ, ఆకలి, శక్తి మరియు చర్మం ఎలా అనిపించాయో కావాలంటే అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตเพิ่มเติมได้ว่าการนอนหลับ การย่อยอาหาร ความอยากอาหาร พลังงาน และผิวของคุณเป็นอย่างไรในช่วงสัปดาห์หรือสองสัปดาห์ที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir iki haftada uyku, sindirim, iştah, enerji ve cilt durumunuzun nasıl olduğunu isteğe bağlı olarak güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За бажанням оновіть дані про те, якими були ваш сон, травлення, апетит, енергія та шкіра протягом останніх тижня-двох."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری طور پر اپ ڈیٹ کریں کہ گزشتہ ایک دو ہفتوں میں نیند، ہاضمہ، بھوک، توانائی اور جلد کی کیفیت کیسی رہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể cập nhật tình trạng giấc ngủ, tiêu hóa, cảm giác thèm ăn, năng lượng và làn da trong một hoặc hai tuần qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选择更新过去一两周内睡眠、消化、食欲、精力和皮肤的感受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選擇更新過去一兩週的睡眠、消化、食慾、精力與皮膚感受。"
          }
        }
      }
    },
