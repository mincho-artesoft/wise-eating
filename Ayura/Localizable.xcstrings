        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas zakończenia każdego posiłku musi być późniejszy niż czas jego rozpoczęcia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada refeição deve ter uma hora de término posterior à hora de início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada refeição deve ter uma hora de fim posterior à hora de início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare masă trebuie să aibă ora de sfârșit după ora de început."
