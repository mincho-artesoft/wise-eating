        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে %@-এর জন্য ওয়ার্কআউট যোগ হবে। কোনো নির্দিষ্ট সময়ের জন্য ওয়ার্কআউট কীভাবে পরিচালনা করা হবে?"
