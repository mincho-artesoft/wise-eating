            "value": "स्थिर पण सहज पुढे ढकलता येणारी"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabil tetapi mudah ditangguhkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabil, men lett å utsette"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijkmatig maar makkelijk uit te stellen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ଥିର କିନ୍ତୁ ଟାଳିବା ସହଜ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਿਰ ਪਰ ਟਾਲਣ ਵਿੱਚ ਆਸਾਨ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stały, lecz łatwo odłożyć posiłek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Constante, mas fácil de adiar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estável, mas fácil de adiar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Constant, dar ușor de amânat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровным, но еду легко отложить"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnaná, no ľahko ju odsunúť"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalen, a ga je lahko odložiti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämn men lätt att skjuta upp"
