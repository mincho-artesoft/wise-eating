    "No batches found. Add a new one to get started.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على دفعات. أضف دفعة جديدة للبدء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма намерени партиди. Добави нова, за да започнеш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ব্যাচ পাওয়া যায়নি। শুরু করতে নতুন একটি যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat cap lot. Afegeix-ne un de nou per començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly nalezeny žádné šarže. Začněte přidáním nové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen partier fundet. Tilføj et nyt for at komme i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Chargen gefunden. Füge eine neue hinzu, um zu beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν παρτίδες. Πρόσθεσε μια νέα για να ξεκινήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron lotes. Añade uno nuevo para empezar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron lotes. Agrega uno nuevo para empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eriä ei löytynyt. Aloita lisäämällä uusi erä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lot trouvé. Ajoutes-en un nouveau pour commencer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lot trouvé. Ajoutez-en un nouveau pour commencer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ બૅચ મળ્યા નથી. શરૂ કરવા માટે નવો ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו אצוות. הוסף אצווה חדשה כדי להתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बैच नहीं मिला। शुरू करने के लिए एक नया बैच जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema pronađenih serija. Dodaj novu za početak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem találhatók tételek. Adj hozzá egy újat a kezdéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada stok. Tambahkan yang baru untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun lotto trovato. Aggiungine uno nuovo per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチが見つかりません。新しく追加して始めましょう。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Партиялар табылмады. Бастау үшін жаңасын қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಬ್ಯಾಚ್‌ಗಳು ಕಂಡುಬಂದಿಲ್ಲ. ಪ್ರಾರಂಭಿಸಲು ಹೊಸದನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관분이 없습니다. 새로 추가하여 시작하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാച്ചുകളൊന്നും കണ്ടെത്തിയില്ല. ആരംഭിക്കാൻ പുതിയൊരെണ്ണം ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही बॅच आढळल्या नाहीत. सुरुवात करण्यासाठी नवीन बॅच जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kumpulan ditemui. Tambah yang baharu untuk bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen partier funnet. Legg til et nytt for å komme i gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen batches gevonden. Voeg een nieuwe toe om te beginnen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ବ୍ୟାଚ୍ ମିଳିଲା ନାହିଁ। ଆରମ୍ଭ କରିବାକୁ ଏକ ନୂଆ ବ୍ୟାଚ୍ ଯୋଡ଼ନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਬੈਚ ਨਹੀਂ ਮਿਲਿਆ। ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਨਵਾਂ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak partii. Dodaj nową, aby zacząć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum lote encontrado. Adicione um novo para começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum lote encontrado. Adiciona um novo para começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit loturi. Adaugă unul nou pentru a începe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партии не найдены. Добавьте новую, чтобы начать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašli sa žiadne šarže. Začnite pridaním novej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni najdenih serij. Za začetek dodajte novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga partier hittades. Lägg till ett nytt för att komma igång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்புகள் எதுவும் இல்லை. தொடங்க புதிய ஒன்றைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాచ్‌లు ఏవీ కనుగొనబడలేదు. ప్రారంభించడానికి కొత్తదాన్ని జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบล็อต เพิ่มล็อตใหม่เพื่อเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti bulunamadı. Başlamak için yeni bir parti ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Партій не знайдено. Додайте нову, щоб почати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بیچ نہیں ملا۔ شروع کرنے کے لیے ایک نیا شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lô nào. Hãy thêm lô mới để bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到批次，请添加新批次以开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到任何批次。請新增一個批次以開始使用。"
          }
        }
      }
    },
