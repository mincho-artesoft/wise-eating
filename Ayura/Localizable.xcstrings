          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lisää treenit päivälle %@. Miten tietyn aikavälin treenit tulisi käsitellä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera les entraînements pour le %@. Comment gérer les entraînements d'un créneau horaire donné ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera les entraînements pour le %@. Comment gérer les entraînements d'une plage horaire précise?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી %@ માટે વર્કઆઉટ ઉમેરવામાં આવશે. ચોક્કસ સમય સ્લૉટ માટેના વર્કઆઉટ કેવી રીતે ગોઠવવા જોઈએ?"
