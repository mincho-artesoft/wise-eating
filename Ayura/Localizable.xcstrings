        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿੱਜੀ ਅਨੁਕੂਲਤਾ ਦੇਖਣ ਲਈ %@ ਵਾਸਤੇ ਆਯੁਰਵੈਦਿਕ ਪ੍ਰੋਫਾਈਲ ਬਣਾਓ।"
          }
        },
        "pl": {
