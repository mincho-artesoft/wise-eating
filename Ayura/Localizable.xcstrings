        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür Boyu satın almak aboneliğinizi iptal etmez. Gelecekteki yenileme ücretlerinden kaçınmak için aboneliğinizi yönetin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupem Lifetime se nezruší vaše předplatné. Spravujte své předplatné, abyste se vyhnuli budoucím poplatkům za obnovení."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar Lifetime não cancela a sua subscrição. Faça a gestão da sua subscrição para evitar futuras cobranças de renovação."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Купівля Lifetime не скасовує вашу підписку. Керуйте своєю підпискою, щоб уникнути плати за оновлення в майбутньому."
