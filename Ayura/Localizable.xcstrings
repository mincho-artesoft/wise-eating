    "Double tap to cycle through pacifies, neutral, aggravates, and off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين للتنقل بين يهدئ، ومحايد، ويهيّج، وإيقاف"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни двукратно за превключване между успокоява, неутрално, влошава и изключено"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশমন, নিরপেক্ষ, প্রকোপ ও বন্ধ—এগুলোর মধ্যে পালাক্রমে বদলাতে দুবার ট্যাপ করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dues vegades per canviar entre pacifica, neutre, agreuja i desactivat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím přepínáte mezi zklidňuje, neutrální, zhoršuje a vypnuto"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk to gange for at skifte mellem beroliger, neutral, forværrer og fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um zwischen beruhigend, neutral, verstärkend und aus zu wechseln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε δύο φορές για εναλλαγή μεταξύ κατευνάζει, ουδέτερο, επιβαρύνει και ανενεργό"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para alternar entre pacifica, neutro, agrava y desactivado"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para alternar entre pacifica, neutro, agrava y desactivado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksoisnapauta vaihtaaksesi tilojen rauhoittaa, neutraali, pahentaa ja pois välillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie deux fois pour faire défiler : apaise, neutre, aggrave et désactivé"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour alterner entre apaise, neutre, aggrave et désactivé"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શમન કરે, તટસ્થ, વૃદ્ધિ કરે અને બંધ વચ્ચે બદલવા માટે બે વાર ટૅપ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש פעמיים כדי לעבור בין מרגיע, ניטרלי, מחמיר וכבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत करता है, तटस्थ, कुपित करता है और बंद के बीच बदलने के लिए दो बार टैप करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni dvaput za prebacivanje između: smiruje, neutralno, pogoršava i isključeno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints duplán a csillapító, semleges, fokozó és kikapcsolt állapotok közötti váltáshoz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk berganti antara menenangkan, netral, memperburuk, dan nonaktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per alternare tra pacifica, neutro, aggrava e disattivato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで「鎮静」「中立」「悪化」「オフ」を切り替え"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тыныштандырады, бейтарап, күшейтеді және өшірулі күйлерін ауыстыру үшін екі рет түртіңіз"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶಮನಗೊಳಿಸುತ್ತದೆ, ತಟಸ್ಥ, ಪ್ರಕೋಪಗೊಳಿಸುತ್ತದೆ ಮತ್ತು ಆಫ್ ನಡುವೆ ಬದಲಾಯಿಸಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진정, 중립, 악화, 끄기 순으로 전환하려면 두 번 탭하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശമിപ്പിക്കുന്നു, നിഷ്പക്ഷം, കോപിപ്പിക്കുന്നു, ഓഫ് എന്നിവയിലൂടെ മാറാൻ ഇരട്ട ടാപ്പ് ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शमन करते, तटस्थ, वाढवते आणि बंद या स्थितींमध्ये बदलण्यासाठी दोनदा टॅप करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik dua kali untuk menukar antara menenangkan, neutral, memburukkan dan tidak aktif"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å veksle mellom demper, nøytral, forverrer og av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik dubbel om te wisselen tussen kalmeert, neutraal, verergert en uit"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଶାନ୍ତ କରେ, ନିରପେକ୍ଷ, ପ୍ରକୋପିତ କରେ ଏବଂ ବନ୍ଦ ମଧ୍ୟରେ କ୍ରମରେ ବଦଳାଇବାକୁ ଦୁଇଥର ଟ୍ୟାପ୍ କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ਾਂਤ ਕਰਦਾ ਹੈ, ਨਿਰਪੱਖ, ਵਧਾਉਂਦਾ ਹੈ, ਅਤੇ ਬੰਦ ਵਿਚਕਾਰ ਬਦਲਣ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie, aby przełączać: uspokaja, neutralny, nasila i wyłączone"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para alternar entre pacifica, neutro, agrava e desativado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca duas vezes para alternar entre pacifica, neutro, agrava e desativado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge de două ori pentru a parcurge opțiunile: calmează, neutru, agravează și dezactivat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите дважды для переключения: успокаивает, нейтрально, обостряет и выключено"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím prepínate medzi upokojuje, neutrálne, zhoršuje a vypnuté"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvakrat tapnite za preklop med pomirja, nevtralno, poslabša in izklopljeno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck snabbt två gånger för att växla mellan lugnar, neutral, förvärrar och av"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமநிலைப்படுத்துகிறது, நடுநிலை, அதிகரிக்கிறது மற்றும் நிறுத்தம் ஆகியவற்றிற்கு மாற இருமுறை தட்டுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతింపజేసే, తటస్థం, ప్రకోపింపజేసే మరియు ఆఫ్ మధ్య మారడానికి రెండుసార్లు నొక్కండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อวนสลับระหว่าง ทำให้สงบ เป็นกลาง กระตุ้น และปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
