    "Meals, workouts and reminders in one place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوجبات والتدريبات والتذكيرات في مكان واحد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранения, тренировки и напомняния на едно място."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খাবার, ওয়ার্কআউট এবং রিমাইন্ডার এক জায়গায়।"
          }
