          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівний, але їжу легко відкласти"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مستقل مگر آسانی سے ٹلنے والی"
          }
        },
        "vi": {
          "stringUnit": {
