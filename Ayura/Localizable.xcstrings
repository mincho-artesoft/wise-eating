    "AI recipe generation requires iOS 26 or newer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب توليد الوصفة عبر AI نظام iOS 26 أو أحدث."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерирането на рецепта с AI изисква iOS 26 или по-нова версия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI রেসিপি জেনারেশনের জন্য iOS 26 বা তার পরবর্তী সংস্করণ প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La generació de receptes amb AI requereix iOS 26 o posterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Generování receptů pomocí AI vyžaduje iOS 26 nebo novější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-opskriftsgenerering kræver iOS 26 eller nyere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die AI-Rezeptgenerierung erfordert iOS 26 oder neuer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δημιουργία συνταγής με AI απαιτεί iOS 26 ή νεότερο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
