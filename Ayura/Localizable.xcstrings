    "Calendar access is required to manage profile data and settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب الوصول إلى التقويم لإدارة بيانات الملف الشخصي وإعداداته."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходим е достъп до Календара за управление на данните и настройките на профила."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোফাইলের ডেটা এবং সেটিংস পরিচালনা করতে ক্যালেন্ডার ব্যবহারের অনুমতি প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal accés al calendari per gestionar les dades i la configuració del perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro správu údajů profilu a nastavení je vyžadován přístup ke kalendáři."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderadgang er påkrævet for at administrere profildata og indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Verwaltung von Profildaten und Einstellungen ist Kalenderzugriff erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται πρόσβαση στο Ημερολόγιο για τη διαχείριση των δεδομένων και των ρυθμίσεων προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso al calendario para gestionar los datos y ajustes del perfil."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso al calendario para gestionar los datos y la configuración del perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterin käyttöoikeus vaaditaan profiilitietojen ja asetusten hallintaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au calendrier est requis pour gérer les données et réglages du profil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au calendrier est requis pour gérer les données et les réglages du profil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રોફાઇલ ડેટા અને સેટિંગ્સનું સંચાલન કરવા માટે કૅલેન્ડર ઍક્સેસ જરૂરી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה ליומן כדי לנהל את נתוני הפרופיל וההגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल डेटा और सेटिंग्ज़ प्रबंधित करने के लिए कैलेंडर एक्सेस आवश्यक है।"
