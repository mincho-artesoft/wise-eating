    "Your answers are distributed evenly across the three traditional profiles.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجاباتك موزعة بالتساوي على الملفات التقليدية الثلاثة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорите ти са разпределени равномерно между трите традиционни профила."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উত্তরগুলো তিনটি প্রথাগত প্রোফাইলে সমানভাবে বণ্টিত হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves respostes es distribueixen de manera uniforme entre els tres perfils tradicionals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše odpovědi jsou rovnoměrně rozloženy mezi všechny tři tradiční profily."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar er jævnt fordelt på de tre traditionelle profiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antworten verteilen sich gleichmäßig auf die drei traditionellen Profile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απαντήσεις σου κατανέμονται ομοιόμορφα στα τρία παραδοσιακά προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas se reparten por igual entre los tres perfiles tradicionales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas se distribuyen de manera uniforme entre los tres perfiles tradicionales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi jakautuvat tasaisesti kolmen perinteisen profiilin kesken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes réponses sont réparties de façon égale entre les trois profils traditionnels."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses sont réparties également entre les trois profils traditionnels."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા જવાબો ત્રણેય પરંપરાગત પ્રોફાઇલમાં સમાન રીતે વહેંચાયેલા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובות שלך מתחלקות באופן שווה בין שלושת הפרופילים המסורתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके उत्तर तीनों पारंपरिक प्रोफ़ाइलों में समान रूप से बँटे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji su odgovori ravnomjerno raspoređeni između triju tradicionalnih profila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszaid egyenletesen oszlanak el a három hagyományos profil között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban Anda tersebar merata di ketiga profil tradisional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte sono distribuite in modo uniforme tra i tre profili tradizionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は3つの伝統的プロフィールに均等に分布しています。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жауаптарыңыз үш дәстүрлі профиль бойынша біркелкі бөлінген."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಉತ್ತರಗಳು ಮೂರು ಸಾಂಪ್ರದಾಯಿಕ ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ಸಮಾನವಾಗಿ ಹಂಚಿಕೆಯಾಗಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 세 가지 전통 프로필에 고르게 분포되어 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഉത്തരങ്ങൾ മൂന്ന് പരമ്പരാഗത പ്രൊഫൈലുകളിലും തുല്യമായി വിതരണം ചെയ്തിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची उत्तरे तीनही पारंपरिक प्रोफाइल्समध्ये समान विभागली गेली आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan anda diagihkan secara sekata merentasi ketiga-tiga profil tradisional."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene dine er jevnt fordelt på de tre tradisjonelle profilene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoorden zijn gelijkmatig verdeeld over de drie traditionele profielen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଉତ୍ତରଗୁଡ଼ିକ ତିନୋଟି ପାରମ୍ପରିକ ପ୍ରୋଫାଇଲ୍ ମଧ୍ୟରେ ସମାନ ଭାବରେ ବଣ୍ଟିତ ହୋଇଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਜਵਾਬ ਤਿੰਨਾਂ ਪਰੰਪਰਾਗਤ ਪ੍ਰੋਫਾਈਲਾਂ ਵਿੱਚ ਬਰਾਬਰ ਵੰਡੇ ਹੋਏ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi rozkładają się równomiernie na trzy tradycyjne profile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas estão distribuídas uniformemente entre os três perfis tradicionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas respostas estão distribuídas de forma equilibrada pelos três perfis tradicionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile tale sunt distribuite uniform între cele trei profiluri tradiționale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши ответы равномерно распределены между тремя традиционными профилями."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše odpovede sú rovnomerne rozložené medzi tri tradičné profily."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši odgovori so enakomerno porazdeljeni med vse tri tradicionalne profile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina svar är jämnt fördelade över de tre traditionella profilerna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதில்கள் மூன்று மரபுச் சுயவிவரங்களிலும் சமமாகப் பகிரப்பட்டுள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సమాధానాలు మూడు సంప్రదాయ ప్రొఫైళ్లలో సమానంగా పంపిణీ చేయబడ్డాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของคุณกระจายตัวเท่ากันทั้งสามโปรไฟล์แบบดั้งเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlarınız üç geleneksel profile eşit dağılmış durumda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші відповіді рівномірно розподілені між трьома традиційними профілями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جوابات تینوں روایتی پروفائلز میں یکساں طور پر تقسیم ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các câu trả lời của bạn phân bố đều giữa ba hồ sơ truyền thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答均匀分布在三种传统档案中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答平均分布於三種傳統體質。"
          }
        }
      }
    },
    "The leading profiles are within one answer, so the questionnaire does not separate them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفارق بين الملفات المتصدرة هو إجابة واحدة فقط، لذا لا يفصل الاستبيان بينها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Водещите профили са с разлика до един отговор, затова въпросникът не ги разграничава."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীর্ষ প্রোফাইলগুলোর মধ্যে পার্থক্য মাত্র এক উত্তরের, তাই প্রশ্নাবলি এগুলোকে আলাদা করতে পারেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els perfils principals estan a una resposta de diferència, així que el qüestionari no els separa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedoucí profily se liší nejvýše o jednu odpověď, takže je dotazník nerozlišuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De førende profiler ligger højst ét svar fra hinanden, så spørgeskemaet adskiller dem ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die führenden Profile liegen höchstens eine Antwort auseinander, daher trennt der Fragebogen sie nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επικρατέστερα προφίλ απέχουν κατά μία απάντηση, οπότε το ερωτηματολόγιο δεν τα διαχωρίζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles principales difieren en una sola respuesta, por lo que el cuestionario no los separa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles principales están a una respuesta de distancia, por lo que el cuestionario no los separa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Johtavien profiilien ero on enintään yksi vastaus, joten kysely ei erota niitä toisistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils en tête n'ont qu'une réponse d'écart : le questionnaire ne les départage donc pas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils dominants ne diffèrent que d'une réponse; le questionnaire ne permet donc pas de les départager."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અગ્રણી પ્રોફાઇલ્સ વચ્ચે માત્ર એક જવાબનો તફાવત છે, તેથી પ્રશ્નાવલિ તેમને અલગ પાડતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופילים המובילים נמצאים בהפרש של תשובה אחת, כך שהשאלון אינו מפריד ביניהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमुख प्रोफ़ाइलों में केवल एक उत्तर का अंतर है, इसलिए प्रश्नावली उन्हें अलग नहीं करती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodeći se profili razlikuju za najviše jedan odgovor, pa ih upitnik ne razdvaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vezető profilok egy válaszon belül vannak, így a kérdőív nem választja szét őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil teratas hanya berselisih satu jawaban, sehingga kuesioner tidak memisahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili principali distano di una sola risposta, quindi il questionario non li separa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上位のプロフィールが1問差以内にあるため、このアンケートでは区別できません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдыңғы профильдердің айырмашылығы бір жауап шамасында, сондықтан сауалнама оларды ажыратпайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಮುಖ ಪ್ರೊಫೈಲ್‌ಗಳು ಒಂದು ಉತ್ತರದ ಅಂತರದಲ್ಲಿವೆ, ಆದ್ದರಿಂದ ಪ್ರಶ್ನಾವಳಿಯು ಅವುಗಳನ್ನು ಪ್ರತ್ಯೇಕಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상위 프로필 간 차이가 한 문항 이내이므로 설문으로 구분되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുന്നിലുള്ള പ്രൊഫൈലുകൾ തമ്മിൽ ഒരു ഉത്തരത്തിന്റെ വ്യത്യാസം മാത്രമേയുള്ളൂ, അതിനാൽ ചോദ്യാവലി അവയെ വേർതിരിക്കുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अग्रणी प्रोफाइल्समध्ये फक्त एका उत्तराचा फरक आहे, त्यामुळे प्रश्नावली त्यांत वेगळेपणा दाखवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil yang mendahului hanya berbeza satu jawapan, jadi soal selidik tidak memisahkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De ledende profilene ligger høyst ett svar fra hverandre, så spørreskjemaet skiller dem ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoogst scorende profielen verschillen hoogstens één antwoord, dus de vragenlijst maakt geen onderscheid tussen beide."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅଗ୍ରଣୀ ପ୍ରୋଫାଇଲ୍‌ଗୁଡ଼ିକ ମଧ୍ୟରେ ମାତ୍ର ଗୋଟିଏ ଉତ୍ତରର ପାର୍ଥକ୍ୟ ଅଛି, ତେଣୁ ପ୍ରଶ୍ନାବଳୀ ସେଗୁଡ଼ିକୁ ପୃଥକ କରିପାରୁନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੱਖ ਪ੍ਰੋਫਾਈਲਾਂ ਵਿੱਚ ਸਿਰਫ਼ ਇੱਕ ਜਵਾਬ ਦਾ ਫ਼ਰਕ ਹੈ, ਇਸ ਲਈ ਪ੍ਰਸ਼ਨਾਵਲੀ ਇਹਨਾਂ ਨੂੰ ਵੱਖ ਨਹੀਂ ਕਰਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czołowe profile różni najwyżej jedna odpowiedź, więc kwestionariusz ich nie rozdziela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis principais têm diferença de até uma resposta, portanto o questionário não os separa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis principais diferem apenas numa resposta, pelo que o questionário não os separa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilurile principale sunt la diferență de un răspuns, astfel încât chestionarul nu le separă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведущие профили отличаются не более чем на один ответ, поэтому анкета не разделяет их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedúce profily sa líšia len o jednu odpoveď, preto ich dotazník nerozdeľuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodilna profila se razlikujeta za največ en odgovor, zato ju vprašalnik ne loči."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De ledande profilerna ligger inom ett svar från varandra, så formuläret skiljer dem inte åt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்னணியில் உள்ள சுயவிவரங்கள் ஒரு பதில் இடைவெளியில் இருப்பதால், கேள்வித்தாள் அவற்றைத் தனித்தனியாகப் பிரிக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రధాన ప్రొఫైళ్లు ఒక సమాధానం తేడాలో ఉన్నాయి, కాబట్టి ప్రశ్నావళి వాటిని వేరు చేయదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ที่นำอยู่ต่างกันไม่เกินหนึ่งคำตอบ แบบสอบถามจึงยังไม่แยกออกจากกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önde gelen profiller arasında yalnızca bir yanıt farkı var; bu nedenle anket bunları birbirinden ayırmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провідні профілі різняться лише на одну відповідь, тому опитувальник не розділяє їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایاں پروفائلز میں صرف ایک جواب کا فرق ہے، اس لیے سوالنامہ انہیں الگ نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hồ sơ dẫn đầu chỉ chênh nhau một câu trả lời, nên bảng câu hỏi không tách biệt chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "领先的档案之间仅相差一题，因此问卷无法将它们区分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "領先的體質僅差一題，因此問卷無法進一步區分。"
          }
        }
      }
    },
