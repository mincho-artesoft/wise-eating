        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사, 워크아웃, 리마인더를 한곳에서."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭക്ഷണവേളകൾ, വർക്കൗട്ടുകൾ, ഓർമ്മപ്പെടുത്തലുകൾ എന്നിവയെല്ലാം ഒരിടത്ത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेवण, वर्कआउट्स आणि स्मरणपत्रे एकाच ठिकाणी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidangan, senaman dan peringatan di satu tempat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måltider, treningsøkter og påminnelser på ett sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaltijden, workouts en herinneringen op één plek."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭୋଜନ, ୱାର୍କଆଉଟ୍ ଏବଂ ରିମାଇଣ୍ଡର୍ ଗୋଟିଏ ସ୍ଥାନରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੋਜਨ, ਵਰਕਆਊਟ ਅਤੇ ਰੀਮਾਈਂਡਰ ਇੱਕੋ ਥਾਂ 'ਤੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiłki, treningi i przypomnienia w jednym miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeições, treinos e lembretes em um só lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeições, treinos e lembretes num só lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mese, antrenamente și mementouri într-un singur loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приёмы пищи, тренировки и напоминания в одном месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedlá, tréningy a pripomienky na jednom mieste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroki, vadbe in opomniki na enem mestu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måltider, träningspass och påminnelser på ett ställe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவுகள், பயிற்சி அமர்வுகள் மற்றும் நினைவூட்டல்கள் ஒரே இடத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భోజనాలు, వర్కవుట్‌లు మరియు రిమైండర్‌లు ఒకే చోట."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มื้ออาหาร การออกกำลังกาย และการเตือนความจำรวมไว้ในที่เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğünler, antrenmanlar ve hatırlatıcılar tek bir yerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прийоми їжі, тренування й нагадування в одному місці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھانے، ورزشیں اور یاد دہانیاں ایک جگہ۔"
