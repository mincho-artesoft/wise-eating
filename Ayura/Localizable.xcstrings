    "Are you sure you want to delete '%@' from the meal? This will not affect your stored items.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في حذف «%@» من الوجبة؟ لن يؤثر هذا على عناصرك المخزنة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш „%@“ от храненето? Това няма да засегне съхранените ти храни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি সত্যিই এই বেলার খাবার থেকে ‘%@’ মুছে ফেলতে চান? এটি আপনার সংরক্ষিত আইটেমগুলোতে কোনো প্রভাব ফেলবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar «%@» de l'àpat? Això no afectarà els teus aliments desats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat „%@“ z jídla? Vaše uložené položky to neovlivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette '%@' fra måltidet? Dette påvirker ikke dine gemte fødevarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du „%@“ wirklich aus der Mahlzeit entfernen? Deine gespeicherten Lebensmittel bleiben davon unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις το «%@» από το γεύμα; Αυτό δεν θα επηρεάσει τα αποθηκευμένα στοιχεία σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@» de la comida? Esto no afectará a tus alimentos guardados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar “%@” de la comida? Esto no afectará tus alimentos guardados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa kohteen ”%@” ateriasta? Tämä ei vaikuta varastoituihin tuotteisiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer « %@ » du repas ? Cela n'affectera pas tes aliments enregistrés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » du repas? Cela n'affectera pas vos aliments enregistrés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર ભોજનમાંથી '%@' કાઢી નાખવા માંગો છો? આનાથી તમારી સંગ્રહિત વસ્તુઓ પર અસર થશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
