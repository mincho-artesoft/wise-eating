        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल डाउनलोड या तैयार हो रहा है। कृपया थोड़ी देर बाद फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se preuzima ili priprema. Pokušaj ponovno uskoro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell letöltése vagy előkészítése folyamatban van. Próbáld meg újra hamarosan."
