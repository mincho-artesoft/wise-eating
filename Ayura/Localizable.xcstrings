    "Everything in the app is free to use. A plan removes the ads and supports the work.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء في التطبيق متاح مجانًا. اختيار خطة يزيل الإعلانات ويدعم هذا العمل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко в приложението е безплатно за използване. Планът премахва рекламите и подкрепя работата по него."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের সবকিছুই বিনামূল্যে ব্যবহার করা যায়। প্ল্যান নিলে বিজ্ঞাপন সরে যায় এবং এই কাজে সহায়তা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots fer servir tota l'app gratuïtament. Un pla elimina els anuncis i dona suport a la feina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše v aplikaci je zdarma. Tarif odstraní reklamy a podpoří naši práci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i appen er gratis at bruge. En plan fjerner annoncerne og støtter arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in der App ist kostenlos nutzbar. Ein Tarif entfernt die Werbung und unterstützt die Weiterentwicklung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα στην εφαρμογή είναι δωρεάν. Ένα πρόγραμμα αφαιρεί τις διαφημίσεις και στηρίζει τη δουλειά μας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en la app se puede usar gratis. Un plan elimina los anuncios y apoya este trabajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en la app se puede usar gratis. Un plan quita los anuncios y apoya este trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki sovelluksessa on maksutonta. Tilaus poistaa mainokset ja tukee tätä työtä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout dans l'application est gratuit. Un forfait supprime les publicités et soutient ce travail."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est gratuit dans l'application. Un forfait supprime les publicités et soutient ce travail."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપમાં બધું જ વાપરવા માટે મફત છે. પ્લાનથી જાહેરાતો દૂર થાય છે અને આ કાર્યને સહાય મળે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שבאפליקציה זמין לשימוש בחינם. בחירה בתוכנית מסירה את המודעות ותומכת בהמשך הפיתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में सब कुछ मुफ़्त में उपयोग किया जा सकता है। प्लान लेने से विज्ञापन हट जाते हैं और इस कार्य को सहयोग मिलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve u aplikaciji možeš koristiti besplatno. Plan uklanja oglase i podržava ovaj rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazásban minden ingyenesen használható. Egy csomaggal eltűnnek a hirdetések, és támogatod a munkánkat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua fitur di aplikasi ini gratis digunakan. Paket langganan menghapus iklan dan mendukung pengembangannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto nell'app è gratuito. Un piano rimuove gli annunci e sostiene il progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの機能はすべて無料で利用できます。プランに登録すると広告が非表示になり、開発の支援になります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбадағы барлық мүмкіндікті тегін пайдалануға болады. Жоспар жарнаманы алып тастайды және жұмысымызды қолдайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನಲ್ಲಿರುವ ಎಲ್ಲವನ್ನೂ ಉಚಿತವಾಗಿ ಬಳಸಬಹುದು. ಯೋಜನೆಯು ಜಾಹೀರಾತುಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ ಮತ್ತು ಈ ಕೆಲಸವನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 모든 기능은 무료로 사용할 수 있습니다. 플랜을 이용하면 광고를 없애고 개발을 후원할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിലെ എല്ലാം സൗജന്യമായി ഉപയോഗിക്കാം. ഒരു പ്ലാൻ എടുക്കുന്നത് പരസ്യങ്ങൾ നീക്കം ചെയ്യുകയും ഈ പ്രവർത്തനത്തെ പിന്തുണയ്ക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲपमधील सर्व काही मोफत वापरता येते. प्लॅनमुळे जाहिराती बंद होतात आणि या कामाला पाठबळ मिळते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya dalam aplikasi ini percuma untuk digunakan. Pelan langganan membuang iklan dan menyokong usaha ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i appen er gratis å bruke. En plan fjerner annonsene og støtter arbeidet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in de app is gratis te gebruiken. Een abonnement verwijdert de advertenties en ondersteunt de ontwikkeling."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍‌ରେ ଥିବା ସବୁକିଛି ମାଗଣାରେ ବ୍ୟବହାର କରିହେବ। ଏକ ପ୍ଲାନ୍ ବିଜ୍ଞାପନ ହଟାଏ ଏବଂ ଏହି କାମକୁ ସମର୍ଥନ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਵਿੱਚ ਸਭ ਕੁਝ ਵਰਤਣ ਲਈ ਮੁਫ਼ਤ ਹੈ। ਪਲਾਨ ਲੈਣ ਨਾਲ ਵਿਗਿਆਪਨ ਹਟ ਜਾਂਦੇ ਹਨ ਅਤੇ ਇਸ ਕੰਮ ਨੂੰ ਸਹਿਯੋਗ ਮਿਲਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie funkcje aplikacji są bezpłatne. Plan usuwa reklamy i wspiera dalszą pracę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo no app é gratuito. Um plano remove os anúncios e apoia o trabalho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo na aplicação é gratuito. Um plano remove os anúncios e apoia este trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul din aplicație este gratuit. Un plan elimină reclamele și susține această muncă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в приложении доступно бесплатно. Подписка убирает рекламу и поддерживает нашу работу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko v aplikácii môžete používať zadarmo. Plán odstráni reklamy a podporí našu prácu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse v aplikaciji lahko uporabljate brezplačno. Paket odstrani oglase in podpre naše delo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt i appen är gratis att använda. En plan tar bort annonserna och stödjer arbetet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலியில் உள்ள அனைத்தையும் இலவசமாகப் பயன்படுத்தலாம். ஒரு திட்டம் விளம்பரங்களை நீக்கி, இந்தப் பணிக்கு ஆதரவளிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లోని ప్రతిదీ ఉచితంగా ఉపయోగించవచ్చు. ప్లాన్ తీసుకుంటే ప్రకటనలు తొలగిపోతాయి మరియు ఈ పనికి మద్దతు లభిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างในแอปใช้งานได้ฟรี แผนสมาชิกช่วยนำโฆษณาออกและสนับสนุนการพัฒนาแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki her şeyi ücretsiz kullanabilirsiniz. Bir planla reklamları kaldırır ve bu çalışmayı desteklersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе в програмі доступне безкоштовно. План прибирає рекламу й підтримує роботу над нею."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں سب کچھ مفت استعمال کیا جا سکتا ہے۔ پلان لینے سے اشتہارات ہٹ جاتے ہیں اور اس کام میں معاونت ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ trong ứng dụng đều miễn phí. Gói đăng ký giúp loại bỏ quảng cáo và ủng hộ việc phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内所有功能均可免费使用。选择方案可去除广告，并支持持续开发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內的所有功能皆可免費使用。訂閱方案可移除廣告，並支持開發工作。"
          }
        }
      }
    },
