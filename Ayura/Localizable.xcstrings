        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular: alto unos días, nulo otros"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular: intenso unos días, nulo otros"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Epäsäännöllinen — joinain päivinä suuri, toisina olematon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrégulier — grand certains jours, absent d'autres"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrégulier — grand certains jours, absent d'autres"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનિયમિત — ક્યારેક ખૂબ વધુ, ક્યારેક બિલકુલ નહીં"
