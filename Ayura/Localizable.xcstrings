    "Could not start AI recipe generation job.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء مهمة توليد الوصفة عبر AI."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неуспешно стартиране на задачата за AI генериране на рецепта."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI রেসিপি জেনারেশন কাজ শুরু করা যায়নি।"
          }
        },
        "ca": {
