                "stringUnit": {
                  "state": "translated",
                  "value": "Denne måltidsplanen har %lld tilknyttet meny.\n\n• «Slett bare planen» fjerner planen, men beholder menyen der den brukes.\n• «Slett plan og menyer» sletter både planen og den tilknyttede menyen.\n\nHva vil du gjøre?"
                }
              },
              "other": {
                "stringUnit": {
