        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡാറ്റ തയ്യാറാക്കാൻ ഞങ്ങൾക്ക് കഴിഞ്ഞില്ല"
