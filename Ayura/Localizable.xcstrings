    "Are you sure you want to delete '%@' from your storage? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد حذف «%@» من مخزنك؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш „%@“ от склада си? Това действие не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিত যে স্টোরেজ থেকে '%@' মুছে ফেলতে চান? এই কাজটি আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar «%@» del teu rebost? Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat položku „%@“ ze svých zásob? Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette '%@' fra dit lager? Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du „%@“ wirklich aus deinem Vorrat löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις το «%@» από την αποθήκη σου; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@» de tu almacén? Esta acción no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar '%@' de tu almacenamiento? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa kohteen '%@' varastostasi? Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer « %@ » de ton stock ? Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » de votre stock? Cette action est irréversible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર તમારા સંગ્રહમાંથી '%@' કાઢી નાખવા માંગો છો? આ ક્રિયા પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק את '%@' מהאחסון שלך? לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई '%@' को अपने भंडार से डिलीट करना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati '%@' iz spremišta? Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törlöd ezt a készletedből: „%@”? Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus '%@' dari penyimpanan Anda? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare '%@' dalla dispensa? Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "在庫から「%@」を削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» өнімін қоймаңыздан жойғыңыз келетініне сенімдісіз бе? Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ದಾಸ್ತಾನಿನಿಂದ '%@' ಅನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 '%@'을(를) 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്റ്റോറേജിൽ നിന്ന് '%@' ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഈ പ്രവൃത്തി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्ही तुमच्या साठ्यातून '%@' हटवू इच्छिता? ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadamkan '%@' daripada storan anda? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette «%@» fra lageret ditt? Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je '%@' uit je voorraad wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ କି ଯେ ଆପଣ ଆପଣଙ୍କ ଷ୍ଟୋରେଜ୍‌ରୁ '%@' କୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି? ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ '%@' ਨੂੰ ਆਪਣੀ ਸਟੋਰੇਜ ਵਿੱਚੋਂ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਲਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć „%@” z zapasów? Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar '%@' da sua despensa? Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar «%@» da tua despensa? Esta ação não pode ser anulada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur vrei să ștergi „%@” din stoc? Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить «%@» из запасов? Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať položku „%@“ zo zásob? Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati '%@' iz shrambe? Tega dejanja ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera ”%@” från ditt förråd? Denna åtgärd kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சேமிப்பகத்திலிருந்து '%@' என்பதை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా మీ నిల్వ నుండి '%@' ని తొలగించాలనుకుంటున్నారా? ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบ '%@' ออกจากคลังอาหารของคุณ? การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ürününü deponuzdan silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити «%@» зі своїх запасів? Цю дію неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی '%@' کو اپنے ذخیرے سے حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں لیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa '%@' khỏi kho của bạn không? Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要从你的库存中删除“%@”吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要從儲藏庫中刪除「%@」嗎？此動作無法復原。"
          }
