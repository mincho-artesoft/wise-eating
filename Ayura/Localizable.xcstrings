    "This exercise is used in %lld workouts or training plans.\nIf you delete it, it will be removed from those workouts and plans.\n\nAre you sure you want to continue?": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld تدريب أو خطة تدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld تدريب أو خطة تدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld من التدريبات أو خطط التدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld تدريبات أو خطط تدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld تدريبًا أو خطة تدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يُستخدم هذا التمرين في %lld تدريب أو خطة تدريب.\nإذا حذفته، فسيُزال من تلك التدريبات والخطط.\n\nهل أنت متأكد أنك تريد المتابعة؟"
                }
              }
            }
          }
        },
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Това упражнение се използва в %lld тренировка или тренировъчен план.\nАко го изтриеш, ще бъде премахнато оттам.\n\nНаистина ли искаш да продължиш?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Това упражнение се използва в %lld тренировки или тренировъчни плана.\nАко го изтриеш, ще бъде премахнато от тях.\n\nНаистина ли искаш да продължиш?"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "এই ব্যায়ামটি %lldটি ওয়ার্কআউট বা প্রশিক্ষণ পরিকল্পনায় ব্যবহৃত হচ্ছে।\nআপনি এটি মুছে ফেললে, ওই ওয়ার্কআউট বা পরিকল্পনাটি থেকে এটি সরিয়ে ফেলা হবে।\n\nআপনি কি নিশ্চিতভাবে চালিয়ে যেতে চান?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "এই ব্যায়ামটি %lldটি ওয়ার্কআউট বা প্রশিক্ষণ পরিকল্পনায় ব্যবহৃত হচ্ছে।\nআপনি এটি মুছে ফেললে, ওই ওয়ার্কআউট ও পরিকল্পনাগুলো থেকে এটি সরিয়ে ফেলা হবে।\n\nআপনি কি নিশ্চিতভাবে চালিয়ে যেতে চান?"
                }
              }
            }
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aquest exercici s'utilitza en %lld entrenament o pla d'entrenament.\nSi el suprimeixes, s'eliminarà d'aquest entrenament o pla.\n\nSegur que vols continuar?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aquest exercici s'utilitza en %lld entrenaments o plans d'entrenament.\nSi el suprimeixes, s'eliminarà d'aquests entrenaments i plans.\n\nSegur que vols continuar?"
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Toto cvičení se používá v %lld tréninku nebo tréninkovém plánu.\nPokud ho smažete, bude z tohoto tréninku nebo plánu odebráno.\n\nOpravdu chcete pokračovat?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Toto cvičení se používá ve %lld trénincích nebo tréninkových plánech.\nPokud ho smažete, bude z těchto tréninků a plánů odebráno.\n\nOpravdu chcete pokračovat?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Toto cvičení se používá v %lld tréninku nebo tréninkového plánu.\nPokud ho smažete, bude z těchto tréninků a plánů odebráno.\n\nOpravdu chcete pokračovat?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Toto cvičení se používá v %lld trénincích nebo tréninkových plánech.\nPokud ho smažete, bude z těchto tréninků a plánů odebráno.\n\nOpravdu chcete pokračovat?"
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Denne øvelse bruges i %lld træning eller træningsplan.\nHvis du sletter den, fjernes den fra denne træning eller plan.\n\nEr du sikker på, at du vil fortsætte?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Denne øvelse bruges i %lld træninger eller træningsplaner.\nHvis du sletter den, fjernes den fra disse træninger og planer.\n\nEr du sikker på, at du vil fortsætte?"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Diese Übung wird in %lld Workout oder Trainingsplan verwendet.\nWenn du sie löschst, wird sie daraus entfernt.\n\nMöchtest du wirklich fortfahren?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Diese Übung wird in %lld Workouts oder Trainingsplänen verwendet.\nWenn du sie löschst, wird sie aus diesen Workouts und Plänen entfernt.\n\nMöchtest du wirklich fortfahren?"
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Αυτή η άσκηση χρησιμοποιείται σε %lld προπόνηση ή πρόγραμμα προπόνησης.\nΑν τη διαγράψεις, θα αφαιρεθεί από αυτή την προπόνηση ή το πρόγραμμα.\n\nΘέλεις σίγουρα να συνεχίσεις;"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Αυτή η άσκηση χρησιμοποιείται σε %lld προπονήσεις ή προγράμματα προπόνησης.\nΑν τη διαγράψεις, θα αφαιρεθεί από αυτές τις προπονήσεις και τα προγράμματα.\n\nΘέλεις σίγουρα να συνεχίσεις;"
                }
              }
            }
