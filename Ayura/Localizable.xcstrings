        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerjenlerinize ve besin öğesi önceliklerinize uygun olarak USDA besinlerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує продукти USDA з урахуванням ваших алергенів і пріоритетів нутрієнтів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے الرجنز اور غذائی اجزاء کی ترجیحات کا خیال رکھتے ہوئے USDA غذائیں استعمال کرتا ہے۔"
