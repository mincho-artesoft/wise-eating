    "This will add meals for %@. How should meals for a specific time slot be added?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إضافة وجبات ليوم %@. كيف تريد إضافة الوجبات لفترة زمنية محددة؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще добави хранения за %@. Как да бъдат добавени храненията за конкретен часови интервал?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে %@ তারিখের জন্য খাবার যোগ হবে। কোনো নির্দিষ্ট সময়ের খাবারের স্লটে খাবার কীভাবে যোগ করা হবে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això afegirà els àpats per al dia %@. Com s'han d'afegir els àpats d'una franja horària específica?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto přidáte jídla pro datum %@. Jak se mají přidat jídla pro konkrétní časový úsek?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil tilføje måltider for %@. Hvordan skal måltider for et bestemt tidsrum tilføjes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Mahlzeiten für %@ hinzugefügt. Wie sollen Mahlzeiten für ein bestimmtes Zeitfenster hinzugefügt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα προστεθούν γεύματα για %@. Πώς να προστεθούν τα γεύματα για μια συγκεκριμένη ώρα;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirán comidas para el %@. ¿Cómo quieres añadir las comidas de una franja horaria concreta?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto agregará comidas para el %@. ¿Cómo quieres agregar las comidas para un horario específico?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lisää ateriat päivälle %@. Miten tietyn aikavälin ateriat lisätään?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera des repas pour le %@. Comment ajouter les repas pour un créneau horaire précis ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera les repas pour le %@. Comment les repas d'une plage horaire précise doivent-ils être ajoutés?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ %@ માટે ભોજન ઉમેરશે. ચોક્કસ સમય સ્લોટ માટે ભોજન કેવી રીતે ઉમેરવું જોઈએ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תוסיף ארוחות עבור %@. כיצד להוסיף ארוחות למשבצת זמן מסוימת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %@ के लिए भोजन जुड़ेंगे। किसी विशेष समय स्लॉट के लिए भोजन कैसे जोड़े जाएं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim će se dodati obroci za %@. Kako treba dodati obroke za određeni termin?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel étkezéseket adsz hozzá ehhez a naphoz: %@. Hogyan szeretnéd hozzáadni az adott idősáv étkezéseit?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambahkan waktu makan untuk %@. Bagaimana waktu makan untuk slot waktu tertentu harus ditambahkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno aggiunti i pasti per %@. Come vuoi aggiungere i pasti per una fascia oraria specifica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の食事を追加します。特定の時間帯の食事をどのように追加しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %@ күніне тағамдар қосады. Белгілі бір уақыт аралығына тағамдар қалай қосылсын?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %@ ಗಾಗಿ ಊಟಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ. ನಿರ್ದಿಷ್ಟ ಸಮಯದ ಸ್ಲಾಟ್‌ಗೆ ಊಟಗಳನ್ನು ಹೇಗೆ ಸೇರಿಸಬೇಕು?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 식사를 추가합니다. 특정 시간대의 식사를 어떻게 추가할까요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %@ എന്നതിലേക്കുള്ള ഭക്ഷണങ്ങൾ ചേർക്കും. ഒരു പ്രത്യേക സമയത്തേക്കുള്ള ഭക്ഷണങ്ങൾ എങ്ങനെയാണ് ചേർക്കേണ്ടത്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे %@ साठी जेवण जोडले जाईल. विशिष्ट वेळेसाठी जेवण कसे जोडायचे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambah hidangan untuk %@. Bagaimanakah hidangan untuk slot masa tertentu harus ditambah?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette legger til måltider for %@. Hvordan skal måltider for et bestemt tidsrom legges til?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden maaltijden voor %@ toegevoegd. Hoe moeten maaltijden voor een specifiek tijdvak worden toegevoegd?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା %@ ପାଇଁ ଭୋଜନ ଯୋଡ଼ିବ। ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ସମୟ ସ୍ଲଟ୍ ପାଇଁ ଭୋଜନ କିପରି ଯୋଡ଼ାଯିବ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ %@ ਲਈ ਭੋਜਨ ਜੋੜੇਗਾ। ਕਿਸੇ ਖਾਸ ਸਮੇਂ ਦੇ ਸਲਾਟ ਲਈ ਭੋਜਨ ਕਿਵੇਂ ਜੋੜੇ ਜਾਣੇ ਚਾਹੀਦੇ ਹਨ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodane zostaną posiłki na %@. Jak dodać posiłki dla konkretnej pory dnia?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso adicionará refeições para %@. Como as refeições de um horário específico devem ser adicionadas?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá adicionar refeições para %@. Como devem ser adicionadas as refeições para um horário específico?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor adăuga mese pentru %@. Cum să fie adăugate mesele pentru un anumit interval orar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут добавлены приёмы пищи на %@. Как добавить приёмы пищи на конкретное время?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajú sa jedlá na %@. Ako sa majú pridať jedlá pre konkrétny časový úsek?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To bo dodalo obroke za %@. Kako želite dodati obroke za določen časovni termin?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta lägger till måltider för %@. Hur ska måltider för en specifik tidslucka läggas till?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ நாளுக்கான உணவுகள் சேர்க்கப்படும். ஒரு குறிப்பிட்ட நேரத்திற்கான உணவுகளை எவ்வாறு சேர்க்க வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %@ కోసం భోజనాలను జోడిస్తుంది. ఒక నిర్దిష్ట సమయానికి భోజనాలను ఎలా జోడించాలి?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเพิ่มมื้ออาหารสำหรับวันที่ %@ คุณต้องการเพิ่มมื้ออาหารสำหรับช่วงเวลาเดียวกันอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ için öğün ekleyecektir. Belirli bir zaman dilimine ait öğünler nasıl eklensin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це додасть прийоми їжі на %@. Як додавати прийоми їжі для певного часу?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %@ کے لیے کھانے شامل کرے گا۔ کسی مخصوص وقت کے لیے کھانے کس طرح شامل کیے جائیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thêm các bữa ăn cho %@. Bạn muốn thêm các bữa ăn vào khung giờ cụ thể như thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
