    "Apple Intelligence is turned off. Enable it in Settings to use AI meal generation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزة Apple Intelligence متوقفة. فعّلها في الإعدادات لاستخدام توليد الوجبات عبر AI."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence е изключен. Включи го в Настройки, за да използваш AI генериране на хранения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ আছে। AI দিয়ে খাবার তৈরি করতে সেটিংস থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence està desactivat. Activa'l a Configuració per fer servir la generació d'àpats amb AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce Apple Intelligence je vypnutá. Chcete-li používat generování jídel pomocí AI, zapněte ji v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slået fra. Slå det til i Indstillinger for at bruge AI-måltidsgenerering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es in den Einstellungen, um die AI-Mahlzeitengenerierung zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποίησέ το στις Ρυθμίσεις για να χρησιμοποιήσεις τη δημιουργία γευμάτων AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivada. Actívala en Ajustes para usar la generación de comidas con IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Configuración para usar la generación de comidas con AI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on pois päältä. Ota se käyttöön Asetuksissa käyttääksesi AI-aterioiden luontia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages pour utiliser la génération de repas AI."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Activez-le dans Réglages pour utiliser la génération de repas AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence બંધ છે. AI ભોજન જનરેશનનો ઉપયોગ કરવા માટે તેને સેટિંગ્સમાં ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence כבוי. הפעל אותו בהגדרות כדי להשתמש ביצירת ארוחות עם AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है। AI भोजन जनरेशन उपयोग करने के लिए इसे सेटिंग्ज़ में सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je isključen. Uključi ga u Postavkama za AI generiranje obroka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence ki van kapcsolva. Engedélyezd a Beállításokban az AI étkezésgenerálás használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Aktifkan di Pengaturan untuk menggunakan pembuatan waktu makan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivata. Attivala in Impostazioni per usare la generazione di pasti con AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。AI食事生成を使用するには、「設定」でオンにしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence өшірулі. AI тағам генерациясын пайдалану үшін оны Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಆಫ್ ಆಗಿದೆ. AI ಊಟದ ರಚನೆಯನ್ನು ಬಳಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. AI 식단 생성을 사용하려면 설정에서 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ഓഫാണ്. AI ഭക്ഷണ ജനറേഷൻ ഉപയോഗിക്കാൻ ക്രമീകരണങ്ങളിൽ ഇത് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद आहे. AI जेवण निर्मिती वापरण्यासाठी ते सेटिंग्जमध्ये सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Dayakannya dalam Seting untuk menggunakan penjanaan hidangan AI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slått av. Slå det på i Innstillinger for å bruke AI-måltidsgenerering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is uitgeschakeld. Schakel dit in bij Instellingen om AI-maaltijdgeneratie te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ବନ୍ଦ ଅଛି। AI ଭୋଜନ ଜେନେରେସନ୍ ବ୍ୟବହାର କରିବାକୁ ସେଟିଂସ୍‌ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਬੰਦ ਹੈ। AI ਭੋਜਨ ਜਨਰੇਸ਼ਨ ਵਰਤਣ ਲਈ ਇਸਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Apple Intelligence jest wyłączona. Włącz ją w Ustawieniach, aby korzystać z generowania posiłków AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes para usar a geração de refeições por AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ativa-a nas Definições para usares a geração de refeições por AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence este dezactivat. Activează-l în Configurări pentru a folosi generarea meselor cu AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence выключен. Включите его в Настройках, чтобы использовать AI-генерацию рациона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Ak chcete používať generovanie jedál pomocou AI, zapnite ju v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je izklopljen. Omogočite ga v Nastavitvah za uporabo ustvarjanja obrokov z AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är avstängt. Aktivera det i Inställningar för att använda AI-måltidsgenerering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence முடக்கப்பட்டுள்ளது. AI உணவு உருவாக்கத்தைப் பயன்படுத்த அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఆఫ్‌లో ఉంది. AI భోజన జనరేషన్‌ను ఉపయోగించడానికి సెట్టింగ్‌లలో దీన్ని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ปิดอยู่ เปิดใช้งานในการตั้งค่าเพื่อใช้การสร้างมื้ออาหารด้วย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı. AI öğün oluşturmayı kullanmak için Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вимкнено. Увімкніть цю функцію в Параметрах, щоб генерувати прийоми їжі з AI."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence بند ہے۔ AI کے ذریعے کھانے تیار کرنے کے لیے اسے سیٹنگز میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt. Hãy bật trong Cài đặt để sử dụng tính năng tạo bữa ăn bằng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能已关闭。请在“设置”中开启以使用 AI 膳食生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已關閉。請在「設定」中啟用以使用 AI 餐點生成。"
          }
        }
      }
    },
