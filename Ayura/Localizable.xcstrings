        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തിഗത അനുയോജ്യത കാണാൻ %@-നായി ഒരു ആയുർവേദ പ്രൊഫൈൽ സൃഷ്ടിക്കുക."
