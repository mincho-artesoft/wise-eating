    "Add ingredients to see a live Ayurveda preview.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مكونات لرؤية معاينة أيورفيدا مباشرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави съставки, за да видиш аюрведичен преглед на живо."
