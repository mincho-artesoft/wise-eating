        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera det här partiet (%@ %@, går ut: %@)? Denna åtgärd kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொகுப்பை (%@ %@, காலாவதி: %@) நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా ఈ బ్యాచ్‌ను (%@ %@, గడువు: %@) తొలగించాలనుకుంటున్నారా? ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบล็อตนี้ (%@ %@, หมดอายุ: %@)? การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu partiyi (%@ %@, son kullanma: %@) silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
