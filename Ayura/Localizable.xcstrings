          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération de recette AI nécessite iOS 26 ou version ultérieure."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération de recette AI nécessite iOS 26 ou une version ultérieure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI રેસીપી જનરેશન માટે iOS 26 અથવા નવું વર્ઝન જરૂરી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת מתכון ב-AI דורשת iOS 26 ואילך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI व्यंजन जनरेशन के लिए iOS 26 या नया संस्करण आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI generiranje recepta zahtijeva iOS 26 ili noviji."
          }
