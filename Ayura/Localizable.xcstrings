        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette '%@' fra måltidet? Dette påvirker ikke dine gemte fødevarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du „%@“ wirklich aus der Mahlzeit entfernen? Deine gespeicherten Lebensmittel bleiben davon unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις το «%@» από το γεύμα; Αυτό δεν θα επηρεάσει τα αποθηκευμένα στοιχεία σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@» de la comida? Esto no afectará a tus alimentos guardados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar “%@” de la comida? Esto no afectará tus alimentos guardados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa kohteen ”%@” ateriasta? Tämä ei vaikuta varastoituihin tuotteisiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer « %@ » du repas ? Cela n'affectera pas tes aliments enregistrés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » du repas? Cela n'affectera pas vos aliments enregistrés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર ભોજનમાંથી '%@' કાઢી નાખવા માંગો છો? આનાથી તમારી સંગ્રહિત વસ્તુઓ પર અસર થશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק את '%@' מהארוחה? פעולה זו לא תשפיע על הפריטים השמורים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई भोजन से '%@' को हटाना चाहते हैं? इससे आपके संग्रहीत आइटम प्रभावित नहीं होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati „%@“ iz obroka? To neće utjecati na tvoje spremljene stavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törlöd a(z) „%@” elemet az étkezésből? Ez nem érinti a tárolt tételeidet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus '%@' dari waktu makan ini? Tindakan ini tidak akan memengaruhi item tersimpan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare '%@' dal pasto? Questo non influirà sui tuoi elementi salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を食事から削除してもよろしいですか？保存済みの食品には影響しません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» өнімін тамақтанудан жойғыңыз келетініне сенімдісіз бе? Бұл сақталған өнімдеріңізге әсер етпейді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಖಚಿತವಾಗಿ '%@' ಅನ್ನು ಊಟದಿಂದ ಅಳಿಸಲು ಬಯಸುವಿರಾ? ಇದು ನಿಮ್ಮ ಸಂಗ್ರಹಿಸಿದ ಪದಾರ್ಥಗಳ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사에서 '%@'을(를) 삭제하시겠습니까? 저장된 항목에는 영향을 미치지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭക്ഷണത്തിൽ നിന്ന് '%@' ഇല്ലാതാക്കണമെന്ന് തീർച്ചയാണോ? ഇത് നിങ്ങളുടെ സംഭരിച്ച ഇനങ്ങളെ ബാധിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला जेवणातून '%@' नक्की हटवायचे आहे का? याचा तुमच्या साठवलेल्या पदार्थांवर परिणाम होणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadam '%@' daripada hidangan? Ini tidak akan menjejaskan item simpanan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette «%@» fra måltidet? Dette påvirker ikke de lagrede varene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je '%@' uit de maaltijd wilt verwijderen? Dit heeft geen invloed op je opgeslagen items."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ ଭାବରେ ଭୋଜନରୁ '%@' କୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି? ଏହା ଆପଣଙ୍କ ସଂରକ୍ଷିତ ସାମଗ୍ରୀକୁ ପ୍ରଭାବିତ କରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ ਭੋਜਨ ਵਿੱਚੋਂ '%@' ਨੂੰ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਸ ਨਾਲ ਤੁਹਾਡੀਆਂ ਸਟੋਰ ਕੀਤੀਆਂ ਆਈਟਮਾਂ 'ਤੇ ਕੋਈ ਅਸਰ ਨਹੀਂ ਪਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć „%@” z posiłku? Nie wpłynie to na zapisane produkty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar '%@' da refeição? Isso não afetará seus itens salvos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar '%@' da refeição? Isto não afetará os teus itens guardados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur dorești să ștergi „%@” din masă? Acest lucru nu va afecta alimentele salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить «%@» из приёма пищи? Это не затронет ваши сохранённые продукты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať „%@“ z jedla? Neovplyvní to vaše uložené položky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati '%@' iz obroka? To ne bo vplivalo na vaše shranjene izdelke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera '%@' från måltiden? Detta påverkar inte dina sparade livsmedel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவிலிருந்து '%@'-ஐ நிச்சயமாக நீக்க விரும்புகிறீர்களா? இது உங்கள் சேமித்த பொருள்களைப் பாதிக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా '%@' ను భోజనం నుండి తొలగించాలనుకుంటున్నారా? ఇది మీ నిల్వ చేసిన పదార్థాలపై ప్రభావం చూపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบ '%@' ออกจากมื้ออาหาร? การดำเนินการนี้จะไม่ส่งผลต่อรายการที่บันทึกไว้ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' besinini öğünden silmek istediğinizden emin misiniz? Bu işlem kayıtlı öğelerinizi etkilemeyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити «%@» із прийому їжі? Це не вплине на ваші збережені продукти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی '%@' کو کھانے سے حذف کرنا چاہتے ہیں؟ اس سے آپ کی محفوظ کردہ اشیاء متاثر نہیں ہوں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa '%@' khỏi bữa ăn không? Thao tác này sẽ không ảnh hưởng đến các mục đã lưu trữ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要从餐食中删除“%@”吗？这不会影响你已储存的食物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要從餐點中刪除「%@」嗎？這不會影響你儲存的項目。"
          }
        }
      }
