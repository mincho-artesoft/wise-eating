        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar la lista «%@»? Esta acción no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar la lista '%@'? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa listan '%@'? Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer la liste « %@ » ? Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer la liste « %@ »? Cette action est irréversible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર '%@' યાદી કાઢી નાખવા માંગો છો? આ ક્રિયા પૂર્વવત્ કરી શકાશે નહીં."
