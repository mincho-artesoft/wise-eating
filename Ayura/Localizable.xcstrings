    "Dosha choices reorder these foods; they do not hide aggravating results.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات الدوشا تعيد ترتيب هذه الأطعمة؛ ولا تخفي النتائج المهيّجة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборът на доша пренарежда тези храни; той не скрива влошаващите резултати."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দোষ নির্বাচন এই খাবারগুলোর ক্রম বদলায়; দোষ বৃদ্ধিকারী ফলাফল লুকায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seleccions de dosha reordenen aquests aliments; no amaguen els resultats agreujants."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volba doshy pouze mění pořadí těchto potravin; zhoršující výsledky neskrývá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosha-valg ændrer rækkefølgen af disse fødevarer; de skjuler ikke forværrende resultater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dosha-Auswahl sortiert diese Lebensmittel neu; verstärkende Ergebnisse werden nicht ausgeblendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές ντόσα αναδιατάσσουν αυτές τις τροφές· δεν κρύβουν τα επιβαρυντικά αποτελέσματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de dosha reordena estos alimentos; no oculta los resultados que lo agravan."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de dosha reordena estos alimentos; no oculta los resultados que lo agravan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosha-valinnat muuttavat näiden ruokien järjestystä; ne eivät piilota pahentavia tuloksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix de dosha réorganisent ces aliments sans masquer les résultats aggravants."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix de dosha réorganisent ces aliments; ils ne masquent pas les résultats aggravants."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દોષની પસંદગી આ ખોરાકનો ક્રમ બદલે છે; તે દોષ વધારતા પરિણામોને છુપાવતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירות דושה מסדרות מחדש מזונות אלה; הן אינן מסתירות תוצאות מחמירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोष चयन इन खाद्य पदार्थों का क्रम बदलते हैं; वे कुपित करने वाले परिणामों को छिपाते नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabir dosha mijenja redoslijed ovih namirnica; ne skriva rezultate koji pogoršavaju doshe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dosha-választás csak újrarendezi ezeket az élelmiszereket; nem rejti el a fokozó találatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan dosha mengurutkan ulang makanan ini, bukan menyembunyikan hasil yang memperburuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scelte dei dosha riordinano questi alimenti; non nascondono i risultati che aggravano i dosha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドーシャの選択はこれらの食品の並び順を変更するのみで、悪化させる結果も非表示にはしません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доша таңдауы бұл өнімдердің ретін ғана өзгертеді; күшейтетін нәтижелер жасырылмайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೋಷ ಆಯ್ಕೆಗಳು ಈ ಆಹಾರಗಳ ಕ್ರಮವನ್ನು ಬದಲಾಯಿಸುತ್ತವೆ; ಅವು ಪ್ರಕೋಪಗೊಳಿಸುವ ಫಲಿತಾಂಶಗಳನ್ನು ಮರೆಮಾಡುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도샤 선택은 이 식품들의 순서만 재정렬하며, 악화시키는 결과를 숨기지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദോഷ തിരഞ്ഞെടുപ്പുകൾ ഈ ഭക്ഷണങ്ങളുടെ ക്രമം മാറ്റുന്നു; കോപിപ്പിക്കുന്ന ഫലങ്ങളെ അവ മറയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोषांच्या निवडीमुळे या अन्नपदार्थांचा क्रम बदलतो; दोष वाढवणारे परिणाम लपवले जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan dosha menyusun semula makanan ini; ia tidak menyembunyikan hasil yang memburukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosha-valg endrer rekkefølgen på disse matvarene; de skjuler ikke forverrende resultater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosha-keuzes herschikken deze voedingsmiddelen; verergerende resultaten worden niet verborgen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୋଷ ଚୟନ ଏହି ଖାଦ୍ୟଗୁଡ଼ିକର କ୍ରମ ବଦଳାଏ; ଏହା ପ୍ରକୋପିତ କରୁଥିବା ଫଳାଫଳଗୁଡ଼ିକୁ ଲୁଚାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੋਸ਼ ਦੀਆਂ ਚੋਣਾਂ ਇਨ੍ਹਾਂ ਭੋਜਨਾਂ ਦਾ ਕ੍ਰਮ ਬਦਲਦੀਆਂ ਹਨ; ਇਹ ਵਧਾਉਣ ਵਾਲੇ ਨਤੀਜਿਆਂ ਨੂੰ ਲੁਕਾਉਂਦੀਆਂ ਨਹੀਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór dosz zmienia kolejność tych produktów, ale nie ukrywa wyników nasilających."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas de dosha reordenam estes alimentos; elas não ocultam resultados agravantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas de dosha reordenam estes alimentos; não ocultam resultados agravantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunile pentru dosha reordonează aceste alimente; nu ascund rezultatele care agravează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор доши меняет порядок продуктов, но не скрывает обостряющие её варианты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voľby dosh menia poradie týchto potravín; zhoršujúce výsledky sa neskrývajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbire doshe preuredijo ta živila; ne skrijejo rezultatov, ki jo poslabšajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Doshaval ändrar ordningen på dessa livsmedel; de döljer inte resultat som förvärrar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோஷத் தேர்வுகள் இந்த உணவுகளை மறுவரிசைப்படுத்தும்; அவை அதிகரிக்கும் முடிவுகளை மறைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దోష ఎంపికలు ఈ ఆహారాల క్రమాన్ని మారుస్తాయి; ప్రకోపింపజేసే ఫలితాలను దాచవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกโดชาจะจัดลำดับอาหารเหล่านี้ใหม่ โดยไม่ซ่อนผลลัพธ์ที่กระตุ้นโดชา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosha seçimleri bu besinleri yeniden sıralar; dosha'yı artıran sonuçları gizlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір доші змінює порядок цих продуктів, але не приховує ті, що загострюють дошу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوشا کے انتخابات ان غذاؤں کی ترتیب بدلتے ہیں؛ یہ بگاڑنے والے نتائج کو چھپاتے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn dosha sắp xếp lại các thực phẩm này, không ẩn những kết quả làm tăng nặng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
