          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Comidas, entrenamientos y recordatorios en un solo lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ateriat, treenit ja muistutukset yhdessä paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repas, entraînements et rappels au même endroit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Repas, entraînements et rappels au même endroit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ભોજન, વર્કઆઉટ્સ અને રિમાઇન્ડર્સ એક જ જગ્યાએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
