        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba sesuaikan rentang tanggal atau hapus filter untuk melihat semua catatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a modificare l'intervallo di date o a cancellare il filtro per vedere tutte le tue note."
