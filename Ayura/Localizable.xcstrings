          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Questo piano di allenamento ha %lld allenamento collegato.\n\n• \"Elimina solo il piano\" rimuoverà il piano ma manterrà gli allenamenti nella tua libreria di esercizi.\n• \"Elimina piano e allenamenti\" eliminerà il piano e anche gli allenamenti collegati.\n\nCosa vuoi fare?"
                }
