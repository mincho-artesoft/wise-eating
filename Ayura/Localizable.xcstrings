    "Found \"%@\" in your database. You can add it, or create a new entry for \"%@\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على \"%@\" في قاعدة بياناتك. يمكنك إضافته، أو إنشاء إدخال جديد لـ \"%@\"."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е намерено в базата ти данни. Можеш да го добавиш или да създадеш нов запис за „%@“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটাবেসে \"%@\" পাওয়া গেছে। আপনি এটি যোগ করতে পারেন, অথবা \"%@\"-এর জন্য নতুন এন্ট্রি তৈরি করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha trobat «%@» a la teva base de dades. Pots afegir-lo o crear una entrada nova per a «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka „%@“ byla nalezena ve vaší databázi. Můžete ji přidat, nebo vytvořit nový záznam pro „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandt \"%@\" i din database. Du kan tilføje den eller oprette en ny post for \"%@\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde in deiner Datenbank gefunden. Du kannst es hinzufügen oder einen neuen Eintrag für „%@“ erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρέθηκε το «%@» στη βάση δεδομένων σου. Μπορείς να το προσθέσεις ή να δημιουργήσεις νέα καταχώριση για το «%@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró «%@» en tu base de datos. Puedes añadirlo o crear una nueva entrada para «%@»."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró \"%@\" en tu base de datos. Puedes agregarlo o crear una nueva entrada para \"%@\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” löytyi tietokannastasi. Voit lisätä sen tai luoda uuden merkinnän tuotteelle ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » trouvé dans ta base. Tu peux l'ajouter ou créer une nouvelle entrée pour « %@ »."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été trouvé dans votre base de données. Vous pouvez l'ajouter ou créer une nouvelle entrée pour « %@ »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ડેટાબેઝમાં \"%@\" મળ્યું છે. તમે તેને ઉમેરી શકો છો અથવા \"%@\" માટે નવી એન્ટ્રી બનાવી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמצא \"%@\" במסד הנתונים שלך. תוכל להוסיף אותו, או ליצור רשומה חדשה עבור \"%@\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डेटाबेस में \"%@\" मिल गया है। आप इसे जोड़ सकते हैं, या \"%@\" के लिए नई प्रविष्टि बना सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađeno je „%@“ u tvojoj bazi. Možeš to dodati ili izraditi novi unos za „%@“."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” megtalálható az adatbázisodban. Hozzáadhatod, vagy létrehozhatsz egy új bejegyzést ehhez: „%@”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ditemukan di basis data Anda. Anda dapat menambahkannya, atau membuat entri baru untuk \"%@\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» trovato nel tuo database. Puoi aggiungerlo oppure creare una nuova voce per «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースに「%@」が見つかりました。追加するか、「%@」の新しい項目を作成できます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорыңыздан «%@» табылды. Оны қосуға немесе «%@» үшін жаңа жазба жасауға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೇಟಾಬೇಸ್‌ನಲ್ಲಿ \"%@\" ಕಂಡುಬಂದಿದೆ. ನೀವು ಅದನ್ನು ಸೇರಿಸಬಹುದು, ಅಥವಾ \"%@\" ಗಾಗಿ ಹೊಸ ನಮೂದನ್ನು ರಚಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스에서 \"%@\"을(를) 찾았습니다. 바로 추가하거나 \"%@\"의 새 항목을 만들 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡാറ്റാബേസിൽ \"%@\" കണ്ടെത്തി. നിങ്ങൾക്ക് ഇത് ചേർക്കാം, അല്ലെങ്കിൽ \"%@\" എന്നതിനായി ഒരു പുതിയ എൻട്രി സൃഷ്ടിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या डेटाबेसमध्ये \"%@\" सापडले. तुम्ही ते जोडू शकता, किंवा \"%@\" साठी नवीन नोंद तयार करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ditemui dalam pangkalan data anda. Anda boleh menambahkannya, atau mencipta entri baharu untuk \"%@\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant «%@» i databasen din. Du kan legge den til, eller opprette en ny oppføring for «%@»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" gevonden in je database. Je kunt het toevoegen of een nieuw item maken voor \"%@\"."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଡାଟାବେସ୍‌ରେ \"%@\" ମିଳିଲା। ଆପଣ ଏହାକୁ ଯୋଗ କରିପାରିବେ, କିମ୍ବା \"%@\" ପାଇଁ ଏକ ନୂଆ ଏଣ୍ଟ୍ରି ତିଆରି କରିପାରିବେ।"
