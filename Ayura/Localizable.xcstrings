    "Practices you start will appear here with their start and end times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الممارسات التي تبدؤها هنا مع أوقات بدئها وانتهائها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Практиките, които започнеш, ще се появят тук с началния и крайния си час."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে অভ্যাসগুলো শুরু করবেন, সেগুলো শুরুর ও শেষের সময়সহ এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pràctiques que iniciïs apareixeran aquí amb l'hora d'inici i de fi."
          }
        },
        "cs": {
          "stringUnit": {
