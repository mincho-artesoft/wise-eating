    "Practices you start will appear here with their start and end times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الممارسات التي تبدؤها هنا مع أوقات بدئها وانتهائها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Практиките, които започнеш, ще се появят тук с началния и крайния си час."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে অভ্যাসগুলো শুরু করবেন, সেগুলো শুরুর ও শেষের সময়সহ এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pràctiques que iniciïs apareixeran aquí amb l'hora d'inici i de fi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuštěné praxe se zde zobrazí s časem začátku a konce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser, du starter, vises her med start- og sluttidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestartete Übungen erscheinen hier mit Start- und Endzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρακτικές που ξεκινάς θα εμφανίζονται εδώ με την ώρα έναρξης και λήξης τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las prácticas que empieces aparecerán aquí con sus horas de inicio y fin."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las prácticas que inicies aparecerán aquí con su hora de inicio y fin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittamasi harjoitukset näkyvät täällä alku- ja lopetusaikoineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pratiques que tu commences apparaîtront ici avec leur heure de début et de fin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pratiques que vous démarrez apparaîtront ici avec leurs heures de début et de fin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે શરૂ કરો છો તે અભ્યાસો તેમના શરૂઆત અને સમાપ્તિ સમય સાથે અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגולים שתתחיל יופיעו כאן עם זמני ההתחלה והסיום שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा शुरू किए गए अभ्यास उनके प्रारंभ और समाप्ति समय के साथ यहां दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prakse koje započneš pojavit će se ovdje s vremenom početka i završetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elindított gyakorlatok itt jelennek meg a kezdési és befejezési idejükkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan yang Anda mulai akan muncul di sini beserta waktu mulai dan selesainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pratiche che avvii appariranno qui con i rispettivi orari di inizio e fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始した実践は、開始時刻と終了時刻とともにここに表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз бастаған тәжірибелер осында басталу және аяқталу уақытымен бірге көрінеді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಪ್ರಾರಂಭಿಸುವ ಅಭ್ಯಾಸಗಳು ಅವುಗಳ ಪ್ರಾರಂಭ ಮತ್ತು ಮುಕ್ತಾಯ ಸಮಯಗಳೊಂದಿಗೆ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수련을 시작하면 시작 및 종료 시간이 여기에 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ആരംഭിക്കുന്ന പരിശീലനങ്ങൾ അവയുടെ ആരംഭ, അവസാന സമയങ്ങൾ സഹിതം ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सुरू केलेले सराव येथे त्यांच्या सुरू आणि समाप्त होण्याच्या वेळांसह दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan yang anda mulakan akan dipaparkan di sini bersama masa mula dan tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser du starter, vises her med start- og sluttidspunkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefeningen die je start verschijnen hier met hun begin- en eindtijd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଆରମ୍ଭ କରୁଥିବା ଅଭ୍ୟାସଗୁଡ଼ିକ ସେଗୁଡ଼ିକର ଆରମ୍ଭ ଏବଂ ଶେଷ ସମୟ ସହିତ ଏଠାରେ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਵੱਲੋਂ ਸ਼ੁਰੂ ਕੀਤੇ ਅਭਿਆਸ ਆਪਣੇ ਸ਼ੁਰੂ ਅਤੇ ਸਮਾਪਤੀ ਦੇ ਸਮੇਂ ਸਮੇਤ ਇੱਥੇ ਦਿਖਾਈ ਦੇਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczęte praktyki pojawią się tutaj wraz z czasem rozpoczęcia i zakończenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As práticas que você iniciar aparecerão aqui com seus horários de início e término."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As práticas que iniciares aparecerão aqui com as respetivas horas de início e fim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Practicile pe care le începi vor apărea aici, cu ora de început și de sfârșit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начатые вами практики будут появляться здесь с временем начала и завершения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praxe, ktoré spustíte, sa tu zobrazia spolu s časom začiatku a konca."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prakse, ki jih začnete, se bodo tukaj prikazale z začetnim in končnim časom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningar som du startar visas här med sina start- och sluttider."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தொடங்கும் பயிற்சிகள் அவற்றின் தொடக்க மற்றும் முடிவு நேரங்களுடன் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ప్రారంభించిన సాధనలు వాటి ప్రారంభ మరియు ముగింపు సమయాలతో ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฝึกที่คุณเริ่มจะแสดงที่นี่พร้อมเวลาเริ่มต้นและเวลาสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlattığınız pratikler başlangıç ve bitiş saatleriyle burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпочаті вами практики з’являться тут із часом початку й завершення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جو مشقیں شروع کریں گے وہ یہاں اپنے آغاز اور اختتام کے وقت کے ساتھ ظاہر ہوں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài thực hành bạn bắt đầu sẽ hiển thị tại đây cùng thời gian bắt đầu và kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始的练习将连同开始和结束时间显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你開始的練習會顯示在這裡，並附上開始與結束時間。"
          }
        }
      }
    },
    "Practice History": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الممارسات"
          }
        },
        "bg": {
