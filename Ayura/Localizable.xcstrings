        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un tema o un'immagine di sfondo per cambiare l'aspetto dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマまたは背景画像を選択して、アプリの外観を変更します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаның сыртқы түрін өзгерту үшін тақырыпты немесе фон суретін таңдаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನ ಗೋಚರತೆಯನ್ನು ಬದಲಾಯಿಸಲು ಥೀಮ್ ಅಥವಾ ಹಿನ್ನೆಲೆ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 또는 배경 이미지를 선택하여 앱 화면 스타일을 변경하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്ലിക്കേഷന്റെ രൂപഭാവം മാറ്റാൻ ഒരു തീമോ പശ്ചാത്തല ചിത്രമോ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲपचे स्वरूप बदलण्यासाठी थीम किंवा पार्श्वभूमी प्रतिमा निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tema atau imej latar belakang untuk menukar penampilan aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et tema eller et bakgrunnsbilde for å endre appens utseende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een thema of een achtergrondafbeelding om de weergave van de app te wijzigen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍‌ର ଦୃଶ୍ୟରୂପ ବଦଳାଇବାକୁ ଏକ ଥିମ୍ କିମ୍ବା ପୃଷ୍ଠଭୂମି ଛବି ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਦੀ ਦਿੱਖ ਬਦਲਣ ਲਈ ਕੋਈ ਥੀਮ ਜਾਂ ਬੈਕਗ੍ਰਾਊਂਡ ਚਿੱਤਰ ਚੁਣੋ।"
          }
        },
        "pl": {
