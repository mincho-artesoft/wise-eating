        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ എല്ലാ കുറിപ്പുകളും കാണാൻ തീയതി പരിധി ക്രമീകരിക്കുകയോ ഫിൽട്ടർ മായ്ക്കുകയോ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या सर्व नोंदी पाहण्यासाठी तारीख श्रेणी समायोजित करून पहा किंवा फिल्टर साफ करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba laraskan julat tarikh atau kosongkan penapis untuk melihat semua nota anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv å justere datoperioden eller fjerne filteret for å se alle notatene dine."
