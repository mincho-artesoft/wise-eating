            "value": "Créez un profil ayurvédique pour %@ afin de voir la compatibilité personnelle."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વ્યક્તિગત અનુકૂળતા જોવા માટે %@ માટે આયુર્વેદિક પ્રોફાઇલ બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור פרופיל איורוודי עבור %@ כדי לראות התאמה אישית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत अनुकूलता देखने के लिए %@ के लिए आयुर्वेदिक प्रोफ़ाइल बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
