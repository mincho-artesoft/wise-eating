          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తిగత సరిపోలికను చూడటానికి %@ కోసం ఆయుర్వేద ప్రొఫైల్‌ను రూపొందించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างโปรไฟล์อายุรเวทสำหรับ %@ เพื่อดูความเหมาะสมเฉพาะบุคคล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel uyumu görmek için %@ adına bir Ayurvedik profil oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть аюрведичний профіль для %@, щоб бачити персональну сумісність."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاتی مطابقت دیکھنے کے لیے %@ کا آیورویدک پروفائل بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo hồ sơ Ayurveda cho %@ để xem mức độ phù hợp cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 创建阿育吠陀档案以查看个人契合度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 %@ 建立阿育吠陀檔案以查看個人契合度。"
          }
        }
      }
    },
