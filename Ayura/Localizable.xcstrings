            "value": "スペルを確認するか、別の検索をお試しください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Емлесін тексеріңіз немесе жаңа іздеу жасап көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾಗುಣಿತವನ್ನು ಪರಿಶೀಲಿಸಿ ಅಥವಾ ಹೊಸ ಹುಡುಕಾಟವನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철자를 확인하거나 다른 검색어를 입력해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്ഷരത്തെറ്റ് പരിശോധിക്കുക അല്ലെങ്കിൽ പുതിയ തിരയൽ നടത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेलिंग तपासा किंवा नवीन शोध करून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak ejaan atau cuba carian baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk stavingen eller prøv et nytt søk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de spelling of zoek opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବନାନ ଯାଞ୍ଚ କରନ୍ତୁ କିମ୍ବା ନୂଆ ସନ୍ଧାନ ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੈਲਿੰਗ ਦੀ ਜਾਂਚ ਕਰੋ ਜਾਂ ਨਵੀਂ ਖੋਜ ਅਜ਼ਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pisownię lub spróbuj nowego wyszukiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ortografia ou tente uma nova busca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a ortografia ou tenta uma nova pesquisa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică ortografia sau încearcă o nouă căutare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте правописание или попробуйте другой запрос."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte pravopis alebo skúste nové vyhľadávanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite črkovanje ali poskusite z novim iskanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera stavningen eller gör en ny sökning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்துப்பிழையைச் சரிபார்க்கவும் அல்லது புதிய தேடலை முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పెల్లింగ్‌ను తనిఖీ చేయండి లేదా కొత్త శోధనను ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการสะกดหรือลองค้นหาด้วยคำอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazımı kontrol edin veya yeni bir arama deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте правопис або спробуйте новий пошук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہجے چیک کریں یا نئی تلاش آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra chính tả hoặc thử tìm kiếm khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查拼写或尝试新的搜索。"
          }
        },
        "zh-Hant": {
