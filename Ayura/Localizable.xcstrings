        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na sledovanie vašich tréningov potrebuje Ayurveda & Asana Yoga prístup k vašim údajom v apke Zdravie.\n\nTlačidlo nižšie otvorí apku Zdravie. Tam prejdite do:\n**Zdieľanie > Apky > Ayurveda & Asana Yoga**"
          }
