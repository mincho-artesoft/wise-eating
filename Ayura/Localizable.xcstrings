        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido preparar tus datos"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos preparar tus datos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietojesi valmistelu epäonnistui"
          }
        },
