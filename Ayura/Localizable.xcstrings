    "We couldn't prepare your data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر علينا تجهيز بياناتك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да подготвим данните ти"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার ডেটা প্রস্তুত করতে পারিনি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut preparar les teves dades"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se připravit vaše data"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke klargøre dine data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten konnten nicht vorbereitet werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η προετοιμασία των δεδομένων σου"
