          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi svoje misli, bilješke ili zapažanja..."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le a gondolataidat, jegyzeteidet vagy megfigyeléseidet..."
          }
