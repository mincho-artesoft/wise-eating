    "%@ %@. Renews automatically until cancelled; cancel at least 24 hours before the period ends. Payment is charged to your Apple Account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. يتجدد الاشتراك تلقائيًا حتى يتم إلغاؤه؛ يُرجى الإلغاء قبل 24 ساعة على الأقل من انتهاء الفترة. يُخصم المبلغ من حساب Apple الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Подновява се автоматично до отказ; отмени абонамента най-малко 24 часа преди края на периода. Плащането се начислява към твоята Apple регистрация."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@। বাতিল না করা পর্যন্ত এটি স্বয়ংক্রিয়ভাবে নবায়ন হয়; মেয়াদ শেষ হওয়ার অন্তত 24 ঘণ্টা আগে বাতিল করুন। আপনার Apple অ্যাকাউন্ট থেকে পেমেন্ট কাটা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Es renova automàticament fins que es cancel·li; cancel·la-ho com a mínim 24 hores abans que acabi el període. El pagament es carrega al teu compte d'Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Předplatné se automaticky obnovuje až do zrušení; zrušte ho alespoň 24 hodin před koncem období. Platba bude stržena z vašeho účtu Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Abonnementet fornyes automatisk, indtil det opsiges; opsig mindst 24 timer før periodens udløb. Betalingen opkræves via din Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird. Die Zahlung wird über deinen Apple Account abgerechnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Ανανεώνεται αυτόματα μέχρι να ακυρωθεί· ακύρωσε τουλάχιστον 24 ώρες πριν από τη λήξη της περιόδου. Η πληρωμή χρεώνεται στον λογαριασμό σου Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Se renueva automáticamente hasta que se cancele; cancela al menos 24 horas antes de que finalice el periodo. El pago se carga en tu Cuenta de Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Se renueva automáticamente hasta que se cancele; cancela al menos 24 horas antes de que termine el periodo. El pago se carga a tu Cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Tilaus uusiutuu automaattisesti, kunnes se peruutetaan. Peruuta vähintään 24 tuntia ennen jakson päättymistä. Maksu veloitetaan Apple-tililtäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Renouvellement automatique jusqu'à résiliation ; à annuler au moins 24 heures avant la fin de la période. Le paiement est débité de ton compte Apple."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Renouvellement automatique jusqu'à annulation; annulez au moins 24 heures avant la fin de la période. Le paiement est facturé à votre compte Apple."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. રદ ન કરવામાં આવે ત્યાં સુધી આપમેળે રિન્યુ થાય છે; સમયગાળો પૂરો થવાના ઓછામાં ઓછા 24 કલાક પહેલાં રદ કરો. ચુકવણી તમારા Apple એકાઉન્ટમાંથી લેવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. מתחדש אוטומטית עד לביטול; בטל לפחות 24 שעות לפני סיום התקופה. התשלום יחויב בחשבון Apple שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@। रद्द किए जाने तक स्वतः नवीनीकृत होता है; अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द करें। भुगतान आपके Apple खाते से लिया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Automatski se obnavlja do otkazivanja; otkaži najmanje 24 sata prije isteka razdoblja. Iznos se naplaćuje s tvog Apple računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Automatikusan megújul a lemondásig; legalább 24 órával az időszak vége előtt mondd le. A fizetés az Apple-fiókodat terheli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Diperpanjang otomatis hingga dibatalkan; batalkan setidaknya 24 jam sebelum periode berakhir. Pembayaran dibebankan ke Akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Si rinnova automaticamente fino all'annullamento; annulla almeno 24 ore prima della fine del periodo. Il pagamento viene addebitato sul tuo Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@。解約するまで自動更新されます。期間終了の24時間前までに解約してください。お支払いはApple Accountに請求されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. Сіз бас тартқанға дейін автоматты түрде жаңартылады; кезең аяқталуына кемінде 24 сағат қалғанда бас тартыңыз. Төлем Apple аккаунтыңыздан алынады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. ರದ್ದುಗೊಳಿಸುವವರೆಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ; ಅವಧಿ ಮುಗಿಯುವ ಕನಿಷ್ಠ 24 ಗಂಟೆಗಳ ಮೊದಲು ರದ್ದುಮಾಡಿ. ಪಾವತಿಯನ್ನು ನಿಮ್ಮ Apple ಖಾತೆಗೆ ವಿಧಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. 취소할 때까지 자동으로 갱신되며, 구독 기간이 종료되기 최소 24시간 전에 취소해야 합니다. 결제 금액은 Apple 계정으로 청구됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. റദ്ദാക്കുന്നത് വരെ സ്വയമേവ പുതുക്കപ്പെടും; കാലയളവ് അവസാനിക്കുന്നതിന് കുറഞ്ഞത് 24 മണിക്കൂർ മുമ്പെങ്കിലും റദ്ദാക്കുക. തുക നിങ്ങളുടെ Apple അക്കൗണ്ടിൽ നിന്ന് ഈടാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. रद्द करेपर्यंत आपोआप नूतनीकरण होते; कालावधी संपण्याच्या किमान 24 तास आधी रद्द करा. शुल्क तुमच्या Apple खात्यातून आकारले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Diperbaharui secara automatik sehingga dibatalkan; batalkan sekurang-kurangnya 24 jam sebelum tempoh berakhir. Bayaran dicaj ke Akaun Apple anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Fornyes automatisk inntil det sies opp; si opp minst 24 timer før perioden utløper. Betalingen belastes Apple-kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Wordt automatisch verlengd tot opzegging; zeg ten minste 24 uur voor het einde van de periode op. De betaling wordt via je Apple Account in rekening gebracht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@। ବାତିଲ୍ ନ କରିବା ପର୍ଯ୍ୟନ୍ତ ସ୍ୱୟଂଚାଳିତ ଭାବେ ନବୀକରଣ ହୁଏ; ଅବଧି ଶେଷ ହେବାର ଅତିକମରେ 24 ଘଣ୍ଟା ପୂର୍ବରୁ ବାତିଲ୍ କରନ୍ତୁ। ଦେୟ ଆପଣଙ୍କ Apple ଆକାଉଣ୍ଟ୍‌ରୁ କଟାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@। ਰੱਦ ਕੀਤੇ ਜਾਣ ਤੱਕ ਆਪਣੇ ਆਪ ਰੀਨਿਊ ਹੁੰਦਾ ਹੈ; ਮਿਆਦ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ ਰੱਦ ਕਰੋ। ਭੁਗਤਾਨ ਤੁਹਾਡੇ Apple ਖਾਤੇ ਤੋਂ ਲਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Odnawia się automatycznie do czasu anulowania; anuluj co najmniej 24 godziny przed końcem okresu. Płatność jest pobierana z Twojego konta Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Renovação automática até o cancelamento; cancele pelo menos 24 horas antes do fim do período. O pagamento é cobrado na sua Conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Renova automaticamente até ser cancelado; cancela pelo menos 24 horas antes do fim do período. O pagamento é cobrado na tua Conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Se reînnoiește automat până la anulare; anulează cu cel puțin 24 de ore înainte de încheierea perioadei. Plata este debitată din Contul tău Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Продлевается автоматически до отмены; отменить нужно не менее чем за 24 часа до окончания периода. Оплата списывается с вашего Аккаунта Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Predplatné sa automaticky obnovuje až do zrušenia; zrušte ho najmenej 24 hodín pred koncom obdobia. Platba bude zaúčtovaná na váš Apple účet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Samodejno se podaljšuje do preklica; prekličite vsaj 24 ur pred koncem obdobja. Plačilo bremeni vaš račun Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Förnyas automatiskt tills den avslutas; avsluta minst 24 timmar innan perioden slutar. Betalningen debiteras ditt Apple-konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. ரத்துசெய்யப்படும் வரை தானாகப் புதுப்பிக்கப்படும்; காலம் முடிவதற்குக் குறைந்தது 24 மணி நேரத்திற்கு முன் ரத்துசெய்யவும். கட்டணம் உங்கள் Apple கணக்கில் வசூலிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. రద్దు చేసే వరకు స్వయంచాలకంగా పునరుద్ధరించబడుతుంది; వ్యవధి ముగియడానికి కనీసం 24 గంటల ముందు రద్దు చేయండి. చెల్లింపు మీ Apple ఖాతా నుండి వసూలు చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ การสมัครรับจะต่ออายุอัตโนมัติจนกว่าจะยกเลิก โดยต้องยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบ ระบบจะเรียกเก็บเงินจากบัญชี Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. İptal edilene kadar otomatik olarak yenilenir; dönem sona ermeden en az 24 saat önce iptal edin. Ödeme Apple Hesabınızdan tahsil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Підписка автоматично поновлюється до скасування; скасуйте її щонайменше за 24 години до завершення періоду. Оплата списується з вашого облікового запису Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@۔ منسوخ کرنے تک خودکار طور پر تجدید ہوتی ہے؛ مدت ختم ہونے سے کم از کم 24 گھنٹے پہلے منسوخ کریں۔ ادائیگی آپ کے Apple اکاؤنٹ سے وصول کی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Tự động gia hạn cho đến khi hủy; hủy ít nhất 24 giờ trước khi chu kỳ kết thúc. Khoản thanh toán được tính vào Tài khoản Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@。自动续订，直至取消；请至少在当前周期结束前 24 小时取消。费用将从你的 Apple 账户中扣除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@。將自動續訂，直到取消為止；請於訂閱期結束前至少 24 小時取消。費用將從你的 Apple 帳號扣款。"
          }
        }
      }
    },
