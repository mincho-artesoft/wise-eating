        },
        "uk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ця вправа використовується в %lld тренуванні або плані тренувань.\nЯкщо її видалити, вона буде вилучена з цих тренувань і планів.\n\nВи впевнені, що хочете продовжити?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ця вправа використовується в %lld тренуваннях або планах тренувань.\nЯкщо її видалити, вона буде вилучена з цих тренувань і планів.\n\nВи впевнені, що хочете продовжити?"
                }
