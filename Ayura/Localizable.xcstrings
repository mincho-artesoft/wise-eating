            "value": "Aún no has vinculado este ejercicio a ninguna nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä linkittänyt tätä harjoitusta mihinkään muistiinpanoon."
