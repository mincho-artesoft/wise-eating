    "Upgrade to the %@ plan to unlock and use this profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالترقية إلى خطة %@ لفتح هذا الملف الشخصي واستخدامه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премини към плана %@, за да отключиш и използваш този профил."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রোফাইলটি আনলক ও ব্যবহার করতে %@ প্ল্যানে আপগ্রেড করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa al pla %@ per desbloquejar i fer servir aquest perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li tento profil odemknout a používat, přejděte na tarif %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgrader til %@-planen for at låse op for og bruge denne profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein Upgrade auf den %@-Tarif durch, um dieses Profil freizuschalten und zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβάθμισε στο πρόγραμμα %@ για να ξεκλειδώσεις και να χρησιμοποιήσεις αυτό το προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza al plan %@ para desbloquear y usar este perfil."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza al plan %@ para desbloquear y usar este perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä %@-tilaukseen, jotta voit avata tämän profiilin ja käyttää sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe au forfait %@ pour débloquer et utiliser ce profil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez au forfait %@ pour déverrouiller et utiliser ce profil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રોફાઇલ અનલૉક કરવા અને તેનો ઉપયોગ કરવા માટે %@ પ્લાન પર અપગ્રેડ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שדרג לתוכנית %@ כדי לפתוח פרופיל זה ולהשתמש בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल को अनलॉक करने और उपयोग करने के लिए %@ प्लान में अपग्रेड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadogradi na plan %@ za otključavanje i korištenje ovog profila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts %@ csomagra a profil feloldásához és használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkatkan ke paket %@ untuk membuka dan menggunakan profil ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa al piano %@ per sbloccare e usare questo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールをロック解除して使用するには、%@プランにアップグレードしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл профильдің құлпын ашып, пайдалану үшін %@ жоспарына өтіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಿ ಬಳಸಲು %@ ಯೋಜನೆಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필을 잠금 해제하고 사용하려면 %@ 플랜으로 업그레이드하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രൊഫൈൽ അൺലോക്ക് ചെയ്ത് ഉപയോഗിക്കാൻ %@ പ്ലാനിലേക്ക് അപ്ഗ്രേഡ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे प्रोफाइल अनलॉक करण्यासाठी आणि वापरण्यासाठी %@ प्लॅनवर अपग्रेड करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Naik taraf ke pelan %@ untuk membuka kunci dan menggunakan profil ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgrader til %@-planen for å låse opp og bruke denne profilen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade naar het %@-abonnement om dit profiel te ontgrendelen en te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପ୍ରୋଫାଇଲ୍ ଅନଲକ୍ ଏବଂ ବ୍ୟବହାର କରିବାକୁ %@ ପ୍ଲାନ୍‌କୁ ଅପଗ୍ରେଡ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪ੍ਰੋਫਾਈਲ ਨੂੰ ਅਨਲਾਕ ਕਰਨ ਅਤੇ ਵਰਤਣ ਲਈ %@ ਪਲਾਨ 'ਤੇ ਅੱਪਗ੍ਰੇਡ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź na plan %@, aby odblokować ten profil i z niego korzystać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça upgrade para o plano %@ para desbloquear e usar este perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza para o plano %@ para desbloquear e usar este perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Treci la planul %@ pentru a debloca și folosi acest profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите на тариф «%@», чтобы разблокировать и использовать этот профиль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete tento profil odomknúť a používať, prejdite na plán %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgradite na paket %@, da odklenete in uporabljate ta profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgradera till planen %@ för att låsa upp och använda den här profilen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுயவிவரத்தைத் திறந்து பயன்படுத்த %@ திட்டத்திற்கு மேம்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రొఫైల్‌ను అన్‌లాక్ చేసి ఉపయోగించడానికి %@ ప్లాన్‌కు అప్‌గ్రేడ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเกรดเป็นแผน %@ เพื่อปลดล็อกและใช้งานโปรไฟล์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin kilidini açmak ve profili kullanmak için %@ planına yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть на план %@, щоб розблокувати та використовувати цей профіль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پروفائل کو ان لاک کرنے اور استعمال کرنے کے لیے %@ پلان پر اپ گریڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng cấp lên gói %@ để mở khóa và sử dụng hồ sơ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到 %@ 方案即可解锁并使用此档案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級至 %@ 方案即可解鎖並使用此個人檔案。"
          }
        }
      }
    },
