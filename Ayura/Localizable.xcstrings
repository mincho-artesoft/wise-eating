        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई यह प्रशिक्षण योजना हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati ovaj plan treninga? Ova se radnja ne može poništiti."
