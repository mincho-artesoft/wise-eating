    "Create your first list by tapping the “+” button below.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ قائمتك الأولى بالضغط على زر «+» أدناه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създай първия си списък, като докоснеш бутона „+“ долу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের “+” বোতামে ট্যাপ করে আপনার প্রথম তালিকা তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea la teva primera llista tocant el botó «+» de sota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte si první seznam klepnutím na tlačítko „+“ níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret din første liste ved at trykke på “+”-knappen nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle deine erste Liste, indem du unten auf „+“ tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε την πρώτη σου λίστα πατώντας το κουμπί «+» παρακάτω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu primera lista tocando el botón «+» de abajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu primera lista tocando el botón “+” de abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ensimmäinen listasi napauttamalla alla olevaa ”+”-painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée ta première liste en appuyant sur le bouton « + » ci-dessous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez votre première liste en touchant le bouton « + » ci-dessous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચેના “+” બટન પર ટૅપ કરીને તમારી પહેલી યાદી બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור את הרשימה הראשונה שלך בהקשה על כפתור ה-“+” למטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दिए गए “+” बटन पर टैप करके अपनी पहली सूची बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izradi svoj prvi popis dodirom na gumb „+“ ispod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozd létre az első listádat az alábbi „+” gombra koppintva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat daftar pertama Anda dengan mengetuk tombol “+” di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea la tua prima lista toccando il pulsante “+” qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「+」ボタンをタップして最初のリストを作成してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төмендегі «+» түймесін түрту арқылы алғашқы тізіміңізді жасаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಳಗಿನ “+” ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಮೊದಲ ಪಟ್ಟಿಯನ್ನು ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 “+” 버튼을 탭하여 첫 목록을 만드세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താഴെയുള്ള “+” ബട്ടൺ ടാപ്പ് ചെയ്ത് നിങ്ങളുടെ ആദ്യത്തെ ലിസ്റ്റ് സൃഷ്ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खालील “+” बटणावर टॅप करून तुमची पहिली यादी तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta senarai pertama anda dengan mengetik butang “+” di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett din første liste ved å trykke på «+»-knappen nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je eerste lijst door hieronder op de knop “+” te tikken."
          }
