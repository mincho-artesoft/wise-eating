          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nguyên liệu để xem bản xem trước Ayurveda trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加食材即可查看阿育吠陀实时预览。"
          }
