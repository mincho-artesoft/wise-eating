            "state": "translated",
            "value": "Бұл кезеңге бағасы көрсетілген аяқталған тізімдер табылмады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಅವಧಿಗೆ ಬೆಲೆಗಳನ್ನು ಹೊಂದಿರುವ ಪೂರ್ಣಗೊಂಡ ಪಟ್ಟಿಗಳು ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에 가격이 입력된 완료된 목록이 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ കാലയളവിൽ വിലകളുള്ള പൂർത്തിയായ ലിസ്റ്റുകളൊന്നും കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या कालावधीसाठी किमतींसह कोणतीही पूर्ण झालेली यादी आढळली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada senarai yang selesai dengan harga ditemui untuk tempoh ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fullførte lister med priser funnet for denne perioden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen voltooide lijsten met prijzen gevonden voor deze periode."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଅବଧି ପାଇଁ ମୂଲ୍ୟ ସହିତ କୌଣସି ସମ୍ପୂର୍ଣ୍ଣ ତାଲିକା ମିଳିଲା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਿਆਦ ਲਈ ਕੀਮਤਾਂ ਵਾਲੀ ਕੋਈ ਪੂਰੀ ਹੋਈ ਸੂਚੀ ਨਹੀਂ ਮਿਲੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono ukończonych list z cenami z tego okresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma lista concluída com preços foi encontrada para este período."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas listas concluídas com preços para este período."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu au fost găsite liste finalizate cu prețuri pentru această perioadă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот период не найдено завершённых списков с указанными ценами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre toto obdobie sa nenašli žiadne dokončené zoznamy s cenami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to obdobje ni zaključenih seznamov s cenami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga slutförda listor med priser hittades för den här perioden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் காலகட்டத்தில் விலைகள் கொண்ட நிறைவடைந்த பட்டியல்கள் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కాలానికి ధరలతో కూడిన పూర్తి చేసిన జాబితాలు ఏవీ కనుగొనబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบรายการที่เสร็จสมบูรณ์พร้อมราคาในช่วงเวลานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönem için fiyat girilmiş tamamlanmış liste bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цей період не знайдено завершених списків із цінами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مدت کے لیے قیمتوں والی کوئی مکمل فہرست نہیں ملی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy danh sách đã hoàn thành có giá trong khoảng thời gian này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该时间段内未找到包含价格的已完成清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此期間內找不到包含價格的已完成清單。"
          }
        }
      }
    },
