        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബാച്ച് (%@ %@, കാലാവധി: %@) ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഈ പ്രവൃത്തി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्ही ही बॅच (%@ %@, कालबाह्य: %@) हटवू इच्छिता? ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadamkan kumpulan ini (%@ %@, luput: %@)? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette dette partiet (%@ %@, utløper: %@)? Denne handlingen kan ikke angres."
