    "Over the past week or two, after meals you have most often felt?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الأسبوع أو الأسبوعين الماضيين، كيف بدا شعورك بعد الوجبات غالبًا؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През последните една-две седмици след хранене усещането ти най-често беше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত এক-দুই সপ্তাহে খাওয়ার পর বেশিরভাগ সময় আপনার কেমন লেগেছে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant les últimes una o dues setmanes, com t'has sentit més sovint després dels àpats?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak jste se za poslední týden nebo dva nejčastěji cítili po jídle?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste par uger har du efter måltider oftest følt dig?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hast du dich in den letzten ein bis zwei Wochen nach dem Essen meist gefühlt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τις τελευταίες μία με δύο εβδομάδες, μετά τα γεύματα ένιωθες πιο συχνά;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, después de comer, ¿qué has notado más a menudo?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo te has sentido más seguido después de comer?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Millainen olosi on useimmiten ollut aterioiden jälkeen viimeisen viikon tai kahden aikana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, après les repas tu t'es le plus souvent senti ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, comment vous êtes-vous le plus souvent senti après les repas?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા એક-બે અઠવાડિયામાં, ભોજન પછી તમને મોટે ભાગે કેવું લાગ્યું છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשבוע או בשבועיים האחרונים, איך הרגשת לרוב אחרי ארוחות?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक-दो सप्ताह में भोजन के बाद आपको अधिकतर कैसा लगा?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako ti je najčešće bilo nakon obroka u proteklih tjedan ili dva?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt egy-két hétben milyen volt az érzésed étkezések után?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama satu atau dua minggu terakhir, setelah makan Anda paling sering merasa?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'ultima settimana o due, cosa hai avvertito più spesso dopo i pasti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここ1〜2週間、食後に最もよく感じたのはどれですか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы бір-екі аптада тамақтан кейін өзіңізді көбінесе қалай сезіндіңіз?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಒಂದು ಅಥವಾ ಎರಡು ವಾರಗಳಿಂದ, ಊಟದ ನಂತರ ನಿಮಗೆ ಹೆಚ್ಚಾಗಿ ಹೇಗೆ ಅನಿಸಿದೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 1~2주 동안 식후에 가장 자주 느낀 상태는 무엇인가요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ ഒന്നോ രണ്ടോ ആഴ്ചയായി, ഭക്ഷണത്തിന് ശേഷം നിങ്ങൾക്ക് മിക്കപ്പോഴും എന്ത് തോന്നിയിട്ടുണ്ട്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या एक-दोन आठवड्यांत जेवणानंतर तुम्हाला बहुतेकदा कसे वाटले?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang satu atau dua minggu lalu, selepas makan anda paling kerap berasa?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De siste én til to ukene har du etter måltider oftest følt deg?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe voelde je je de afgelopen week of twee meestal na maaltijden?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତ ଏକ ବା ଦୁଇ ସପ୍ତାହରେ, ଭୋଜନ ପରେ ଆପଣ ଅଧିକାଂଶ ସମୟରେ କିପରି ଅନୁଭବ କରିଛନ୍ତି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਇੱਕ-ਦੋ ਹਫ਼ਤਿਆਂ ਵਿੱਚ, ਖਾਣੇ ਤੋਂ ਬਾਅਦ ਤੁਹਾਨੂੰ ਅਕਸਰ ਕਿਵੇਂ ਮਹਿਸੂਸ ਹੋਇਆ ਹੈ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najczęściej pojawiało się po posiłkach w ciągu ostatniego tygodnia lub dwóch?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, após as refeições você geralmente se sentiu?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, como te tens sentido mais vezes após as refeições?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultimele una-două săptămâni, cum te-ai simțit cel mai des după mese?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы чаще всего чувствовали после еды в последние неделю-две?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ste sa za posledný týždeň alebo dva najčastejšie cítili po jedle?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako ste se v zadnjem tednu ali dveh najpogosteje počutili po obrokih?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur har du oftast känt dig efter måltider under de senaste en till två veckorna?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த ஒரு வாரம் அல்லது இரண்டு வாரங்களில், உணவுக்குப் பிறகு பெரும்பாலும் எப்படி உணர்ந்தீர்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత ఒకటి రెండు వారాలుగా, భోజనం తర్వాత మీకు ఎక్కువగా ఎలా అనిపించింది?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในช่วงสัปดาห์หรือสองสัปดาห์ที่ผ่านมา หลังมื้ออาหารคุณมักรู้สึกอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir iki haftada yemeklerden sonra en sık nasıl hissettiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Протягом останніх тижня-двох після їжі ви найчастіше відчували?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گزشتہ ایک دو ہفتوں میں کھانے کے بعد آپ نے اکثر کیسا محسوس کیا ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong một hoặc hai tuần qua, sau bữa ăn bạn thường cảm thấy thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一两周里，饭后你最常感觉？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一兩週，飯後你最常感覺如何？"
          }
        }
      }
    },
