    "This will add meals for %lld day(s), starting from %@. How should meals for a specific time slot be added?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إضافة وجبات لمدة %lld من الأيام، بدءًا من %@. كيف تريد إضافة الوجبات لفترة زمنية محددة؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще добави хранения за %lld ден/дни, считано от %@. Как да бъдат добавени храненията за конкретен часови интервал?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে %2$@ তারিখ থেকে শুরু করে %1$lld দিনের খাবার যোগ হবে। কোনো নির্দিষ্ট সময়ের খাবারের স্লটে খাবার কীভাবে যোগ করা হবে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això afegirà àpats per a %lld dia/dies, a partir del %@. Com s'han d'afegir els àpats d'una franja horària específica?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto přidáte jídla (počet dní: %lld) počínaje datem %@. Jak se mají přidat jídla pro konkrétní časový úsek?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil tilføje måltider for %lld dag(e) fra og med %@. Hvordan skal måltider for et bestemt tidsrum tilføjes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Mahlzeiten für %lld Tag(e) ab dem %@ hinzugefügt. Wie sollen Mahlzeiten für ein bestimmtes Zeitfenster hinzugefügt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα προστεθούν γεύματα για %lld ημέρα/-ες, αρχίζοντας από %@. Πώς να προστεθούν τα γεύματα για μια συγκεκριμένη ώρα;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirán comidas para %lld día(s) a partir del %@. ¿Cómo quieres añadir las comidas de una franja horaria concreta?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto agregará comidas para %lld día(s), a partir del %@. ¿Cómo quieres agregar las comidas para un horario específico?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lisää ateriat %lld päiväksi alkaen %@. Miten tietyn aikavälin ateriat lisätään?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera des repas pour %lld jour(s), à partir du %@. Comment ajouter les repas pour un créneau horaire précis ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera des repas pour %lld jour(s), à partir du %@. Comment les repas d'une plage horaire précise doivent-ils être ajoutés?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ %2$@ થી શરૂ કરીને %1$lld દિવસ માટે ભોજન ઉમેરશે. ચોક્કસ સમય સ્લોટ માટે ભોજન કેવી રીતે ઉમેરવું જોઈએ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תוסיף ארוחות עבור %lld יום/ימים, החל מ-%@. כיצד להוסיף ארוחות למשבצת זמן מסוימת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %2$@ से शुरू होकर %1$lld दिन के लिए भोजन जुड़ेंगे। किसी विशेष समय स्लॉट के लिए भोजन कैसे जोड़े जाएं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim će se dodati obroci za %lld dan(a), počevši od %@. Kako treba dodati obroke za određeni termin?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel %lld napra adsz hozzá étkezéseket, %@ kezdődátummal. Hogyan szeretnéd hozzáadni az adott idősáv étkezéseit?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambahkan waktu makan untuk %lld hari, mulai dari %@. Bagaimana waktu makan untuk slot waktu tertentu harus ditambahkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno aggiunti i pasti per %lld giorno/i, a partire da %@. Come vuoi aggiungere i pasti per una fascia oraria specifica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@から%1$lld日分の食事を追加します。特定の時間帯の食事をどのように追加しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %2$@ күнінен бастап %1$lld күнге тағамдар қосады. Белгілі бір уақыт аралығына тағамдар қалай қосылсын?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %2$@ ರಿಂದ ಪ್ರಾರಂಭಿಸಿ, %1$lld ದಿನ(ಗಳ) ಊಟಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ. ನಿರ್ದಿಷ್ಟ ಸಮಯದ ಸ್ಲಾಟ್‌ಗೆ ಊಟಗಳನ್ನು ಹೇಗೆ ಸೇರಿಸಬೇಕು?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@부터 %1$lld일치 식사를 추가합니다. 특정 시간대의 식사를 어떻게 추가할까요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %lld ദിവസത്തേക്കുള്ള ഭക്ഷണങ്ങൾ %@ മുതൽ ചേർക്കും. ഒരു പ്രത്യേക സമയത്തേക്കുള്ള ഭക്ഷണങ്ങൾ എങ്ങനെയാണ് ചേർക്കേണ്ടത്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे %2$@ पासून %1$lld दिवस जेवण जोडले जाईल. विशिष्ट वेळेसाठी जेवण कसे जोडायचे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambah hidangan untuk %lld hari, bermula dari %@. Bagaimanakah hidangan untuk slot masa tertentu harus ditambah?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette legger til måltider for %lld dag(er), fra og med %@. Hvordan skal måltider for et bestemt tidsrom legges til?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden maaltijden voor %lld dag(en) toegevoegd vanaf %@. Hoe moeten maaltijden voor een specifiek tijdvak worden toegevoegd?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ଠାରୁ ଆରମ୍ଭ କରି ଏହା %1$lld ଦିନ ପାଇଁ ଭୋଜନ ଯୋଡ଼ିବ। ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ସମୟ ସ୍ଲଟ୍ ପାଇଁ ଭୋଜନ କିପରି ଯୋଡ଼ାଯିବ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ %2$@ ਤੋਂ ਸ਼ੁਰੂ ਕਰਕੇ %1$lld ਦਿਨਾਂ ਲਈ ਭੋਜਨ ਜੋੜੇਗਾ। ਕਿਸੇ ਖਾਸ ਸਮੇਂ ਦੇ ਸਲਾਟ ਲਈ ਭੋਜਨ ਕਿਵੇਂ ਜੋੜੇ ਜਾਣੇ ਚਾਹੀਦੇ ਹਨ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to dodanie posiłków (liczba dni: %lld), począwszy od %@. Jak dodać posiłki dla konkretnej pory dnia?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso adicionará refeições para %lld dia(s), a partir de %@. Como as refeições de um horário específico devem ser adicionadas?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá adicionar refeições para %lld dia(s), a partir de %@. Como devem ser adicionadas as refeições para um horário específico?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor adăuga mese pentru %lld zi(le), începând cu %@. Cum să fie adăugate mesele pentru un anumit interval orar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут добавлены приёмы пищи на %lld дн., начиная с %@. Как добавить приёмы пищи на конкретное время?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa pridajú jedlá na tento počet dní: %lld (od %@). Ako sa majú pridať jedlá pre konkrétny časový úsek?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste dodali obroke (št. dni: %lld) z začetkom %@. Kako želite dodati obroke za določen časovni termin?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta lägger till måltider för %lld dag(ar), med start %@. Hur ska måltider för en specifik tidslucka läggas till?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ முதல் %1$lld நாட்களுக்கான உணவுகள் சேர்க்கப்படும். ஒரு குறிப்பிட்ட நேரத்திற்கான உணவுகளை எவ்வாறு சேர்க்க வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %2$@ నుండి ప్రారంభించి, %1$lld రోజు(ల)కు భోజనాలను జోడిస్తుంది. ఒక నిర్దిష్ట సమయానికి భోజనాలను ఎలా జోడించాలి?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเพิ่มมื้ออาหารเป็นเวลา %lld วัน เริ่มตั้งแต่วันที่ %@ คุณต้องการเพิ่มมื้ออาหารสำหรับช่วงเวลาเดียวกันอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %2$@ tarihinden başlayarak %1$lld gün için öğün ekleyecektir. Belirli bir zaman dilimine ait öğünler nasıl eklensin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це додасть прийоми їжі на %lld дн., починаючи з %@. Як додавати прийоми їжі для певного часу?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %2$@ سے شروع کرتے ہوئے %1$lld دن کے لیے کھانے شامل کرے گا۔ کسی مخصوص وقت کے لیے کھانے کس طرح شامل کیے جائیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thêm các bữa ăn cho %lld ngày, bắt đầu từ %@. Bạn muốn thêm các bữa ăn vào khung giờ cụ thể như thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 %2$@ 开始添加 %1$lld 天的餐食。应如何添加特定时段的餐食？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從 %2$@ 開始，新增 %1$lld 天的餐點。請問應如何新增特定時段的餐點？"
          }
        }
      }
    },
