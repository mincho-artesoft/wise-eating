    "You'll be notified when your menu is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك إشعار عندما تكون قائمتك جاهزة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще получиш известие, когато менюто ти е готово."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মেনু তৈরি হয়ে গেলে আপনাকে জানানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebràs una notificació quan el teu menú estigui llest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile bude vaše menu připraveno, dostanete oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får besked, når din menu er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst benachrichtigt, sobald dein Menü fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ειδοποιηθείς όταν το μενού σου είναι έτοιμο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás una notificación cuando tu menú esté listo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Te notificaremos cuando tu menú esté listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun menusi on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recevras une notification lorsque ton menu sera prêt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une notification lorsque votre menu sera prêt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તમારું મેનુ તૈયાર થશે ત્યારે તમને સૂચિત કરવામાં આવશે."
          }
        },
        "he": {
