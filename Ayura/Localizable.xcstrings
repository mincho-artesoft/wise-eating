    "This will add workouts for %lld day(s), starting from %@. How should workouts for a specific time slot be added?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إضافة تدريبات لعدد %lld من الأيام، بدءًا من %@. كيف يجب إضافة التدريبات لفترة زمنية محددة؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще добави тренировки за %lld ден/дни, считано от %@. Как да се добавят тренировките за конкретен часови интервал?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে %2$@ থেকে শুরু করে %1$lld দিনের জন্য ওয়ার্কআউট যোগ হবে। নির্দিষ্ট সময়ের জন্য ওয়ার্কআউটগুলো কীভাবে যোগ করা হবে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això afegirà entrenaments per a %lld dia/dies, a partir del %@. Com s'han d'afegir els entrenaments per a una franja horària concreta?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto přidáte tréninky (počet dní: %lld) od %@. Jak se mají přidat tréninky pro konkrétní časový úsek?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil tilføje træninger for %lld dag(e) fra %@. Hvordan skal træninger for et bestemt tidsrum tilføjes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit werden Workouts für %lld Tag(e) ab %@ hinzugefügt. Wie sollen Workouts für ein bestimmtes Zeitfenster hinzugefügt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα προσθέσει προπονήσεις για %lld ημέρα/ες, από %@. Πώς θέλεις να προστεθούν οι προπονήσεις για μια συγκεκριμένη ώρα;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto añadirá entrenamientos para %lld día(s), a partir del %@. ¿Cómo quieres añadir los entrenamientos para una franja horaria concreta?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto agregará entrenamientos para %lld día(s), a partir del %@. ¿Cómo quieres agregar los entrenamientos para un horario específico?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lisää treenit %lld päivälle alkaen %@. Miten tietylle ajankohdalle osuvat treenit lisätään?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera des entraînements pour %lld jour(s), à partir du %@. Comment ajouter les entraînements sur un même créneau horaire ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera des entraînements pour %lld jour(s), à partir du %@. Comment ajouter les entraînements pour une plage horaire donnée?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી %lld દિવસ માટે, %@ થી શરૂ કરીને વર્કઆઉટ ઉમેરવામાં આવશે. ચોક્કસ સમય સ્લોટ માટે વર્કઆઉટ કેવી રીતે ઉમેરવા જોઈએ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תוסיף אימונים למשך %lld יום/ימים, החל מ-%@. כיצד להוסיף אימונים לחלון זמן מסוים?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %2$@ से शुरू होकर %1$lld दिन के लिए वर्कआउट जुड़ेंगे। किसी विशेष समय स्लॉट के वर्कआउट कैसे जोड़े जाएँ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim će se dodati treninzi za %lld dan(a), počevši od %@. Kako dodati treninge za određeni termin?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez %lld napra ad hozzá edzéseket %@ dátummal kezdődően. Hogyan kerüljenek hozzáadásra az adott időpontra eső edzések?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambahkan latihan untuk %lld hari, dimulai dari %@. Bagaimana latihan untuk slot waktu tertentu harus ditambahkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno aggiunti allenamenti per %lld giorno/i, a partire da %@. Come vuoi aggiungere gli allenamenti per una fascia oraria specifica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@から%1$lld日分のワークアウトを追加します。特定の時間帯のワークアウトはどのように追加しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %2$@ күнінен бастап %1$lld күнге жаттығуларды қосады. Белгілі бір уақыт аралығына арналған жаттығулар қалай қосылсын?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %2$@ ರಿಂದ ಪ್ರಾರಂಭಿಸಿ %1$lld ದಿನ(ಗಳ) ವರ್ಕೌಟ್‌ಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ. ನಿರ್ದಿಷ್ಟ ಸಮಯಕ್ಕೆ ವರ್ಕೌಟ್‌ಗಳನ್ನು ಹೇಗೆ ಸೇರಿಸಬೇಕು?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@부터 %1$lld일 동안의 워크아웃이 추가됩니다. 특정 시간대의 워크아웃은 어떻게 추가할까요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %2$@ മുതൽ %1$lld ദിവസത്തേക്ക് വർക്കൗട്ടുകൾ ചേർക്കും. ഒരു നിശ്ചിത സമയത്തേക്ക് വർക്കൗട്ടുകൾ എങ്ങനെ ചേർക്കണം?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे %2$@ पासून %1$lld दिवसांसाठी वर्कआउट्स जोडले जातील. ठराविक वेळेसाठी वर्कआउट्स कसे जोडायचे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambah senaman untuk %lld hari, bermula dari %@. Bagaimanakah senaman bagi slot masa tertentu harus ditambah?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette legger til økter for %lld dag(er), fra og med %@. Hvordan skal økter for et bestemt tidspunkt legges til?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden workouts toegevoegd voor %lld dag(en), vanaf %@. Hoe moeten workouts voor een specifiek tijdslot worden toegevoegd?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା %2$@ ରୁ ଆରମ୍ଭ କରି %1$lld ଦିନ ପାଇଁ ୱାର୍କଆଉଟ୍ ଯୋଗ କରିବ। ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ସମୟ ପାଇଁ ୱାର୍କଆଉଟ୍ କିପରି ଯୋଗ କରାଯିବ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ %2$@ ਤੋਂ ਸ਼ੁਰੂ ਕਰਕੇ %1$lld ਦਿਨਾਂ ਲਈ ਵਰਕਆਊਟ ਸ਼ਾਮਲ ਹੋਣਗੇ। ਕਿਸੇ ਖ਼ਾਸ ਸਮੇਂ ਲਈ ਵਰਕਆਊਟ ਕਿਵੇਂ ਸ਼ਾਮਲ ਕੀਤੇ ਜਾਣ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to dodanie treningów (liczba dni: %lld), począwszy od %@. Jak dodać treningi dla określonej pory?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso adicionará treinos para %lld dia(s), a partir de %@. Como os treinos de um horário específico devem ser adicionados?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá adicionar treinos para %lld dia(s), a partir de %@. Como devem ser adicionados os treinos para um horário específico?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru va adăuga antrenamente pentru %lld zi(le), începând cu %@. Cum să fie adăugate antrenamentele pentru un anumit interval orar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут добавлены тренировки на %lld дн., начиная с %@. Как добавлять тренировки для конкретного временного интервала?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa pridajú tréningy (počet dní: %lld) od %@. Ako sa majú pridať tréningy pre konkrétny časový úsek?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste dodali vadbe (št. dni: %lld) z začetkom %@. Kako naj se dodajo vadbe za določen termin?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta lägger till träningspass för %lld dag(ar) med start %@. Hur ska träningspass för en viss tidpunkt läggas till?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது %2$@ முதல் %1$lld நாட்களுக்கான பயிற்சி அமர்வுகளைச் சேர்க்கும். குறிப்பிட்ட நேர இடைவெளிக்கான பயிற்சி அமர்வுகள் எவ்வாறு சேர்க்கப்பட வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %2$@ నుండి ప్రారంభించి %1$lld రోజు(ల) కోసం వర్కవుట్‌లను జోడిస్తుంది. ఒక నిర్దిష్ట సమయ స్లాట్ కోసం వర్కవుట్‌లను ఎలా జోడించాలి?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะเพิ่มการออกกำลังกายสำหรับ %lld วัน โดยเริ่มตั้งแต่วันที่ %@ คุณต้องการเพิ่มการออกกำลังกายสำหรับช่วงเวลาที่ระบุอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %2$@ tarihinden başlayarak %1$lld gün için antrenman ekleyecektir. Belirli bir zaman dilimi için antrenmanlar nasıl eklensin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде додано тренування на %lld дн., починаючи з %@. Як додавати тренування на певний часовий інтервал?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے %lld دن کے لیے ورزشیں شامل ہوں گی، جو %@ سے شروع ہوں گی۔ کسی مخصوص وقت کے سلاٹ کے لیے ورزشیں کیسے شامل کی جائیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thêm các buổi tập cho %lld ngày, bắt đầu từ %@. Bạn muốn thêm các buổi tập vào khung giờ cụ thể như thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 %2$@ 开始添加 %1$lld 天的训练。应如何添加特定时间段的训练？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從 %2$@ 開始，新增 %1$lld 天的鍛鍊。特定時段的鍛鍊應如何加入？"
          }
        }
      }
    },
