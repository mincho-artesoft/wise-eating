    "Live Activities are disabled. Enable them in Settings > Apps > Ayurveda & Asana Yoga > Live Activities.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأنشطة المباشرة معطّلة. فعّلها في الإعدادات > التطبيقات > Ayurveda & Asana Yoga > الأنشطة المباشرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активностите на живо са изключени. Включи ги в Настройки > Приложения > Ayurveda & Asana Yoga > Активности на живо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ অ্যাক্টিভিটি বন্ধ আছে। সেটিংস > অ্যাপস > Ayurveda & Asana Yoga > লাইভ অ্যাক্টিভিটি থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activitats en directe estan desactivades. Activa-les a Configuració > Apps > Ayurveda & Asana Yoga > Activitats en directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé aktivity jsou zakázány. Povolte je v Nastavení > Aplikace > Ayurveda & Asana Yoga > Živé aktivity."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveaktiviteter er slået fra. Slå dem til i Indstillinger > Apps > Ayurveda & Asana Yoga > Liveaktiviteter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind deaktiviert. Aktiviere sie unter Einstellungen > Apps > Ayurveda & Asana Yoga > Live-Aktivitäten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι Ζωντανές δραστηριότητες είναι απενεργοποιημένες. Ενεργοποίησέ τες στις Ρυθμίσεις > Εφαρμογές > Ayurveda & Asana Yoga > Ζωντανές δραστηριότητες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actividades en directo están desactivadas. Actívalas en Ajustes > Apps > Ayurveda & Asana Yoga > Actividades en directo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en vivo están desactivadas. Actívalas en Configuración > Apps > Ayurveda & Asana Yoga > Actividades en vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-toiminnot on poistettu käytöstä. Ota ne käyttöön kohdassa Asetukset > Apit > Ayurveda & Asana Yoga > Live-toiminnot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées. Active-les dans Réglages > Apps > Ayurveda & Asana Yoga > Activités en direct."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées. Activez-les dans Réglages > Apps > Ayurveda & Asana Yoga > Activités en direct."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇવ ઍક્ટિવિટી બંધ છે. સેટિંગ્સ > ઍપ્સ > Ayurveda & Asana Yoga > લાઇવ ઍક્ટિવિટી માં તેને ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעילויות בזמן אמת מושבתות. הפעל אותן בהגדרות > יישומים > Ayurveda & Asana Yoga > פעילויות בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव ऐक्टिविटीज़ अक्षम हैं। उन्हें सेटिंग्ज़ > ऐप्स > Ayurveda & Asana Yoga > लाइव ऐक्टिविटीज़ में सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivnosti uživo su isključene. Uključi ih u Postavke > Aplikacije > Ayurveda & Asana Yoga > Aktivnosti uživo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Élő tevékenységek ki vannak kapcsolva. Engedélyezd őket itt: Beállítások > Appok > Ayurveda & Asana Yoga > Élő tevékenységek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitas Langsung dinonaktifkan. Aktifkan di Pengaturan > App > Ayurveda & Asana Yoga > Aktivitas Langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività in tempo reale sono disattivate. Attivale in Impostazioni > App > Ayurveda & Asana Yoga > Attività in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティが無効になっています。「設定」>「アプリ」>「Ayurveda & Asana Yoga」>「ライブアクティビティ」で有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities өшірілген. Оларды Реттеулер > Қолданбалар > Ayurveda & Asana Yoga > Live Activities бөлімінде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈವ್ ಆ್ಯಕ್ಟಿವಿಟಿಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಆ್ಯಪ್‌ಗಳು > Ayurveda & Asana Yoga > ಲೈವ್ ಆ್ಯಕ್ಟಿವಿಟಿಗಳು ಎಂಬಲ್ಲಿ ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 현황이 꺼져 있습니다. 설정 > 앱 > Ayurveda & Asana Yoga > 실시간 현황에서 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് ആക്ടിവിറ്റികൾ പ്രവർത്തനരഹിതമാണ്. ക്രമീകരണങ്ങൾ > ആപ്പുകൾ > Ayurveda & Asana Yoga > ലൈവ് ആക്ടിവിറ്റികൾ എന്നതിൽ അവ പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव्ह ॲक्टिव्हिटी अक्षम आहेत. सेटिंग्ज > ॲप्स > Ayurveda & Asana Yoga > लाइव्ह ॲक्टिव्हिटी मध्ये जाऊन त्या सक्षम करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviti Langsung dinyahdayakan. Dayakannya dalam Seting > App > Ayurveda & Asana Yoga > Aktiviti Langsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løpende oppdateringer er deaktivert. Slå dem på i Innstillinger > Apper > Ayurveda & Asana Yoga > Løpende oppdateringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live activiteiten zijn uitgeschakeld. Schakel ze in via Instellingen > Apps > Ayurveda & Asana Yoga > Live activiteiten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଇଭ୍ ଆକ୍ଟିଭିଟି ବନ୍ଦ ଅଛି। ସେଟିଂସ୍ > ଆପ୍ସ୍ > Ayurveda & Asana Yoga > ଲାଇଭ୍ ଆକ୍ଟିଭିଟି ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਵ ਗਤੀਵਿਧੀਆਂ ਬੰਦ ਹਨ। ਇਹਨਾਂ ਨੂੰ ਸੈਟਿੰਗਾਂ > ਐਪਾਂ > Ayurveda & Asana Yoga > ਲਾਈਵ ਗਤੀਵਿਧੀਆਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia na żywo są wyłączone. Włącz je w Ustawienia > Aplikacje > Ayurveda & Asana Yoga > Wydarzenia na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Atividades ao Vivo estão desativadas. Ative-as em Ajustes > Apps > Ayurveda & Asana Yoga > Atividades ao Vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As atividades em tempo real estão desativadas. Ativa-as em Definições > Aplicações > Ayurveda & Asana Yoga > Atividades em tempo real."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activitățile live sunt dezactivate. Activează-le în Configurări > Aplicații > Ayurveda & Asana Yoga > Activități live."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эфир активности отключён. Включите его: «Настройки» > «Приложения» > Ayurveda & Asana Yoga > «Эфир активности»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivity naživo sú vypnuté. Zapnite ich v časti Nastavenia > Apky > Ayurveda & Asana Yoga > Aktivity naživo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivnosti v živo so onemogočene. Omogočite jih v Nastavitve > Aplikacije > Ayurveda & Asana Yoga > Aktivnosti v živo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveaktiviteter är inaktiverade. Aktivera dem i Inställningar > Appar > Ayurveda & Asana Yoga > Liveaktiviteter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலைச் செயல்பாடுகள் முடக்கப்பட்டுள்ளன. அமைப்புகள் > செயலிகள் > Ayurveda & Asana Yoga > நேரலைச் செயல்பாடுகள் என்பதில் அவற்றை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ యాక్టివిటీలు నిలిపివేయబడ్డాయి. సెట్టింగ్‌లు > యాప్‌లు > Ayurveda & Asana Yoga > లైవ్ యాక్టివిటీలు లో వాటిని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมสดถูกปิดใช้งาน เปิดใช้งานได้ที่ การตั้งค่า > แอป > Ayurveda & Asana Yoga > กิจกรรมสด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı Etkinlikler devre dışı. Ayarlar > Uygulamalar > Ayurveda & Asana Yoga > Canlı Etkinlikler yolundan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дії наживо вимкнено. Увімкніть їх у Параметри > Програми > Ayurveda & Asana Yoga > Дії наживо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو سرگرمیاں غیر فعال ہیں۔ انہیں سیٹنگز > ایپس > Ayurveda & Asana Yoga > لائیو سرگرمیاں میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động trực tiếp đang tắt. Hãy bật trong Cài đặt > Ứng dụng > Ayurveda & Asana Yoga > Hoạt động trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动已禁用。请在“设置” > “App” > “Ayurveda & Asana Yoga” > “实时活动”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態已停用。請前往「設定」>「App」>「Ayurveda & Asana Yoga」>「即時動態」啟用。"
          }
        }
      }
    },
