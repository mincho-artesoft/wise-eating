        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्हाला तुमच्या वर्कआउटमधून '%@' हटवायचे आहे? ही कृती पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadam '%@' daripada senaman anda? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette «%@» fra økten din? Denne handlingen kan ikke angres."
