        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'+' 버튼을 탭하여 첫 트레이닝 플랜을 만들어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ആദ്യത്തെ പരിശീലന പ്ലാൻ സൃഷ്ടിക്കാൻ '+' ബട്ടൺ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची पहिली प्रशिक्षण योजना तयार करण्यासाठी '+' बटणावर टॅप करा."
