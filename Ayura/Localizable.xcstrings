    "Uses digestibility and agni effect together.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم قابلية الهضم وتأثير أغني معًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва смилаемостта и ефекта върху агни заедно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাচ্যতা ও অগ্নির প্রভাব একসাথে ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina la digestibilitat i l'efecte sobre l'agni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Využívá stravitelnost a účinek na agni společně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger fordøjelighed og agni-effekt sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniert Verdaulichkeit und Agni-Wirkung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδυάζει την πεπτικότητα και την επίδραση στο άγκνι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina la digestibilidad y el efecto sobre el agni."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa en conjunto la digestibilidad y el efecto en agni."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää yhdessä sulavuutta ja agni-vaikutusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise ensemble la digestibilité et l'effet sur l'agni."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine la digestibilité et l'effet sur agni."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાચ્યતા અને અગ્નિ અસરનો એકસાથે ઉપયોગ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משלב יחד קלות עיכול והשפעה על האגני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाचनीयता और अग्नि प्रभाव का एक साथ उपयोग करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajedno koristi probavljivost i učinak na agni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emészthetőséget és az agni-hatást együtt veszi figyelembe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan tingkat kecernaan dan efek agni secara bersamaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa insieme digeribilità ed effetto sull'agni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消化のしやすさとアグニへの影響を合わせて判定します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіңімділік пен агни әсерін бірге ескереді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೀರ್ಣಸಾಧ್ಯತೆ ಮತ್ತು ಅಗ್ನಿ ಪರಿಣಾಮವನ್ನು ಒಟ್ಟಿಗೆ ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소화 용이성과 아그니 효과를 함께 반영합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദഹനക്ഷമതയും അഗ്നി ഫലവും ഒരുമിച്ച് ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पचनीयता आणि अग्नि परिणाम एकत्र वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan kebolehcernaan dan kesan agni bersama-sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker fordøyelighet og agni-effekt sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt verteerbaarheid en agni-effect samen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାଚନଯୋଗ୍ୟତା ଏବଂ ଅଗ୍ନି ପ୍ରଭାବକୁ ଏକାଠି ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਚਨਸ਼ੀਲਤਾ ਅਤੇ ਅਗਨੀ ਪ੍ਰਭਾਵ ਨੂੰ ਇਕੱਠੇ ਵਰਤਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy strawność oraz wpływ na agni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a digestibilidade e o efeito no agni juntos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina a digestibilidade com o efeito no agni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește împreună digestibilitatea și efectul agni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывает усвояемость и влияние на агни."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Využíva stráviteľnosť spolu s účinkom na agni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupaj uporablja prebavljivost in učinek na agni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder smältbarhet och agni-effekt tillsammans."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செரிமானத் தன்மையையும் அக்னி விளைவையும் ஒன்றாகப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జీర్ణమయ్యే గుణాన్ని మరియు అగ్ని ప్రభావాన్ని కలిపి ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ความสามารถในการย่อยและผลต่ออัคนีร่วมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sindirilebilirlik ve agni etkisini birlikte kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховує засвоюваність і вплив на агні разом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہضم ہونے کی صلاحیت اور اگنی کے اثر کو ایک ساتھ استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết hợp khả năng tiêu hóa và tác động lên agni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结合消化度与阿格尼影响综合评估。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
