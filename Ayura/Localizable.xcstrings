        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieser Ernährungsplan hat %lld verknüpftes Menü.\n\n• „Nur Plan löschen“ entfernt den Plan, behält das Menü aber überall dort bei, wo es verwendet wird.\n• „Plan & Menüs löschen“ löscht sowohl den Plan als auch dieses verknüpfte Menü.\n\nWas möchtest du tun?"
                }
              },
              "other": {
                "stringUnit": {
