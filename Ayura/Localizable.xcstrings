        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "यह खाद्य पदार्थ %lld व्यंजन, मेनू या भोजन योजना में उपयोग किया गया है।\nयदि आप इसे हटाते हैं, तो यह उस स्थान से हट जाएगा।\n\nक्या आप वाकई जारी रखना चाहते हैं?"
                }
