    "Create an Ayurvedic profile for %@ to see personal fit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ ملفًا أيورفيديًا لـ %@ لمعرفة مدى الملاءمة الشخصية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създай аюрведичен профил за %@, за да видиш личното съвпадение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিগত উপযুক্ততা দেখতে %@-এর জন্য একটি আয়ুর্বেদিক প্রোফাইল তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil ayurvèdic per a %@ per veure l'afinitat personal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte ájurvédský profil pro %@, abyste viděli osobní vhodnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ayurvedisk profil for %@ for at se personligt match."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
