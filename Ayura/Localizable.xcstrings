    "Uses USDA foods, respecting your allergens and nutrient priorities.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم أطعمة USDA، مع مراعاة مسببات الحساسية والعناصر الغذائية ذات الأولوية لديك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва храни от USDA, като се съобразява с алергените ти и приоритетните нутриенти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যালার্জেন ও পুষ্টি উপাদানের অগ্রাধিকার বিবেচনায় রেখে USDA খাবার ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa servir aliments de l'USDA, respectant els teus al·lèrgens i les teves prioritats de nutrients."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá potraviny USDA a zohledňuje vaše alergeny i priority živin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger USDA-fødevarer og tager hensyn til dine allergener og næringsstofprioriteter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet USDA-Lebensmittel unter Berücksichtigung deiner Allergene und Nährstoffprioritäten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί τροφές USDA, λαμβάνοντας υπόψη τα αλλεργιογόνα και τις προτεραιότητές σου σε θρεπτικά συστατικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos del USDA, respetando tus alérgenos y prioridades de nutrientes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos del USDA, respetando tus alérgenos y prioridades de nutrientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää USDA-ruokia huomioiden allergeenisi ja ravintoaineprioriteettisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les aliments USDA, en respectant tes allergènes et tes priorités nutritionnelles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les aliments USDA en tenant compte de vos allergènes et de vos priorités en nutriments."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા એલર્જન્સ અને પોષક તત્વોની પ્રાથમિકતાઓને ધ્યાનમાં રાખીને USDA ખોરાકનો ઉપયોગ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש במזונות מ-USDA, תוך התחשבות באלרגנים ובסדרי העדיפויות התזונתיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके एलर्जेन और पोषक तत्व प्राथमिकताओं का ध्यान रखते हुए USDA खाद्य पदार्थों का उपयोग करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi USDA namirnice, uzimajući u obzir tvoje alergene i prioritete nutrijenata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "USDA-élelmiszereket használ, figyelembe véve az allergénjeidet és a tápanyag-prioritásaidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan makanan USDA, dengan memperhatikan alergen dan prioritas nutrisi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimenti USDA, tenendo conto dei tuoi allergeni e delle tue priorità nutrizionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アレルゲンと優先栄養素に配慮し、USDAの食品データを使用します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аллергендеріңіз бен нутриент басымдықтарыңызды ескере отырып, USDA өнімдерін пайдаланады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಅಲರ್ಜಿಕಾರಕಗಳು ಮತ್ತು ಪೋಷಕಾಂಶ ಆದ್ಯತೆಗಳನ್ನು ಗಮನದಲ್ಲಿಟ್ಟುಕೊಂಡು USDA ಆಹಾರಗಳನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USDA 식품을 사용하며, 알레르기 성분과 우선 영양소를 반영합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അലർജനുകളും പോഷക മുൻഗണനകളും പരിഗണിച്ച് USDA ഭക്ഷണങ്ങൾ ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या ॲलर्जी घटकांचा आणि प्राधान्य पोषक घटकांचा विचार करून USDA अन्नपदार्थ वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan makanan USDA dengan mengambil kira alergen dan keutamaan nutrien anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker USDA-matvarer og tar hensyn til allergenene og næringsstoffprioriteringene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt USDA-voedingsmiddelen, rekening houdend met je allergenen en prioriteiten voor voedingsstoffen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଆଲର୍ଜେନ୍ ଏବଂ ପୋଷକ ତତ୍ତ୍ୱ ପ୍ରାଥମିକତାକୁ ଧ୍ୟାନରେ ରଖି USDA ଖାଦ୍ୟ ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਐਲਰਜਨਾਂ ਅਤੇ ਪੋਸ਼ਕ ਤੱਤਾਂ ਦੀਆਂ ਤਰਜੀਹਾਂ ਦਾ ਧਿਆਨ ਰੱਖਦੇ ਹੋਏ USDA ਭੋਜਨਾਂ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z produktów USDA, uwzględniając Twoje alergeny i priorytety składników odżywczych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos do USDA, respeitando seus alérgenos e prioridades de nutrientes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos do USDA, respeitando os teus alergénios e prioridades nutricionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește alimente USDA, respectând alergenii și prioritățile tale nutriționale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует продукты USDA с учётом ваших аллергенов и приоритетных нутриентов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používa potraviny USDA a rešpektuje vaše alergény a priority živín."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporablja živila USDA ter upošteva vaše alergene in prednostna hranila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder USDA-livsmedel och tar hänsyn till dina allergener och näringsprioriteringar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஒவ்வாமைப் பொருட்களையும் ஊட்டச்சத்து முன்னுரிமைகளையும் கருத்தில் கொண்டு USDA உணவுகளைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అలర్జీ కారకాలు మరియు పోషక ప్రాధాన్యతలను దృష్టిలో ఉంచుకుని, USDA ఆహారాలను ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อาหารจาก USDA โดยคำนึงถึงสารก่อภูมิแพ้และสารอาหารสำคัญของคุณ"
          }
