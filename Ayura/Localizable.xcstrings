    "No completed lists with prices found for this period.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على قوائم مكتملة بأسعار لهذه الفترة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма намерени завършени списъци с цени за този период."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সময়ের জন্য মূল্যসহ কোনো সম্পন্ন তালিকা পাওয়া যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han trobat llistes completades amb preus per a aquest període."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro toto období nebyly nalezeny žádné dokončené seznamy s cenami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fuldførte lister med priser fundet for denne periode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Zeitraum wurden keine abgeschlossenen Listen mit Preisen gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν ολοκληρωμένες λίστες με τιμές για αυτή την περίοδο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron listas completadas con precios para este periodo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron listas completadas con precios para este periodo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tältä ajanjaksolta ei löytynyt valmiita listoja, joissa on hintoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste terminée avec des prix n'a été trouvée pour cette période."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste terminée avec des prix n'a été trouvée pour cette période."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સમયગાળા માટે કિંમતો સાથેની કોઈ પૂર્ણ થયેલી યાદી મળી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו רשימות שהושלמו עם מחירים לתקופה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अवधि के लिए कीमतों वाली कोई पूर्ण सूची नहीं मिली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovo razdoblje nisu pronađeni dovršeni popisi s cijenama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található árakat tartalmazó, befejezett lista erre az időszakra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan daftar selesai dengan harga untuk periode ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna lista completata con prezzi trovata per questo periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間に価格が記録された完了済みリストが見つかりません。"
