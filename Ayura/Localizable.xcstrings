        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ez az élelmiszer %lld receptben, menüben vagy étkezési tervben szerepel.\nHa törlöd, arról a helyről is törlődik.\n\nBiztosan folytatod?"
