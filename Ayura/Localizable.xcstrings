            "value": "હજી સુધી પૂરતી ઓળખી શકાય તેવી સામગ્રી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מספיק מרכיבים מזוהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पर्याप्त पहचानी जाने योग्य सामग्री नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema dovoljno prepoznatljivih sastojaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs elég felismerhető összetevő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum cukup bahan yang dikenali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza ingredienti riconoscibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識できる材料がまだ十分ではありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Танылатын ингредиенттер әлі жеткіліксіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಸಾಕಷ್ಟು ಗುರುತಿಸಬಹುದಾದ ಪದಾರ್ಥಗಳಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식 가능한 재료가 아직 충분하지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരിച്ചറിയാവുന്ന ചേരുവകൾ ഇതുവരെ മതിയാകുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्याप पुरेसे ओळखण्यायोग्य घटक नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahan yang boleh dikenal pasti masih belum mencukupi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok gjenkjennelige ingredienser ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg herkenbare ingrediënten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ ଯଥେଷ୍ଟ ଚିହ୍ନଟଯୋଗ୍ୟ ଉପାଦାନ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਜੇ ਪਛਾਣਨਯੋਗ ਸਮੱਗਰੀ ਕਾਫ਼ੀ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało rozpoznawalnych składników."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há ingredientes reconhecíveis suficientes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há ingredientes reconhecíveis suficientes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu sunt suficiente ingrediente recunoscute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно распознанных ингредиентов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nie je dosť rozpoznateľných ingrediencií."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni dovolj prepoznavnih sestavin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med igenkännbara ingredienser ännu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடையாளம் காணக்கூடிய பொருட்கள் இன்னும் போதுமானதாக இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తించదగిన పదార్థాలు ఇంకా సరిపడా లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีวัตถุดิบที่ระบุได้ไม่เพียงพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yeterince tanınabilir malzeme yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що недостатньо розпізнаних інгредієнтів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کافی قابل شناخت اجزاء موجود نہیں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đủ nguyên liệu có thể nhận diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可识别的食材尚不足。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無足夠的可辨識食材。"
          }
        }
      }
    },
