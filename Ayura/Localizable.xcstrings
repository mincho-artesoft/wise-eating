    "All workouts for all days already have exercises. Clear some workouts if you want to generate new ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع التدريبات لكل الأيام تحتوي بالفعل على تمارين. امسح بعض التدريبات إذا كنت تريد توليد تدريبات جديدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички тренировки за всички дни вече имат упражнения. Изчисти някои тренировки, ако искаш да генерираш нови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব দিনের সব ওয়ার্কআউটে ইতিমধ্যেই ব্যায়াম রয়েছে। নতুন ব্যায়াম তৈরি করতে চাইলে কিছু ওয়ার্কআউট খালি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els entrenaments de tots els dies ja tenen exercicis. Buida alguns entrenaments si en vols generar de nous."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny tréninky pro všechny dny již obsahují cviky. Pokud chcete vygenerovat nové, některé tréninky vymažte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle træninger på alle dage har allerede øvelser. Ryd nogle træninger, hvis du vil generere nye."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Workouts für alle Tage enthalten bereits Übungen. Leere einige Workouts, wenn du neue generieren möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι προπονήσεις για όλες τις ημέρες έχουν ήδη ασκήσεις. Άδειασε μερικές προπονήσεις αν θέλεις να δημιουργήσεις νέες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los entrenamientos de todos los días ya tienen ejercicios. Vacía algunos entrenamientos si quieres generar otros nuevos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los entrenamientos de todos los días ya tienen ejercicios. Vacía algunos entrenamientos si quieres generar otros nuevos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikissa kaikkien päivien treeneissä on jo harjoituksia. Tyhjennä joitakin treenejä, jos haluat luoda uusia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les entraînements de tous les jours contiennent déjà des exercices. Vide certains entraînements si tu veux en générer de nouveaux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les entraînements de tous les jours contiennent déjà des exercices. Videz certains entraînements si vous voulez en générer de nouveaux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધા દિવસોના તમામ વર્કઆઉટ્સમાં પહેલેથી જ કસરતો છે. જો તમે નવું જનરેટ કરવા માંગતા હો, તો કેટલાક વર્કઆઉટ્સ સાફ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכל האימונים בכל הימים כבר יש תרגילים. נקה חלק מהאימונים אם תרצה ליצור חדשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी दिनों के सभी वर्कआउट में पहले से ही व्यायाम हैं। यदि आप नए व्यायाम बनाना चाहते हैं, तो कुछ वर्कआउट साफ़ करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi treninzi za sve dane već imaju vježbe. Očisti neke treninge ako želiš generirati nove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden nap minden edzéséhez tartozik már gyakorlat. Törölj néhány edzést, ha újakat szeretnél generálni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua latihan untuk semua hari sudah memiliki gerakan. Kosongkan beberapa latihan jika Anda ingin membuat yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli allenamenti di tutti i giorni contengono già degli esercizi. Svuota alcuni allenamenti se vuoi generarne di nuovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての日のすべてのワークアウトにすでにエクササイズが登録されています。新しく生成するには、いくつかのワークアウトをクリアしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық күндердегі барлық жаттығу кешендерінде жаттығулар бар. Жаңаларын жасағыңыз келсе, кейбірін тазалаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ದಿನಗಳ ಎಲ್ಲಾ ವರ್ಕೌಟ್‌ಗಳಲ್ಲಿ ಈಗಾಗಲೇ ವ್ಯಾಯಾಮಗಳಿವೆ. ನೀವು ಹೊಸದನ್ನು ರಚಿಸಲು ಬಯಸಿದರೆ ಕೆಲವು ವರ್ಕೌಟ್‌ಗಳನ್ನು ತೆರವುಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 날의 모든 워크아웃에 이미 운동이 있습니다. 새로 생성하려면 일부 워크아웃을 비워 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ദിവസങ്ങളിലെയും എല്ലാ വർക്കൗട്ടുകളിലും ഇതിനകം വ്യായാമങ്ങൾ ഉണ്ട്. പുതിയവ സൃഷ്ടിക്കണമെങ്കിൽ ചില വർക്കൗട്ടുകൾ മായ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व दिवसांच्या सर्व वर्कआउट्समध्ये आधीच व्यायाम आहेत. तुम्हाला नवीन तयार करायचे असल्यास काही वर्कआउट्स साफ करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua senaman untuk semua hari sudah mempunyai latihan. Kosongkan beberapa senaman jika anda mahu menjana yang baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle økter for alle dager har allerede øvelser. Tøm noen økter hvis du vil generere nye."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle workouts voor alle dagen bevatten al oefeningen. Maak enkele workouts leeg als je nieuwe wilt genereren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁ ଦିନର ସମସ୍ତ ୱାର୍କଆଉଟ୍‌ରେ ପୂର୍ବରୁ ବ୍ୟାୟାମ ଅଛି। ଯଦି ଆପଣ ନୂଆ ବ୍ୟାୟାମ ଜେନେରେଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି, ତେବେ କିଛି ୱାର୍କଆଉଟ୍ ଖାଲି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੇ ਦਿਨਾਂ ਦੇ ਸਾਰੇ ਵਰਕਆਊਟਾਂ ਵਿੱਚ ਪਹਿਲਾਂ ਹੀ ਕਸਰਤਾਂ ਹਨ। ਜੇ ਤੁਸੀਂ ਨਵੀਆਂ ਕਸਰਤਾਂ ਤਿਆਰ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ ਤਾਂ ਕੁਝ ਵਰਕਆਊਟ ਸਾਫ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie treningi we wszystkich dniach mają już ćwiczenia. Wyczyść niektóre treningi, jeśli chcesz wygenerować nowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os treinos de todos os dias já têm exercícios. Limpe alguns treinos se quiser gerar novos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os treinos de todos os dias já têm exercícios. Limpa alguns treinos se quiseres gerar novos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate antrenamentele din toate zilele au deja exerciții. Golește câteva antrenamente dacă vrei să generezi altele noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во всех тренировках на все дни уже есть упражнения. Очистите некоторые тренировки, если хотите сгенерировать новые."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky tréningy pre všetky dni už obsahujú cvičenia. Ak chcete vygenerovať nové, niektoré tréningy vyprázdnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse vadbe za vse dni že vsebujejo vaje. Počistite nekaj vadb, če želite ustvariti nove."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla träningspass för alla dagar har redan övningar. Rensa några träningspass om du vill generera nya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து நாட்களுக்குமான எல்லாப் பயிற்சி அமர்வுகளிலும் ஏற்கனவே உடற்பயிற்சிகள் உள்ளன. புதியவற்றை உருவாக்க விரும்பினால் சில பயிற்சி அமர்வுகளை அழிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని రోజులలోని అన్ని వర్కవుట్‌లలో ఇప్పటికే వ్యాయామాలు ఉన్నాయి. మీరు కొత్తవాటిని రూపొందించాలనుకుంటే కొన్ని వర్కవుట్‌లను క్లియర్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกกำลังกายทั้งหมดของทุกวันมีท่าฝึกอยู่แล้ว ล้างการออกกำลังกายบางรายการออกหากคุณต้องการสร้างรายการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm günlerdeki tüm antrenmanlarda zaten egzersiz var. Yenilerini oluşturmak istiyorsanız bazı antrenmanları temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі тренування на всі дні вже містять вправи. Очистіть деякі тренування, якщо хочете згенерувати нові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام دنوں کی تمام ورزشوں میں پہلے سے مشقیں موجود ہیں۔ اگر آپ نئی مشقیں تیار کرنا چاہتے ہیں تو کچھ ورزشیں صاف کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả buổi tập của mọi ngày đều đã có bài tập. Hãy xóa bớt một số buổi tập nếu bạn muốn tạo bài mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有日期的所有训练均已包含运动。如需生成新的训练，请先清空部分训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有天數的所有鍛鍊都已有運動項目。如果想生成新的鍛鍊，請先清除部分鍛鍊。"
          }
        }
      }
    },
