    "Notifications are disabled. Please enable them in Settings if you want to use reminders for your workouts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطلة. يُرجى تفعيلها في الإعدادات إذا كنت تريد استخدام التذكيرات لتدريباتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са изключени. Разреши ги в Настройки, ако искаш да използваш напомняния за тренировките си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি বন্ধ আছে। আপনি যদি আপনার ওয়ার্কআউটের জন্য রিমাইন্ডার ব্যবহার করতে চান, তবে অনুগ্রহ করে সেটিংস থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan desactivades. Activa-les a Configuració si vols fer servir recordatoris per als teus entrenaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou vypnutá. Pokud chcete u tréninků používat připomínky, povolte je prosím v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er deaktiveret. Aktiver dem i Indstillinger, hvis du vil bruge påmindelser til dine træninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Bitte aktiviere sie in den Einstellungen, wenn du Erinnerungen für deine Workouts nutzen möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι απενεργοποιημένες. Ενεργοποίησέ τες στις Ρυθμίσεις αν θέλεις να χρησιμοποιείς υπενθυμίσεις για τις προπονήσεις σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes si quieres usar recordatorios para tus entrenamientos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Configuración si quieres usar recordatorios para tus entrenamientos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset on poistettu käytöstä. Ota ne käyttöön Asetuksissa, jos haluat käyttää muistutuksia treeneillesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Active-les dans Réglages si tu veux utiliser des rappels pour tes entraînements."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Veuillez les activer dans Réglages si vous souhaitez utiliser des rappels pour vos entraînements."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ બંધ છે. જો તમે તમારા વર્કઆઉટ માટે રિમાઇન્ડરનો ઉપયોગ કરવા માંગતા હો, તો કૃપા કરીને સેટિંગ્સમાં તેમને ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות מושבתות. אנא הפעל אותן בהגדרות אם ברצונך להשתמש בתזכורות לאימונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ अक्षम हैं। यदि आप अपने वर्कआउट के लिए रिमाइंडर का उपयोग करना चाहते हैं, तो कृपया सेटिंग्ज़ में उन्हें चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su onemogućene. Uključi ih u Postavkama ako želiš koristiti podsjetnike za treninge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. Engedélyezd őket a Beállításokban, ha emlékeztetőket szeretnél az edzéseidhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinonaktifkan. Harap aktifkan di Pengaturan jika Anda ingin menggunakan pengingat untuk latihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Abilitale in Impostazioni se vuoi usare i promemoria per i tuoi allenamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効になっています。ワークアウトのリマインダーを使用するには、設定で通知を有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар өшірілген. Жаттығуларыңыз үшін еске салғыштарды пайдаланғыңыз келсе, оларды Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ವರ್ಕೌಟ್‌ಗಳಿಗೆ ಜ್ಞಾಪನೆಗಳನ್ನು ಬಳಸಲು ಬಯಸಿದರೆ ದಯವಿಟ್ಟು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 워크아웃 미리 알림을 사용하려면 설정에서 알림을 허용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയിപ്പുകൾ പ്രവർത്തനരഹിതമാണ്. നിങ്ങളുടെ വർക്കൗട്ടുകൾക്കായി റിമൈൻഡറുകൾ ഉപയോഗിക്കണമെങ്കിൽ ക്രമീകരണങ്ങളിൽ അവ പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना बंद आहेत. तुम्हाला तुमच्या वर्कआउट्ससाठी स्मरणपत्रे वापरायची असल्यास कृपया सेटिंग्जमध्ये त्या सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinyahdayakan. Sila dayakannya dalam Seting jika anda mahu menggunakan peringatan untuk senaman anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er slått av. Slå dem på i Innstillinger hvis du vil bruke påminnelser for øktene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn uitgeschakeld. Schakel ze in via Instellingen als je herinneringen voor je workouts wilt gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଜ୍ଞପ୍ତିଗୁଡ଼ିକ ବନ୍ଦ ଅଛି। ଯଦି ଆପଣ ନିଜ ୱାର୍କଆଉଟ୍ ପାଇଁ ରିମାଇଣ୍ଡର୍ ବ୍ୟବହାର କରିବାକୁ ଚାହୁଁଛନ୍ତି, ଦୟାକରି ସେଟିଂସ୍‌ରେ ସେଗୁଡ଼ିକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਜੇ ਤੁਸੀਂ ਆਪਣੇ ਵਰਕਆਊਟਾਂ ਲਈ ਰਿਮਾਈਂਡਰ ਵਰਤਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਹਨਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Włącz je w Ustawieniach, jeśli chcesz korzystać z przypomnień o treningach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative-as nos Ajustes se quiser usar lembretes para seus treinos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ativa-as nas Definições se quiseres usar lembretes para os teus treinos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate. Activează-le în Configurări dacă vrei să folosești mementouri pentru antrenamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Включите их в Настройках, чтобы использовать напоминания о тренировках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia sú vypnuté. Ak chcete používať pripomienky pre svoje tréningy, povoľte ich v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila so onemogočena. Če želite uporabljati opomnike za svoje vadbe, jih omogočite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är inaktiverade. Aktivera dem i Inställningar om du vill använda påminnelser för dina träningspass."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் முடக்கப்பட்டுள்ளன. உங்கள் பயிற்சி அமர்வுகளுக்கு நினைவூட்டல்களைப் பயன்படுத்த விரும்பினால், அமைப்புகளில் அவற்றை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్‌లు ఆఫ్ చేయబడ్డాయి. మీరు మీ వర్కవుట్‌ల కోసం రిమైండర్‌లను ఉపయోగించాలనుకుంటే, దయచేసి సెట్టింగ్‌లలో వాటిని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนถูกปิดอยู่ โปรดเปิดใช้งานในการตั้งค่าหากคุณต้องการใช้การเตือนความจำสำหรับการออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler devre dışı. Antrenmanlarınız için anımsatıcı kullanmak istiyorsanız lütfen Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Увімкніть їх у Параметрах, якщо хочете отримувати нагадування про тренування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات غیر فعال ہیں۔ اگر آپ اپنی ورزشوں کے لیے یاد دہانیاں استعمال کرنا چاہتے ہیں تو براہ کرم سیٹنگز میں انہیں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang bị tắt. Vui lòng bật trong Cài đặt nếu bạn muốn dùng lời nhắc cho các buổi tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。如需为训练使用提醒，请在“设置”中启用通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已停用。若要使用鍛鍊提醒，請在「設定」中開啟通知。"
          }
        }
      }
    },
