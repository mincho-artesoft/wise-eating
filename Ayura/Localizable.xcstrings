        "sl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ta vadbeni načrt ima %lld povezano vadbo.\n\n• „Izbriši samo načrt“ bo odstranilo načrt, vadbe pa bodo ostale v vaši knjižnici vaj.\n• „Izbriši načrt in vadbe“ bo izbrisalo načrt in tudi te povezane vadbe.\n\nKaj želite storiti?"
                }
              },
              "two": {
                "stringUnit": {
