    "Are you sure you want to delete this scanned barcode?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد حذف هذا الباركود الممسوح؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш този сканиран баркод?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিতভাবে এই স্ক্যান করা বারকোডটি মুছতে চান?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols suprimir aquest codi de barres escanejat?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat tento naskenovaný čárový kód?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne scannede stregkode?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diesen gescannten Barcode wirklich löschen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις αυτό το σαρωμένο barcode;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar este código de barras escaneado?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar este código de barras escaneado?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa tämän skannatun viivakoodin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer ce code-barres scanné ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer ce code-barres numérisé?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર આ સ્કૅન કરેલ બારકોડ કાઢી નાખવા માંગો છો?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק ברקוד סרוק זה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई यह स्कैन किया गया बारकोड हटाना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati ovaj skenirani barkod?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törlöd ezt a beolvasott vonalkódot?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus kode batang yang dipindai ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare questo codice a barre scansionato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャンしたバーコードを削除してもよろしいですか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы сканерленген штрих-кодты жойғыңыз келетініне сенімдісіз бе?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಈ ಬಾರ್‌ಕೋಡ್ ಅನ್ನು ನೀವು ಖಚಿತವಾಗಿ ಅಳಿಸಲು ಬಯಸುವಿರಾ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 이 바코드를 삭제하시겠습니까?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്ത ഈ ബാർകോഡ് ഇല്ലാതാക്കണമെന്ന് നിങ്ങൾക്ക് ഉറപ്പാണോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्हाला हा स्कॅन केलेला बारकोड हटवायचा आहे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadam kod bar yang diimbas ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne skannede strekkoden?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze gescande barcode wilt verwijderen?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ ଭାବେ ଏହି ସ୍କାନ୍ ହୋଇଥିବା ବାରକୋଡ୍ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ ਇਹ ਸਕੈਨ ਕੀਤਾ ਬਾਰਕੋਡ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć ten zeskanowany kod kreskowy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar este código de barras lido?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar este código de barras lido?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur vrei să ștergi acest cod de bare scanat?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить этот отсканированный штрихкод?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať tento naskenovaný čiarový kód?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati to skenirano črtno kodo?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera den här skannade streckkoden?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்யப்பட்ட இந்த பார்கோடை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా ఈ స్కాన్ చేసిన బార్‌కోడ్‌ను తొలగించాలనుకుంటున్నారా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบบาร์โค้ดที่สแกนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taranan barkodu silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цей відсканований штрихкод?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی یہ اسکین شدہ بارکوڈ حذف کرنا چاہتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa mã vạch đã quét này không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此已扫描条形码吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除這個已掃描的條碼嗎？"
