        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La AI está creando tus ejercicios. Te notificaremos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI luo harjoituksiasi. Saat ilmoituksen, kun ne ovat valmiit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI crée tes exercices. Tu recevras une notification."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "AI crée vos exercices. Vous recevrez une notification."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI તમારી કસરતો બનાવી રહ્યું છે. તમને સૂચિત કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-AI יוצר את התרגילים שלך. תקבל התראה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI आपके व्यायाम बना रहा है। आपको सूचित किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI izrađuje tvoje vježbe. Dobit ćeš obavijest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI készíti a gyakorlataidat. Értesítést kapsz, ha elkészült."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI sedang membuat gerakan Anda. Anda akan diberi tahu."
