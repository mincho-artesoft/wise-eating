            "state": "translated",
            "value": "¿Cómo suele ser tu energía durante un día normal?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Millaista energiasi on yleensä tavallisen päivän aikana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fil d'une journée type, ton énergie ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fil d'une journée typique, comment évolue habituellement votre énergie?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામાન્ય દિવસ દરમિયાન તમારી ઊર્જા કેવી રહે છે?"
