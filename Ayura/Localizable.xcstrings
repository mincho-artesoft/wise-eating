        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಊಟಗಳು, ವರ್ಕೌಟ್‌ಗಳು ಮತ್ತು ಜ್ಞಾಪನೆಗಳು ಒಂದೇ ಕಡೆ."
