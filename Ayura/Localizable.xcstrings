          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی فہرست '%@' کو حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں لیا جا سکتا۔"
