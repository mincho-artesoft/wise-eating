        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton « + » pour créer votre premier plan d'entraînement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પહેલી તાલીમ યોજના બનાવવા માટે '+' બટન પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על כפתור ה-'+' כדי ליצור את תוכנית האימונים הראשונה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पहली प्रशिक्षण योजना बनाने के लिए '+' बटन पर टैप करें।"
