          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt. Hãy bật trong Cài đặt để sử dụng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
