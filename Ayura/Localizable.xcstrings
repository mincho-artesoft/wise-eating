    "Notifications are disabled. Please enable them in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطّلة. يُرجى تفعيلها في الإعدادات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са изключени. Моля, включи ги от Настройки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি বন্ধ আছে। অনুগ্রহ করে সেটিংস থেকে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan desactivades. Activa-les a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou zakázána. Povolte je prosím v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra. Slå dem til i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Bitte aktiviere sie in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γνωστοποιήσεις είναι απενεργοποιημένες. Ενεργοποίησέ τες στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset on poistettu käytöstä. Ota ne käyttöön Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Active-les dans Réglages."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Veuillez les activer dans Réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ બંધ છે. કૃપા કરીને તેમને સેટિંગ્સમાં ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העדכונים מושבתים. אנא הפעל אותם בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ अक्षम हैं। कृपया उन्हें सेटिंग्ज़ में सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su isključene. Uključi ih u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. Engedélyezd őket a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinonaktifkan. Harap aktifkan di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Attivale in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効になっています。設定で有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар өшірілген. Оларды Реттеулерден қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ದಯವಿಟ್ಟು ಅವುಗಳನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 설정에서 알림을 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയിപ്പുകൾ പ്രവർത്തനരഹിതമാണ്. ക്രമീകരണങ്ങളിൽ അവ പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना अक्षम आहेत. कृपया त्या सेटिंग्जमध्ये सक्षम करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinyahdayakan. Sila dayakannya dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger er deaktivert. Slå dem på i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn uitgeschakeld. Schakel ze in bij Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଜ୍ଞପ୍ତି ବନ୍ଦ ଅଛି। ଦୟାକରି ସେଟିଂସ୍‌ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਕਿਰਪਾ ਕਰਕੇ ਇਹਨਾਂ ਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Włącz je w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative-as nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ativa-as nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate. Te rugăm să le activezi în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Включите их в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia sú vypnuté. Zapnite ich v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila so onemogočena. Omogočite jih v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är inaktiverade. Aktivera dem i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் முடக்கப்பட்டுள்ளன. அமைப்புகளில் அவற்றை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్‌లు నిలిపివేయబడ్డాయి. దయచేసి సెట్టింగ్‌లలో వాటిని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนถูกปิดอยู่ กรุณาเปิดใช้งานในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler devre dışı. Lütfen Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Увімкніть їх у Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات غیر فعال ہیں۔ براہ کرم انہیں سیٹنگز میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. Vui lòng bật trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已禁用，请在“设置”中开启。"
          }
        },
        "zh-Hant": {
