    "Are you sure you want to delete this batch (%@ %@, expires: %@)? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد حذف هذه الدفعة (%@ %@، تنتهي في: %@)؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш тази партида (%@ %@, срок на годност: %@)? Това действие не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিত যে এই ব্যাচটি (%@ %@, মেয়াদ: %@) মুছে ফেলতে চান? এই কাজটি আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar aquest lot (%@ %@, caduca: %@)? Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat tuto šarži (%@ %@, spotřebovat do: %@)? Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette dette parti (%@ %@, udløber: %@)? Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Charge (%@ %@, läuft ab: %@) wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
