          "stringUnit": {
            "state": "translated",
            "value": "Hvert måltid må ha en sluttid etter starttiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke maaltijd moet een eindtijd na de begintijd hebben."
