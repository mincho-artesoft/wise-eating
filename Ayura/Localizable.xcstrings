        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலையாக, ஆனால் தள்ளிப்போட எளிதாக"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థిరంగా, కానీ వాయిదా వేయడం సులభంగా"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สม่ำเสมอ แต่เลื่อนมื้อได้ไม่ยาก"
