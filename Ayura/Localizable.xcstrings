    "Your hair has generally been?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف كان شعرك عمومًا؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Косата ти обикновено е?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চুল সাধারণত কেমন?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En general, com ha estat el teu cabell?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaké bývají vaše vlasy?"
