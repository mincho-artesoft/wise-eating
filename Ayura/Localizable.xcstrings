            "value": "ਦਿਨ ਦੀ ਥਕਾਵਟ ਛੱਡੋ ਅਤੇ ਅੰਦਰ ਵੱਲ ਮੁੜੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpuść dzień i zwróć się do wewnątrz"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar o dia e voltar-se para dentro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberta o dia e volta-te para dentro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă ziua în urmă și întoarce-te spre interior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите день и обратитесь внутрь"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte deň odísť a obráťte sa dovnútra"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite dan in se obrnite navznoter"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp dagen och vänd dig inåt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாளின் சுமையை விடுவித்து உள்நோக்கித் திரும்புங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజు భారాన్ని వదిలి అంతర్ముఖం అవ్వండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางเรื่องราวของวันลงแล้วหันกลับสู่ภายใน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günü bırakın ve içinize dönün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпустіть день і зверніться всередину"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن کا بوجھ اتاریں اور اندرون کی طرف مڑیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buông bỏ một ngày và hướng vào bên trong"
          }
        },
