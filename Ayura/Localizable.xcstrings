        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବ୍ୟାୟାମଗୁଡ଼ିକୁ ବାମକୁ ସ୍ୱାଇପ୍ କରି ଆପଣ ସେଗୁଡ଼ିକୁ ପସନ୍ଦରେ ଯୋଡ଼ିପାରିବେ।"
