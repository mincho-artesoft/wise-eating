        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderåtkomst krävs för att hantera profildata och inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுயவிவரத் தரவு மற்றும் அமைப்புகளை நிர்வகிக்க நாட்காட்டி அணுகல் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రొఫైల్ డేటా మరియు సెట్టింగ్‌లను నిర్వహించడానికి క్యాలెండర్ అనుమతి అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
