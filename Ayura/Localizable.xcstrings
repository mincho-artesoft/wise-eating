    "Apple Intelligence is turned off. Enable it in Settings to use AI workout generation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزة Apple Intelligence متوقفة. فعّلها في الإعدادات لاستخدام توليد التدريبات عبر AI."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence е изключен. Включи го в Настройки, за да използваш AI генериране на тренировки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ আছে। AI ওয়ার্কআউট জেনারেশন ব্যবহার করতে সেটিংসে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence està desactivat. Activa'l a Configuració per fer servir la generació d'entrenaments amb AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Pro generování tréninků pomocí AI ji zapněte v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slået fra. Slå det til i Indstillinger for at bruge AI-træningsgenerering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es in den Einstellungen, um die AI-Workout-Generierung zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποίησέ το στις Ρυθμίσεις για να χρησιμοποιήσεις τη δημιουργία προπονήσεων με AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivada. Actívala en Ajustes para usar la generación de entrenamientos con IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Configuración para usar la generación de entrenamientos con AI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on pois päältä. Ota se käyttöön Asetuksissa käyttääksesi AI-treenigenerointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages pour générer des entraînements avec AI."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivée. Activez-la dans Réglages pour utiliser la génération d'entraînements AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence બંધ છે. AI વર્કઆઉટ જનરેશનનો ઉપયોગ કરવા માટે તેને સેટિંગ્સમાં ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence כבוי. הפעל אותו בהגדרות כדי להשתמש ביצירת אימונים ב-AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है। AI वर्कआउट जनरेशन का उपयोग करने के लिए इसे सेटिंग्ज़ में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je isključen. Uključi ga u Postavkama za AI generiranje treninga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence ki van kapcsolva. Kapcsold be a Beállításokban az AI edzésgenerálás használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Aktifkan di Pengaturan untuk menggunakan pembuatan latihan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivata. Attivala in Impostazioni per usare la generazione di allenamenti AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。AIワークアウト生成を使用するには「設定」で有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence өшірулі. AI жаттығу генерациясын пайдалану үшін оны Реттеулерде қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಆಫ್ ಆಗಿದೆ. AI ವರ್ಕೌಟ್ ರಚನೆಯನ್ನು ಬಳಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. AI 워크아웃 생성을 사용하려면 설정에서 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ഓഫ് ആണ്. AI വർക്കൗട്ട് ജനറേഷൻ ഉപയോഗിക്കാൻ ക്രമീകരണങ്ങളിൽ ഇത് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद आहे. AI वर्कआउट निर्मिती वापरण्यासाठी ते सेटिंग्जमध्ये सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dimatikan. Dayakannya dalam Seting untuk menggunakan penjanaan senaman AI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slått av. Slå den på i Innstillinger for å bruke AI-generering av økter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is uitgeschakeld. Schakel het in bij Instellingen om AI-workoutgeneratie te gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ବନ୍ଦ ଅଛି। AI ୱାର୍କଆଉଟ୍ ଜେନେରେସନ୍ ବ୍ୟବହାର କରିବାକୁ ସେଟିଂସ୍‌ରେ ଏହାକୁ ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਬੰਦ ਹੈ। AI ਵਰਕਆਊਟ ਜਨਰੇਸ਼ਨ ਵਰਤਣ ਲਈ ਇਸ ਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Apple Intelligence jest wyłączona. Włącz ją w Ustawieniach, aby korzystać z generowania treningów AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes para usar a geração de treinos por AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ativa-a nas Definições para usar a geração de treinos com AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence este dezactivat. Activează-l în Configurări pentru a folosi generarea de antrenamente AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence отключён. Включите его в Настройках, чтобы использовать генерацию тренировок с AI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Ak chcete používať generovanie tréningov pomocou AI, zapnite ju v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je izklopljen. Omogočite ga v Nastavitvah za uporabo ustvarjanja vadb z AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är avstängt. Aktivera det i Inställningar för att använda AI-generering av träningspass."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence முடக்கப்பட்டுள்ளது. AI பயிற்சி அமர்வு உருவாக்கத்தைப் பயன்படுத்த அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఆఫ్‌లో ఉంది. AI వర్కవుట్ జనరేషన్‌ను ఉపయోగించడానికి సెట్టింగ్‌లలో దీన్ని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ปิดอยู่ เปิดใช้งานในการตั้งค่าเพื่อใช้การสร้างการออกกำลังกายด้วย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı. AI antrenman oluşturmayı kullanmak için Ayarlar'dan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вимкнено. Увімкніть його в Параметрах, щоб використовувати генерацію тренувань AI."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence بند ہے۔ AI ورزش جنریشن استعمال کرنے کے لیے اسے سیٹنگز میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt. Hãy bật trong Cài đặt để sử dụng tính năng tạo buổi tập bằng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能已关闭。请在“设置”中开启以使用 AI 训练生成功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已關閉。請在「設定」中啟用以使用 AI 鍛鍊生成功能。"
          }
        }
      }
    },
