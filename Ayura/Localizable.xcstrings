    "This food item is used in %lld recipes or menu or meal plans.\nIf you delete it, it will be removed from those places.\n\nAre you sure you want to continue?": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في %lld من الوصفات أو قوائم الطعام أو خطط الوجبات.\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في وصفة أو قائمة طعام أو خطة وجبات واحدة (%lld).\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في وصفتين أو قائمتين أو خطتي وجبات (%lld).\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في %lld وصفات أو قوائم طعام أو خطط وجبات.\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في %lld وصفة أو قائمة طعام أو خطة وجبات.\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عنصر الطعام هذا مستخدم في %lld وصفة أو قائمة طعام أو خطة وجبات.\nإذا حذفته، فستتم إزالته من تلك الأماكن.\n\nهل أنت متأكد من رغبتك في المتابعة؟"
                }
              }
            }
          }
        },
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Тази храна се използва в %lld рецепта, меню или хранителен план.\nАко я изтриеш, ще бъде премахната от това място.\n\nНаистина ли искаш да продължиш?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Тази храна се използва в %lld рецепти, менюта или хранителни планове.\nАко я изтриеш, ще бъде премахната от тези места.\n\nНаистина ли искаш да продължиш?"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "এই খাবারটি %lldটি রেসিপি, মেনু বা খাবার পরিকল্পনায় ব্যবহৃত হয়েছে।\nআপনি এটি মুছে ফেললে সেই জায়গা থেকেও এটি সরে যাবে।\n\nআপনি কি সত্যিই এগিয়ে যেতে চান?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "এই খাবারটি %lldটি রেসিপি, মেনু বা খাবার পরিকল্পনায় ব্যবহৃত হয়েছে।\nআপনি এটি মুছে ফেললে সেসব জায়গা থেকেও এটি সরে যাবে।\n\nআপনি কি সত্যিই এগিয়ে যেতে চান?"
                }
              }
            }
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aquest aliment s'utilitza en %lld recepta, menú o pla d'àpats.\nSi l'elimines, s'eliminarà d'aquest lloc.\n\nSegur que vols continuar?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aquest aliment s'utilitza en %lld receptes, menús o plans d'àpats.\nSi l'elimines, s'eliminarà d'aquests llocs.\n\nSegur que vols continuar?"
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tato potravina je součástí %lld receptu, menu nebo jídelníčku.\nPokud ji smažete, bude z těchto míst odstraněna.\n\nOpravdu chcete pokračovat?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tato potravina je součástí %lld receptů, menu nebo jídelníčků.\nPokud ji smažete, bude z těchto míst odstraněna.\n\nOpravdu chcete pokračovat?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tato potravina je součástí %lld receptu, menu nebo jídelníčku.\nPokud ji smažete, bude z těchto míst odstraněna.\n\nOpravdu chcete pokračovat?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tato potravina je součástí %lld receptů, menu nebo jídelníčků.\nPokud ji smažete, bude z těchto míst odstraněna.\n\nOpravdu chcete pokračovat?"
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Denne fødevare bruges i %lld opskrift, menu eller kostplan.\nHvis du sletter den, fjernes den derfra.\n\nEr du sikker på, at du vil fortsætte?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Denne fødevare bruges i %lld opskrifter, menuer eller kostplaner.\nHvis du sletter den, fjernes den fra disse steder.\n\nEr du sikker på, at du vil fortsætte?"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses Lebensmittel wird in %lld Rezept, Menü oder Ernährungsplan verwendet.\nWenn du es löschst, wird es dort entfernt.\n\nMöchtest du wirklich fortfahren?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses Lebensmittel wird in %lld Rezepten, Menüs oder Ernährungsplänen verwendet.\nWenn du es löschst, wird es dort entfernt.\n\nMöchtest du wirklich fortfahren?"
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Αυτή η τροφή χρησιμοποιείται σε %lld συνταγή, μενού ή πλάνο γευμάτων.\nΑν τη διαγράψεις, θα αφαιρεθεί από αυτό το σημείο.\n\nΘέλεις σίγουρα να συνεχίσεις;"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Αυτή η τροφή χρησιμοποιείται σε %lld συνταγές, μενού ή πλάνα γευμάτων.\nΑν τη διαγράψεις, θα αφαιρεθεί από αυτά τα σημεία.\n\nΘέλεις σίγουρα να συνεχίσεις;"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este alimento se usa en %lld receta, menú o plan de comidas.\nSi lo eliminas, se quitará de ese lugar.\n\n¿Seguro que quieres continuar?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este alimento se usa en %lld recetas, menús o planes de comidas.\nSi lo eliminas, se quitará de esos lugares.\n\n¿Seguro que quieres continuar?"
                }
              }
            }
          }
        },
        "es-MX": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este alimento se usa en %lld receta, menú o plan de comidas.\nSi lo eliminas, se quitará de ese lugar.\n\n¿Seguro que quieres continuar?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este alimento se usa en %lld recetas, menús o planes de comidas.\nSi lo eliminas, se quitará de esos lugares.\n\n¿Seguro que quieres continuar?"
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tätä ruokaa käytetään %lld reseptissä, menussa tai ateriasuunnitelmassa.\nJos poistat sen, se poistetaan myös sieltä.\n\nHaluatko varmasti jatkaa?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tätä ruokaa käytetään %lld reseptissä, menussa tai ateriasuunnitelmassa.\nJos poistat sen, se poistetaan myös niistä.\n\nHaluatko varmasti jatkaa?"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cet aliment est utilisé dans %lld recette, menu ou plan alimentaire.\nSi tu le supprimes, il en sera retiré.\n\nVeux-tu vraiment continuer ?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cet aliment est utilisé dans %lld recettes, menus ou plans alimentaires.\nSi tu le supprimes, il en sera retiré.\n\nVeux-tu vraiment continuer ?"
                }
              }
            }
          }
        },
        "fr-CA": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cet aliment est utilisé dans %lld recette, menu ou plan alimentaire.\nSi vous le supprimez, il sera retiré de ces endroits.\n\nVoulez-vous vraiment continuer?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cet aliment est utilisé dans %lld recettes, menus ou plans alimentaires.\nSi vous le supprimez, il sera retiré de ces endroits.\n\nVoulez-vous vraiment continuer?"
                }
              }
            }
          }
        },
        "gu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "આ ખોરાક %lld રેસીપી, મેનુ અથવા ભોજન યોજનામાં વપરાયેલ છે.\nજો તમે તેને કાઢી નાખશો, તો તે એ જગ્યાએથી દૂર થઈ જશે.\n\nશું તમે ખરેખર આગળ વધવા માંગો છો?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "આ ખોરાક %lld રેસીપી, મેનુ અથવા ભોજન યોજનાઓમાં વપરાયેલ છે.\nજો તમે તેને કાઢી નાખશો, તો તે એ જગ્યાઓએથી દૂર થઈ જશે.\n\nશું તમે ખરેખર આગળ વધવા માંગો છો?"
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "פריט מזון זה מופיע במקום %lld (מתכון, תפריט או תוכנית ארוחות).\nאם תמחק אותו, הוא יוסר משם.\n\nהאם אתה בטוח שברצונך להמשיך?"
                }
              },
              "two": {
