        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je vypnutá. Pro použití AI ji zapněte v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slået fra. Slå det til i Indstillinger for at bruge AI."
