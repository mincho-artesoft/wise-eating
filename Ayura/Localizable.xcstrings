    "Try adjusting the date range or clearing the filter to see all your nodes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب تعديل النطاق الزمني أو مسح الفلتر لعرض جميع ملاحظاتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
