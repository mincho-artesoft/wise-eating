        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی اس بیچ (%@ %@، میعاد ختم: %@) کو حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں لیا جا سکتا۔"
