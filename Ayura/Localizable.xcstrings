    "This will remove the job from your history. This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة المهمة من سجلك. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще премахне задачата от историята ти. Това действие е необратимо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার ইতিহাস থেকে কাজটি সরিয়ে দেবে। এই পদক্ষেপটি আর পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això eliminarà la tasca del teu historial. Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto úlohu odstraníte z historie. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner opgaven fra din historik. Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Auftrag aus deinem Verlauf entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα αφαιρέσει την εργασία από το ιστορικό σου. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará la tarea de tu historial. Esta acción no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará la tarea de tu historial. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa työn historiastasi. Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera la tâche de ton historique. Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera la tâche de votre historique. Cette action est irréversible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમારા ઇતિહાસમાંથી આ કાર્ય દૂર કરશે. આ ક્રિયા પૂર્વવત્ કરી શકાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תסיר את המשימה מההיסטוריה שלך. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे यह कार्य आपके इतिहास से हट जाएगा। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim će se zadatak ukloniti iz tvoje povijesti. Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja a feladatot az előzményeidből. Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus tugas dari riwayat Anda. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività verrà rimossa dalla cronologia. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このジョブが履歴から削除されます。この操作は取り消せません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тапсырма тарихыңыздан өшіріледі. Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ನಿಮ್ಮ ಇತಿಹಾಸದಿಂದ ಈ ಕಾರ್ಯವನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에서 이 작업이 제거됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളുടെ ചരിത്രത്തിൽ നിന്ന് ഈ ജോബ് നീക്കം ചെയ്യും. ഈ പ്രവൃത്തി പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य तुमच्या इतिहासातून काढून टाकले जाईल. ही कृती पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan membuang tugasan ini daripada sejarah anda. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner jobben fra historikken din. Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de taak uit je geschiedenis verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆପଣଙ୍କ ଇତିହାସରୁ ଏହି କାର୍ଯ୍ୟଟିକୁ ହଟାଇ ଦେବ। ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରିହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ ਇਹ ਕੰਮ ਤੁਹਾਡੇ ਇਤਿਹਾਸ ਵਿੱਚੋਂ ਹਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਲਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie zadania z historii. Tej czynności nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá a tarefa do seu histórico. Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá remover a tarefa do teu histórico. Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru va elimina sarcina din istoricul tău. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача будет удалена из вашей истории. Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa úloha odstráni z vašej histórie. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste opravilo odstranili iz zgodovine. Tega dejanja ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort jobbet från din historik. Åtgärden kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்கள் வரலாற்றிலிருந்து இந்தப் பணியை நீக்கும். இந்தச் செயலைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీ చరిత్ర నుండి ఈ జాబ్‌ను తీసివేస్తుంది. ఈ చర్యను రద్దు చేయలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบงานนี้ออกจากประวัติของคุณ การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, görevi geçmişinizden kaldıracaktır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання буде вилучено з вашої історії. Цю дію неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے یہ کام آپ کی ہسٹری سے ہٹ جائے گا۔ یہ عمل واپس نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tác vụ khỏi lịch sử của bạn. Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从历史记录中移除此任务。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將會把此任務從你的紀錄中移除。此操作無法復原。"
          }
        }
      }
    },
