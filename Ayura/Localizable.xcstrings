    "⚠️ This food contains allergens the user is sensitive to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ يحتوي هذا الطعام على مسببات حساسية يتحسس منها المستخدم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Тази храна съдържа алергени, към които потребителят е чувствителен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ এই খাবারে এমন অ্যালার্জেন রয়েছে যার প্রতি ব্যবহারকারীর সংবেদনশীলতা আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aquest aliment conté al·lèrgens als quals l'usuari és sensible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
