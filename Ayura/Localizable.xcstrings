            "value": "Saisis tes pensées, notes ou observations..."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vos pensées, notes ou observations…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા વિચારો, નોંધો અથવા અવલોકનો દાખલ કરો..."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתוב את המחשבות, ההערות או התצפיות שלך..."
