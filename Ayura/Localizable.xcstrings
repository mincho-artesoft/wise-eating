        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze batch (%@ %@, vervalt: %@) wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ କି ଯେ ଆପଣ ଏହି ବ୍ୟାଚ୍ (%@ %@, ସମାପ୍ତି: %@) କୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି? ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ ਇਸ ਬੈਚ (%@ %@, ਮਿਆਦ ਸਮਾਪਤੀ: %@) ਨੂੰ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਲਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć tę partię (%@ %@, ważna do: %@)? Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar este lote (%@ %@, validade: %@)? Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar este lote (%@ %@, validade: %@)? Esta ação não pode ser anulada."
