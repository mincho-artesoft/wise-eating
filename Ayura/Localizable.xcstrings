    "Answer based on how you have usually been.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب بناءً على ما كنت عليه عادةً."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговори според обичайното си състояние."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সাধারণত যেমন থাকেন, সেই অনুযায়ী উত্তর দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon segons com has estat normalment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídejte podle toho, jak to u vás obvykle bývá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar ud fra, hvordan du som regel har været."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientiere dich daran, wie es bei dir bisher meistens war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απάντησε με βάση το πώς είσαι συνήθως."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde según cómo has sido normalmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde según cómo has sido normalmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaa sen mukaan, millainen olet yleensä ollut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds selon ce qui te correspond habituellement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez selon votre état habituel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સામાન્ય રીતે કેવા રહ્યા છો તેના આધારે જવાબ આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ענה לפי מה שמאפיין אותך בדרך כלל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आम तौर पर कैसे रहे हैं, इसके आधार पर उत्तर दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori prema onome što je za tebe uobičajeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszolj aszerint, hogy általában milyen vagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab berdasarkan kondisi Anda pada umumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi in base a come sei di solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの普段の傾向をもとに回答してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдетте қандай болғаныңызға қарай жауап беріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಹೇಗಿರುತ್ತೀರಿ ಎಂಬುದರ ಆಧಾರದ ಮೇಲೆ ಉತ್ತರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 자신의 모습을 기준으로 답하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സാധാരണയായി എങ്ങനെയായിരുന്നു എന്നതിന്റെ അടിസ്ഥാനത്തിൽ ഉത്തരം നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सहसा कसे असता त्यानुसार उत्तरे द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab berdasarkan keadaan biasa anda selama ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar ut fra hvordan du vanligvis har vært."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoord op basis van hoe je meestal bent geweest."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସାଧାରଣତଃ କିପରି ରହିଆସିଛନ୍ତି ତାହା ଆଧାରରେ ଉତ୍ତର ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਆਮ ਤੌਰ 'ਤੇ ਕਿਹੋ ਜਿਹੇ ਰਹੇ ਹੋ, ਉਸ ਅਨੁਸਾਰ ਜਵਾਬ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj zgodnie z tym, jak zazwyczaj u Ciebie bywa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda com base em como você costuma ser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde com base na forma como costumas ser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunde în funcție de cum ai fost de obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечайте исходя из того, что обычно для вас характерно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedajte podľa toho, akí zvyčajne bývate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovorite glede na to, kakšni ste bili običajno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara utifrån hur du vanligtvis har varit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பொதுவாக எப்படி இருந்துள்ளீர்கள் என்பதன் அடிப்படையில் பதிலளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
