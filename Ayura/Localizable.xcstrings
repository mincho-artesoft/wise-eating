        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চারটি ছোট প্রশ্ন, সময় লাগবে প্রায় এক মিনিট।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre preguntes breus, aproximadament un minut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři krátké otázky, zhruba na minutu."
          }
