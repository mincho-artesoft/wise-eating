        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "AI آپ کی مشقیں تیار کر رہا ہے۔ آپ کو مطلع کیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI đang tạo các bài tập cho bạn. Bạn sẽ nhận được thông báo."
          }
