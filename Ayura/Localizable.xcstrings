    "Are you sure you want to delete '%@' from the meal? This will not affect your stored items.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في حذف «%@» من الوجبة؟ لن يؤثر هذا على عناصرك المخزنة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш „%@“ от храненето? Това няма да засегне съхранените ти храни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি সত্যিই এই বেলার খাবার থেকে ‘%@’ মুছে ফেলতে চান? এটি আপনার সংরক্ষিত আইটেমগুলোতে কোনো প্রভাব ফেলবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar «%@» de l'àpat? Això no afectarà els teus aliments desats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete smazat „%@“ z jídla? Vaše uložené položky to neovlivní."
