    "Choose a theme or a background image to change the application's appearance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر سمة أو صورة خلفية لتغيير مظهر التطبيق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери тема или фоново изображение, за да промениш външния вид на приложението."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটির চেহারা পরিবর্তন করতে একটি থিম বা ব্যাকগ্রাউন্ড ছবি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un tema o una imatge de fons per canviar l'aspecte de l'aplicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte motiv nebo obrázek na pozadí a změňte tak vzhled aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et tema eller et baggrundsbillede for at ændre appens udseende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Design oder ein Hintergrundbild, um das Erscheinungsbild der App zu ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε ένα θέμα ή μια εικόνα φόντου για να αλλάξεις την εμφάνιση της εφαρμογής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema o una imagen de fondo para cambiar la apariencia de la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema o una imagen de fondo para cambiar la apariencia de la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse teema tai taustakuva muuttaaksesi sovelluksen ulkoasua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un thème ou une image d'arrière-plan pour modifier l'apparence de l'application."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un thème ou une image d'arrière-plan pour modifier l'apparence de l'application."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ્લિકેશનનો દેખાવ બદલવા માટે થીમ અથવા બૅકગ્રાઉન્ડ છબી પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר ערכת נושא או תמונת רקע כדי לשנות את מראה האפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की दिखावट बदलने के लिए कोई थीम या बैकग्राउंड छवि चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi temu ili pozadinsku sliku za promjenu izgleda aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy témát vagy háttérképet az alkalmazás megjelenésének megváltoztatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tema atau gambar latar belakang untuk mengubah tampilan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un tema o un'immagine di sfondo per cambiare l'aspetto dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマまたは背景画像を選択して、アプリの外観を変更します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаның сыртқы түрін өзгерту үшін тақырыпты немесе фон суретін таңдаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನ ಗೋಚರತೆಯನ್ನು ಬದಲಾಯಿಸಲು ಥೀಮ್ ಅಥವಾ ಹಿನ್ನೆಲೆ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 또는 배경 이미지를 선택하여 앱 화면 스타일을 변경하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്ലിക്കേഷന്റെ രൂപഭാവം മാറ്റാൻ ഒരു തീമോ പശ്ചാത്തല ചിത്രമോ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲपचे स्वरूप बदलण्यासाठी थीम किंवा पार्श्वभूमी प्रतिमा निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tema atau imej latar belakang untuk menukar penampilan aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et tema eller et bakgrunnsbilde for å endre appens utseende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een thema of een achtergrondafbeelding om de weergave van de app te wijzigen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍‌ର ଦୃଶ୍ୟରୂପ ବଦଳାଇବାକୁ ଏକ ଥିମ୍ କିମ୍ବା ପୃଷ୍ଠଭୂମି ଛବି ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਦੀ ਦਿੱਖ ਬਦਲਣ ਲਈ ਕੋਈ ਥੀਮ ਜਾਂ ਬੈਕਗ੍ਰਾਊਂਡ ਚਿੱਤਰ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz motyw lub obraz tła, aby zmienić wygląd aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um tema ou uma imagem de fundo para alterar a aparência do aplicativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um tema ou uma imagem de fundo para alterar o aspeto da aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o temă sau o imagine de fundal pentru a schimba aspectul aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тему или фоновое изображение, чтобы изменить оформление приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte motív alebo obrázok na pozadí, čím zmeníte vzhľad aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite temo ali sliko ozadja, da spremenite videz aplikacije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett tema eller en bakgrundsbild för att ändra appens utseende."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலியின் தோற்றத்தை மாற்ற ஒரு தீம் அல்லது பின்னணிப் படத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ రూపాన్ని మార్చడానికి ఒక థీమ్ లేదా బ్యాక్‌గ్రౌండ్ చిత్రాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกธีมหรือภาพพื้นหลังเพื่อเปลี่ยนลักษณะที่ปรากฏของแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın görünümünü değiştirmek için bir tema veya arka plan görseli seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть тему або фонове зображення, щоб змінити оформлення програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کی ظاہری شکل تبدیل کرنے کے لیے کوئی تھیم یا پس منظر کی تصویر منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn chủ đề hoặc ảnh nền để thay đổi giao diện ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
