    "Your energy through a typical day usually?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف تكون طاقتك عادةً خلال يوم عادي؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Енергията ти през обичаен ден обикновено?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সাধারণ দিনে আপনার শক্তির মাত্রা সাধারণত কেমন থাকে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com evoluciona normalment la teva energia al llarg d'un dia típic?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se obvykle vyvíjí vaše energie během běžného dne?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din energi gennem en typisk dag?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie verläuft deine Energie an einem typischen Tag meist?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενέργειά σου σε μια τυπική μέρα συνήθως;"
