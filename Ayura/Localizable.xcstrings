    "The sum of carbohydrates, protein, and fat (%.1f g) cannot exceed the total serving weight (%.1f g).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يتجاوز مجموع الكربوهيدرات والبروتين والدهون (%.1f g) إجمالي وزن الحصة (%.1f g)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумата от въглехидрати, протеин и мазнини (%.1f g) не може да надвишава общото тегло на порцията (%.1f g)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্বোহাইড্রেট, প্রোটিন ও চর্বির যোগফল (%.1f g) মোট পরিবেশন ওজনের (%.1f g) চেয়ে বেশি হতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma de carbohidrats, proteïna i greix (%.1f g) no pot superar el pes total de la ració (%.1f g)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Součet sacharidů, bílkovin a tuků (%.1f g) nesmí překročit celkovou hmotnost porce (%.1f g)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen af kulhydrater, protein og fedt (%.1f g) må ikke overstige den samlede portionsvægt (%.1f g)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summe aus Kohlenhydraten, Protein und Fett (%.1f g) darf das gesamte Portionsgewicht (%.1f g) nicht überschreiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
