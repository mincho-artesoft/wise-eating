        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆମେ ଆପଣଙ୍କ ତଥ୍ୟ ପ୍ରସ୍ତୁତ କରିପାରିଲୁ ନାହିଁ"
