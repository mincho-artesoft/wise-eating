        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať „%@“ zo svojho tréningu? Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
