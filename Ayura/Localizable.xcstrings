        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIがエクササイズを作成しています。完了すると通知されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI жаттығуларыңызды жасап жатыр. Сізге хабарланады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ನಿಮ್ಮ ವ್ಯಾಯಾಮಗಳನ್ನು ರಚಿಸುತ್ತಿದೆ. ನಿಮಗೆ ತಿಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 운동을 생성하고 있습니다. 완료되면 알려드립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "AI നിങ്ങളുടെ വ്യായാമങ്ങൾ സൃഷ്ടിക്കുകയാണ്. നിങ്ങളെ അറിയിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI तुमचे व्यायाम तयार करत आहे. तुम्हाला कळवले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AI sedang mencipta latihan anda. Anda akan dimaklumkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI lager øvelsene dine. Du får varsel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI maakt je oefeningen. Je krijgt een melding."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ଆପଣଙ୍କ ବ୍ୟାୟାମ ତିଆରି କରୁଛି। ଆପଣଙ୍କୁ ସୂଚିତ କରାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ਤੁਹਾਡੀਆਂ ਕਸਰਤਾਂ ਬਣਾ ਰਿਹਾ ਹੈ। ਤੁਹਾਨੂੰ ਸੂਚਿਤ ਕੀਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tworzy Twoje ćwiczenia. Otrzymasz powiadomienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A AI está criando seus exercícios. Você será notificado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A AI está a criar os teus exercícios. Receberás uma notificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI creează exercițiile tale. Vei primi o notificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI создаёт ваши упражнения. Вы получите уведомление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI vytvára vaše cvičenia. Dostanete upozornenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ustvarja vaše vaje. Prejeli boste obvestilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI skapar dina övningar. Du får en notis."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI உங்கள் உடற்பயிற்சிகளை உருவாக்குகிறது. உங்களுக்குத் தெரிவிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI మీ వ్యాయామాలను సృష్టిస్తోంది. మీకు తెలియజేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI กำลังสร้างท่าออกกำลังกายของคุณ คุณจะได้รับการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI egzersizlerinizi oluşturuyor. Bildirim alacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI створює ваші вправи. Ви отримаєте сповіщення."
