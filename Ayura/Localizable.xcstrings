            "state": "translated",
            "value": "新增食材以查看即時阿育吠陀預覽。"
          }
        }
      }
    },
    "Computed from your ingredients — updates automatically": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محسوب من مكوناتك — يُحدَّث تلقائيًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчислено от съставките ти — обновява се автоматично"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উপকরণ থেকে গণনা করা — স্বয়ংক্রিয়ভাবে আপডেট হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculat a partir dels teus ingredients — s'actualitza automàticament"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočítáno z vašich ingrediencí — aktualizuje se automaticky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet ud fra dine ingredienser — opdateres automatisk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen Zutaten berechnet – wird automatisch aktualisiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπολογίζεται από τα υλικά σου — ενημερώνεται αυτόματα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado a partir de tus ingredientes — se actualiza automáticamente"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado a partir de tus ingredientes — se actualiza automáticamente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskettu ainesosistasi — päivittyy automaattisesti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé à partir de tes ingrédients — mise à jour automatique"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé à partir de vos ingrédients — mise à jour automatique"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી સામગ્રીમાંથી ગણતરી કરેલ — આપમેળે અપડેટ થાય છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחושב מהמרכיבים שלך — מתעדכן אוטומטית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सामग्री से परिकलित — अपने-आप अपडेट होता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunato iz sastojaka — automatski se ažurira"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összetevőidből számítva — automatikusan frissül"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung dari bahan Anda — diperbarui otomatis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato dai tuoi ingredienti — si aggiorna automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料から算出 — 自動更新"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ингредиенттеріңіз бойынша есептеледі — автоматты түрде жаңарады"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪದಾರ್ಥಗಳಿಂದ ಲೆಕ್ಕಹಾಕಲಾಗಿದೆ — ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료에서 계산됨 — 자동으로 업데이트됩니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ചേരുവകളിൽ നിന്ന് കണക്കാക്കിയത് — സ്വയമേവ അപ്ഡേറ്റ് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या घटकांवरून मोजलेले — आपोआप अद्ययावत होते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira daripada bahan anda — dikemas kini secara automatik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet ut fra ingrediensene dine — oppdateres automatisk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekend op basis van je ingrediënten — wordt automatisch bijgewerkt"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଉପାଦାନରୁ ଗଣନା କରାଯାଇଛି — ସ୍ୱୟଂଚାଳିତ ଭାବେ ଅପଡେଟ୍ ହୁଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਸਮੱਗਰੀ ਤੋਂ ਗਿਣਿਆ ਗਿਆ — ਆਪਣੇ ਆਪ ਅੱਪਡੇਟ ਹੁੰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczane na podstawie składników — aktualizuje się automatycznie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado a partir dos seus ingredientes — atualizado automaticamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado a partir dos teus ingredientes — atualiza automaticamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculat din ingredientele tale — se actualizează automat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитывается по ингредиентам — обновляется автоматически"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočítané z vašich ingrediencií — aktualizuje sa automaticky"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunano iz vaših sestavin — posodablja se samodejno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beräknad från dina ingredienser – uppdateras automatiskt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பொருட்களிலிருந்து கணக்கிடப்பட்டது — தானாகப் புதுப்பிக்கப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పదార్థాల నుండి లెక్కించబడింది — స్వయంచాలకంగా అప్‌డేట్ అవుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณจากวัตถุดิบของคุณ — อัปเดตอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malzemelerinizden hesaplanır — otomatik güncellenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розраховано з ваших інгредієнтів — оновлюється автоматично"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اجزاء سے حساب کیا گیا — خودکار طور پر اپ ڈیٹ ہوتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính từ nguyên liệu của bạn — tự động cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的食材计算——自动更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你的食材計算 — 自動更新"
          }
        }
      }
    },
    "Not enough recognizable ingredients yet.": {
      "localizations": {
