    "Add ingredients to see a live Ayurveda preview.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مكونات لرؤية معاينة أيورفيدا مباشرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави съставки, за да видиш аюрведичен преглед на живо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ আয়ুর্বেদ পূর্বরূপ দেখতে উপকরণ যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix ingredients per veure una previsualització ayurvèdica en directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte ingredience pro zobrazení živého náhledu ájurvédy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj ingredienser for at se en direkte ayurveda-forhåndsvisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Zutaten hinzu, um eine Live-Ayurveda-Vorschau zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε υλικά για να δεις ζωντανή προεπισκόπηση Αγιουρβέδας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ingredientes para ver una vista previa ayurvédica en directo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega ingredientes para ver una vista previa de Ayurveda en vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ainesosia nähdäksesi reaaliaikaisen ayurveda-esikatselun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des ingrédients pour voir un aperçu ayurvédique en direct."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des ingrédients pour voir un aperçu ayurvédique en direct."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇવ આયુર્વેદ પૂર્વાવલોકન જોવા માટે સામગ્રી ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף מרכיבים כדי לראות תצוגה מקדימה חיה של איורוודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव आयुर्वेद पूर्वावलोकन देखने के लिए सामग्री जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj sastojke za prikaz ayurvedskog pregleda uživo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá összetevőket az élő ájurvédikus előnézethez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan bahan untuk melihat pratinjau Ayurveda secara langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ingredienti per vedere un'anteprima ayurvedica in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料を追加するとアーユルヴェーダのリアルタイムプレビューが表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тікелей Аюрведа көрінісін көру үшін ингредиенттерді қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೇರ ಆಯುರ್ವೇದ ಪೂರ್ವವೀಕ್ಷಣೆಯನ್ನು ನೋಡಲು ಪದಾರ್ಥಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료를 추가하면 실시간 아유르베다 미리보기를 볼 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തത്സമയ ആയുർവേദ പ്രിവ്യൂ കാണാൻ ചേരുവകൾ ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थेट आयुर्वेद पूर्वावलोकन पाहण्यासाठी घटक जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah bahan untuk melihat pratonton Ayurveda secara langsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til ingredienser for å se en direkte Ayurveda-forhåndsvisning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ingrediënten toe om een live Ayurveda-voorvertoning te zien."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଇଭ୍ ଆୟୁର୍ବେଦ ପୂର୍ବାବଲୋକନ ଦେଖିବାକୁ ଉପାଦାନ ଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਵ ਆਯੁਰਵੇਦ ਝਲਕ ਦੇਖਣ ਲਈ ਸਮੱਗਰੀ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj składniki, aby zobaczyć podgląd ajurwedyjski na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione ingredientes para ver uma prévia ayurvédica em tempo real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ingredientes para ver uma pré-visualização Ayurveda em tempo real."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă ingrediente pentru a vedea o previzualizare Ayurveda în timp real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ингредиенты, чтобы увидеть расчёт по Аюрведе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte ingrediencie a zobrazí sa živý náhľad ajurvédy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte sestavine za ajurvedski predogled v živo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ingredienser för en direkt Ayurveda-förhandsvisning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரடி ஆயுர்வேத முன்னோட்டத்தைப் பார்க்கப் பொருட்களைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ ఆయుర్వేద ప్రివ్యూను చూడటానికి పదార్థాలను జోడించండి."
          }
