    "Personal fit changes ranking only; it never hides this food.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملاءمة الشخصية تغيّر الترتيب فقط؛ ولا تخفي هذا الطعام أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Личното съвпадение променя само подредбата; то никога не скрива тази храна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিগত উপযুক্ততা কেবল ক্রম পরিবর্তন করে; এটি কখনোই এই খাবারটি লুকায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'afinitat personal només canvia l'ordenació; no amaga mai aquest aliment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobní vhodnost mění pouze pořadí; tuto potravinu nikdy neskrývá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Personligt match ændrer kun rækkefølgen; det skjuler aldrig denne fødevare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die persönliche Eignung ändert nur die Reihenfolge; dieses Lebensmittel wird dadurch nie ausgeblendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προσωπικό ταίριασμα αλλάζει μόνο την κατάταξη· δεν κρύβει ποτέ αυτή την τροφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La afinidad personal solo cambia el orden; nunca oculta este alimento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La afinidad personal solo cambia el orden; nunca oculta este alimento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilökohtainen sopivuus muuttaa vain järjestystä; se ei koskaan piilota tätä ruokaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilité personnelle modifie uniquement le classement ; elle ne masque jamais cet aliment."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilité personnelle modifie uniquement le classement; elle ne masque jamais cet aliment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વ્યક્તિગત અનુકૂળતા માત્ર ક્રમાંક જ બદલે છે; તે આ ખોરાકને ક્યારેય છુપાવતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאמה אישית משנה רק את הדירוג; היא לעולם אינה מסתירה מזון זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत अनुकूलता केवल रैंकिंग बदलती है; यह इस खाद्य पदार्थ को कभी नहीं छिपाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobna usklađenost mijenja samo poredak; nikada ne skriva ovu namirnicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A személyes illeszkedés csak a rangsorolást módosítja; soha nem rejti el ezt az élelmiszert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecocokan pribadi hanya mengubah peringkat; tidak pernah menyembunyikan makanan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilità personale modifica solo l'ordinamento; non nasconde mai questo alimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の適合度は並び順のみを変更し、この食品を非表示にすることはありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеке сәйкестік тек реттілікті өзгертеді; ол бұл өнімді ешқашан жасырмайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೈಯಕ್ತಿಕ ಹೊಂದಾಣಿಕೆಯು ಶ್ರೇಣೀಕರಣವನ್ನು ಮಾತ್ರ ಬದಲಾಯಿಸುತ್ತದೆ; ಅದು ಈ ಆಹಾರವನ್ನು ಎಂದಿಗೂ ಮರೆಮಾಡುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞춤 적합도는 정렬 순서만 변경하며, 이 식품을 숨기지는 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തിഗത അനുയോജ്യത റാങ്കിംഗ് മാത്രമേ മാറ്റുകയുള്ളൂ; ഇത് ഒരിക്കലും ഈ ഭക്ഷണം മറയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वैयक्तिक अनुकूलता फक्त क्रम बदलते; ती हा अन्नपदार्थ कधीही लपवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesesuaian peribadi hanya mengubah kedudukan; ia tidak sekali-kali menyembunyikan makanan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personlig tilpasning endrer bare rangeringen; den skjuler aldri denne matvaren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoonlijke match verandert alleen de rangschikking; dit voedingsmiddel wordt nooit verborgen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବ୍ୟକ୍ତିଗତ ଉପଯୁକ୍ତତା କେବଳ କ୍ରମ ବଦଳାଏ; ଏହା ଏହି ଖାଦ୍ୟକୁ କେବେ ବି ଲୁଚାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿੱਜੀ ਅਨੁਕੂਲਤਾ ਸਿਰਫ਼ ਦਰਜਾਬੰਦੀ ਬਦਲਦੀ ਹੈ; ਇਹ ਕਦੇ ਵੀ ਇਸ ਭੋਜਨ ਨੂੰ ਨਹੀਂ ਲੁਕਾਉਂਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indywidualne dopasowanie zmienia tylko kolejność; nigdy nie ukrywa tego produktu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A adequação pessoal altera apenas a classificação; ela nunca oculta este alimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A adequação pessoal altera apenas a ordenação; nunca oculta este alimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrivirea personală schimbă doar ordonarea; nu ascunde niciodată acest aliment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональная совместимость влияет только на порядок в списке и никогда не скрывает этот продукт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobná vhodnosť mení iba poradie; túto potravinu nikdy neskryje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osebno ujemanje spremeni samo razvrstitev; tega živila nikoli ne skrije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personlig matchning ändrar endast rangordningen; den döljer aldrig detta livsmedel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பட்ட பொருத்தம் வரிசையை மட்டுமே மாற்றும்; அது இந்த உணவை ஒருபோதும் மறைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తిగత సరిపోలిక ర్యాంకింగ్‌ను మాత్రమే మారుస్తుంది; ఇది ఈ ఆహారాన్ని ఎప్పుడూ దాచదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเหมาะสมเฉพาะบุคคลจะเปลี่ยนเฉพาะการจัดอันดับเท่านั้น โดยจะไม่ซ่อนอาหารนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel uyum yalnızca sıralamayı değiştirir; bu besini asla gizlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональна сумісність змінює лише ранжування й ніколи не приховує цей продукт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاتی مطابقت صرف ترتیب بدلتی ہے؛ یہ اس غذا کو کبھی نہیں چھپاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức độ phù hợp cá nhân chỉ thay đổi thứ hạng, không bao giờ ẩn thực phẩm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人契合度仅改变排序，绝不会隐藏此食物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人契合度僅會改變排序，永遠不會隱藏此食物。"
          }
        }
      }
    },
