    "Are you sure you want to delete '%@' from the list? This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد حذف «%@» من القائمة؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да изтриеш „%@“ от списъка? Това действие не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিত যে তালিকা থেকে '%@' মুছে ফেলতে চান? এই কাজটি আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar «%@» de la llista? Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete položku „%@“ ze seznamu smazat? Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette '%@' fra listen? Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du „%@“ wirklich aus der Liste löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις σίγουρα να διαγράψεις το «%@» από τη λίστα; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@» de la lista? Esta acción no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar '%@' de la lista? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa kohteen '%@' listalta? Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment supprimer « %@ » de la liste ? Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » de la liste? Cette action est irréversible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર યાદીમાંથી '%@' કાઢી નાખવા માંગો છો? આ ક્રિયા પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק את '%@' מהרשימה? לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई '%@' को सूची से डिलीट करना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li sigurno izbrisati '%@' s popisa? Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törlöd a következőt a listáról: „%@”? Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus '%@' dari daftar? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare '%@' dalla lista? Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストから「%@」を削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» элементін тізімнен жойғыңыз келетініне сенімдісіз бе? Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಟ್ಟಿಯಿಂದ '%@' ಅನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 '%@'을(를) 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലിസ്റ്റിൽ നിന്ന് '%@' ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഈ പ്രവൃത്തി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खात्री आहे की तुम्ही '%@' यादीतून हटवू इच्छिता? ही क्रिया पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu memadamkan '%@' daripada senarai? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette «%@» fra listen? Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je '%@' uit de lijst wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଶ୍ଚିତ କି ଯେ ଆପଣ ତାଲିକାରୁ '%@' କୁ ଡିଲିଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି? ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ 'ਤੇ '%@' ਨੂੰ ਸੂਚੀ ਵਿੱਚੋਂ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਲਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć „%@” z listy? Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja apagar '%@' da lista? Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres apagar «%@» da lista? Esta ação não pode ser anulada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur vrei să ștergi „%@” din listă? Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить «%@» из списка? Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať položku „%@“ zo zoznamu? Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali ste prepričani, da želite izbrisati '%@' s seznama? Tega dejanja ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera ”%@” från listan? Denna åtgärd kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டியலிலிருந்து '%@' என்பதை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా జాబితా నుండి '%@' ని తొలగించాలనుకుంటున్నారా? ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบ '%@' ออกจากรายการ? การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' öğesini listeden silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити «%@» зі списку? Цю дію неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی '%@' کو فہرست سے حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں لیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa '%@' khỏi danh sách không? Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要从清单中删除“%@”吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要從清單中刪除「%@」嗎？此動作無法復原。"
          }
        }
      }
    },
