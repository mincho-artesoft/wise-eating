    "This will add workouts for %@. How should workouts for a specific time slot be handled?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إضافة التدريبات لتاريخ %@. كيف ينبغي التعامل مع التدريبات في فترة زمنية محددة؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще добави тренировки за %@. Как да бъдат обработени тренировките за конкретен часови интервал?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে %@-এর জন্য ওয়ার্কআউট যোগ হবে। কোনো নির্দিষ্ট সময়ের জন্য ওয়ার্কআউট কীভাবে পরিচালনা করা হবে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això afegirà entrenaments per al %@. Com s'han de gestionar els entrenaments en una franja horària concreta?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím přidáte tréninky na %@. Jak mají být zpracovány tréninky v konkrétním časovém úseku?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tilføjer træninger for %@. Hvordan skal træninger for et bestemt tidsrum håndteres?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Workouts für %@ hinzugefügt. Wie sollen Workouts für ein bestimmtes Zeitfenster behandelt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα προσθέσει προπονήσεις για %@. Πώς να αντιμετωπιστούν οι προπονήσεις που έχουν συγκεκριμένη ώρα;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirán entrenamientos para el %@. ¿Cómo deben gestionarse los entrenamientos de una franja horaria concreta?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto agregará entrenamientos para el %@. ¿Cómo se deben manejar los entrenamientos de un horario específico?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lisää treenit päivälle %@. Miten tietyn aikavälin treenit tulisi käsitellä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera les entraînements pour le %@. Comment gérer les entraînements d'un créneau horaire donné ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajoutera les entraînements pour le %@. Comment gérer les entraînements d'une plage horaire précise?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી %@ માટે વર્કઆઉટ ઉમેરવામાં આવશે. ચોક્કસ સમય સ્લૉટ માટેના વર્કઆઉટ કેવી રીતે ગોઠવવા જોઈએ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תוסיף אימונים עבור %@. כיצד לטפל באימונים למשבצת זמן מסוימת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %@ के लिए वर्कआउट जुड़ जाएँगे। किसी विशेष समय स्लॉट के वर्कआउट को कैसे संभाला जाए?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim će se dodati treninzi za %@. Kako postupati s treninzima za određeni termin?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez hozzáadja az edzéseket ehhez a dátumhoz: %@. Hogyan kezeljük az egyes idősávok edzéseit?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambahkan latihan untuk %@. Bagaimana latihan untuk slot waktu tertentu harus ditangani?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno aggiunti gli allenamenti per %@. Come gestire gli allenamenti per una fascia oraria specifica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のワークアウトを追加します。特定の時間帯のワークアウトをどのように処理しますか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %@ күніне жаттығуларды қосады. Белгілі бір уақыт аралығындағы жаттығулар қалай өңделсін?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %@ ಗಾಗಿ ವರ್ಕೌಟ್‌ಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ. ನಿರ್ದಿಷ್ಟ ಸಮಯದ ಸ್ಲಾಟ್‌ನ ವರ್ಕೌಟ್‌ಗಳನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸಬೇಕು?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 워크아웃을 추가합니다. 특정 시간대의 워크아웃을 어떻게 처리할까요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %@ എന്നതിനായുള്ള വർക്കൗട്ടുകൾ ചേർക്കും. ഒരു നിശ്ചിത സമയത്തെ വർക്കൗട്ടുകൾ എങ്ങനെ കൈകാര്യം ചെയ്യണം?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे %@ साठी वर्कआउट्स जोडले जातील. ठराविक वेळेच्या स्लॉटमधील वर्कआउट्स कसे हाताळावेत?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menambah senaman untuk %@. Bagaimanakah senaman bagi slot masa tertentu harus dikendalikan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette legger til treningsøkter for %@. Hvordan skal treningsøkter for et bestemt tidsrom håndteres?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden workouts toegevoegd voor %@. Hoe moeten workouts voor een specifiek tijdslot worden afgehandeld?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା %@ ପାଇଁ ୱାର୍କଆଉଟ୍ ଯୋଡ଼ିବ। ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ସମୟ ସ୍ଲଟ୍‌ର ୱାର୍କଆଉଟ୍‌ଗୁଡ଼ିକୁ କିପରି ପରିଚାଳନା କରାଯିବ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ %@ ਲਈ ਵਰਕਆਊਟ ਸ਼ਾਮਲ ਕਰੇਗਾ। ਕਿਸੇ ਖਾਸ ਸਮੇਂ ਦੇ ਸਲਾਟ ਲਈ ਵਰਕਆਊਟਾਂ ਨੂੰ ਕਿਵੇਂ ਸੰਭਾਲਿਆ ਜਾਣਾ ਚਾਹੀਦਾ ਹੈ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to dodanie treningów na %@. Jak obsłużyć treningi w poszczególnych przedziałach czasowych?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso adicionará treinos para %@. Como os treinos de um horário específico devem ser tratados?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá adicionar treinos para %@. Como devem ser tratados os treinos num horário específico?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor adăuga antrenamente pentru %@. Cum ar trebui gestionate antrenamentele pentru un anumit interval orar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки будут добавлены на %@. Как поступать с тренировками на конкретное время?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa pridajú tréningy na %@. Ako sa majú spracovať tréningy pre konkrétny časový úsek?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem bodo dodane vadbe za %@. Kako želite obravnavati vadbe za določen časovni termin?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta lägger till träningspass för %@. Hur ska träningspass för en viss tidslucka hanteras?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது %@ நாளுக்கான பயிற்சி அமர்வுகளைச் சேர்க்கும். குறிப்பிட்ட நேர இடைவெளிக்கான பயிற்சி அமர்வுகளை எவ்வாறு கையாள வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %@ కోసం వర్కవుట్‌లను జోడిస్తుంది. నిర్దిష్ట సమయ స్లాట్ కోసం వర్కవుట్‌లను ఎలా నిర్వహించాలి?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะเพิ่มการออกกำลังกายสำหรับวันที่ %@ คุณต้องการจัดการการออกกำลังกายสำหรับช่วงเวลาที่ระบุอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ için antrenmanları ekleyecektir. Belirli bir zaman dilimindeki antrenmanlar nasıl işlensin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це додасть тренування на %@. Як обробити тренування для конкретного часового проміжку?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %@ کے لیے ورزشیں شامل کرے گا۔ کسی مخصوص وقت کے سلاٹ کی ورزشوں کو کیسے سنبھالا جائے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thêm các buổi tập cho %@. Nên xử lý thế nào với các buổi tập trong một khung giờ cụ thể?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将添加 %@ 的训练。特定时间段的训练应如何处理？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將會新增 %@ 的鍛鍊。應如何處理特定時段的鍛鍊？"
          }
        }
      }
    },
