    "Controls reminders and updates for the entire app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم في التذكيرات والتحديثات للتطبيق بالكامل."
          }
        },
        "bg": {
          "stringUnit": {
