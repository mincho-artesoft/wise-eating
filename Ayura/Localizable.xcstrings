    "Over the past week or two, your skin has most often felt?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الأسبوع أو الأسبوعين الماضيين، كيف بدت بشرتك غالبًا؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През последните една-две седмици кожата ти най-често се усещаше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত এক-দুই সপ্তাহে আপনার ত্বক বেশিরভাগ সময় কেমন মনে হয়েছে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant les últimes una o dues setmanes, com has notat més sovint la teva pell?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaká byla za poslední týden nebo dva nejčastěji vaše pokožka?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste par uger har din hud oftest føltes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hat sich deine Haut in den letzten ein bis zwei Wochen meist angefühlt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τις τελευταίες μία με δύο εβδομάδες, το δέρμα σου το ένιωθες πιο συχνά;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo has notado tu piel más a menudo?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última semana o dos, ¿cómo has sentido tu piel con más frecuencia?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miltä ihosi on useimmiten tuntunut viimeisen viikon tai kahden aikana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, ta peau t'a le plus souvent semblé ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis une ou deux semaines, comment votre peau vous a-t-elle le plus souvent semblé?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા એક-બે અઠવાડિયામાં તમારી ત્વચા મોટે ભાગે કેવી લાગી છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשבוע או בשבועיים האחרונים, איך העור שלך הרגיש לרוב?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक-दो सप्ताह में आपकी त्वचा अधिकतर कैसी महसूस हुई?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakva je najčešće bila tvoja koža u proteklih tjedan ili dva?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt egy-két hétben milyen volt leggyakrabban a bőröd?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama satu atau dua minggu terakhir, kulit Anda paling sering terasa?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'ultima settimana o due, come ti è sembrata più spesso la pelle?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここ1〜2週間、肌はどのような状態が多かったですか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы бір-екі аптада теріңіз көбінесе қандай болып сезілді?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಒಂದು ಅಥವಾ ಎರಡು ವಾರಗಳಿಂದ, ನಿಮ್ಮ ಚರ್ಮವು ಹೆಚ್ಚಾಗಿ ಹೇಗೆ ಅನಿಸಿದೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 1~2주 동안 피부는 주로 어떻게 느껴졌나요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ ഒന്നോ രണ്ടോ ആഴ്ചയായി, നിങ്ങളുടെ ചർമ്മം മിക്കപ്പോഴും എങ്ങനെയായിരുന്നു?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या एक-दोन आठवड्यांत तुमची त्वचा बहुतेकदा कशी जाणवली?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang satu atau dua minggu lalu, kulit anda paling kerap terasa?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De siste én til to ukene har huden din oftest føltes?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe voelde je huid de afgelopen week of twee meestal aan?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତ ଏକ ବା ଦୁଇ ସପ୍ତାହରେ, ଆପଣଙ୍କ ଚର୍ମ ଅଧିକାଂଶ ସମୟରେ କିପରି ଅନୁଭୂତ ହୋଇଛି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਇੱਕ-ਦੋ ਹਫ਼ਤਿਆਂ ਵਿੱਚ, ਤੁਹਾਡੀ ਚਮੜੀ ਅਕਸਰ ਕਿਹੋ ਜਿਹੀ ਮਹਿਸੂਸ ਹੋਈ ਹੈ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaka najczęściej była Twoja skóra w ciągu ostatniego tygodnia lub dwóch?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, sua pele geralmente esteve?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última semana ou duas, como tens sentido a tua pele mais vezes?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultimele una-două săptămâni, cum s-a simțit cel mai des pielea ta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой чаще всего ощущалась ваша кожа в последние неделю-две?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aká bola vaša pokožka za posledný týždeň alebo dva najčastejšie?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakšna je bila vaša koža na otip v zadnjem tednu ali dveh?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur har din hud oftast känts under de senaste en till två veckorna?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த ஒரு வாரம் அல்லது இரண்டு வாரங்களில், உங்கள் தோல் பெரும்பாலும் எப்படி உணரப்பட்டது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత ఒకటి రెండు వారాలుగా, మీ చర్మం ఎక్కువగా ఎలా అనిపించింది?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในช่วงสัปดาห์หรือสองสัปดาห์ที่ผ่านมา ผิวของคุณมักรู้สึกอย่างไร?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir iki haftada cildiniz en sık nasıldı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Протягом останніх тижня-двох ваша шкіра найчастіше була?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گزشتہ ایک دو ہفتوں میں آپ کی جلد اکثر کیسی محسوس ہوئی ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong một hoặc hai tuần qua, làn da của bạn thường có cảm giác thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一两周里，你的皮肤最常感觉？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一兩週，你的皮膚最常感覺如何？"
          }
        }
      }
    },
