        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא סדיר — גדול בימים מסוימים ונעלם באחרים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनियमित — कभी बहुत अधिक, कभी बिल्कुल नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravilan — neke dane velik, druge nikakav"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Változó — néha nagy, máskor nincs"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak teratur — kadang besar, kadang hilang"
