            "state": "translated",
            "value": "יציב אך קל לדחייה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर, पर टालना आसान"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujednačen, ali lako odgodiv"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyenletes, de könnyen halasztható"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabil tetapi mudah ditunda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costante ma facile da rimandare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定しており、遅らせても平気"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірқалыпты, кейінге шегеру оңай"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಿರ ಆದರೆ ಮುಂದೂಡಲು ಸುಲಭ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꾸준하지만 미루기 쉬움"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരവും നീട്ടിവയ്ക്കാൻ എളുപ്പമുള്ളതും"
          }
        },
        "mr": {
          "stringUnit": {
