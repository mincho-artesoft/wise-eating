    "Tap the '+' button to add your first food.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زر '+' لإضافة طعامك الأول."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни бутона „+“, за да добавиш първата си храна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রথম খাবার যোগ করতে '+' বোতামে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó «+» per afegir el teu primer aliment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na tlačítko „+“ přidáte svou první potravinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på '+'-knappen for at tilføje din første fødevare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „+“, um dein erstes Lebensmittel hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το κουμπί «+» για να προσθέσεις την πρώτη σου τροφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón «+» para añadir tu primer alimento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón '+' para agregar tu primer alimento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensimmäinen ruokasi napauttamalla ”+”-painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur le bouton « + » pour ajouter ton premier aliment."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton « + » pour ajouter votre premier aliment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પહેલો ખોરાક ઉમેરવા માટે '+' બટન પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על כפתור ה-'+' כדי להוסיף את המזון הראשון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला खाद्य पदार्थ जोड़ने के लिए '+' बटन पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni gumb '+' da dodaš svoju prvu namirnicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a „+” gombra az első élelmiszer hozzáadásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol '+' untuk menambahkan makanan pertama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante '+' per aggiungere il primo alimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「+」ボタンをタップして最初の食品を追加してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алғашқы өніміңізді қосу үшін «+» түймесін түртіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೊದಲ ಆಹಾರವನ್ನು ಸೇರಿಸಲು '+' ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'+' 버튼을 탭하여 첫 식품을 추가하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ആദ്യത്തെ ഭക്ഷണം ചേർക്കാൻ '+' ബട്ടൺ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पहिला अन्नपदार्थ जोडण्यासाठी '+' बटणावर टॅप करा."
          }
