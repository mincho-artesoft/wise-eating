    "Tap the '+' button to add your first food.": {},
    "Tap the '+' button to add your first recipe.": {},
    "Tap the '+' button to add your first menu.": {},
    "Tap the '+' button to create your first meal plan.": {},
    "You can add items to your favorites by swiping left on them.": {},
    "Select a filter like 'Foods' or 'Recipes' to get started.": {},
    "Create your first meal plan by tapping the '+' button below.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ خطة وجباتك الأولى بالضغط على زر «+» أدناه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създай първия си хранителен план, като докоснеш бутона „+“ долу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের ‘+’ বোতামে ট্যাপ করে আপনার প্রথম খাবার পরিকল্পনা তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el teu primer pla d'àpats tocant el botó «+» de sota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte svůj první jídelníček klepnutím na tlačítko „+“ níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret din første kostplan ved at trykke på '+'-knappen nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle deinen ersten Ernährungsplan, indem du unten auf „+“ tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε το πρώτο σου πλάνο γευμάτων πατώντας το κουμπί '+' παρακάτω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu primer plan de comidas tocando el botón «+» de abajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu primer plan de comidas tocando el botón “+” de abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ensimmäinen ateriasuunnitelmasi napauttamalla alla olevaa ”+”-painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée ton premier plan alimentaire en appuyant sur le bouton « + » ci-dessous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez votre premier plan alimentaire en touchant le bouton « + » ci-dessous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચે '+' બટન પર ટૅપ કરીને તમારી પ્રથમ ભોજન યોજના બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור את תוכנית הארוחות הראשונה שלך על ידי הקשה על כפתור '+' למטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे '+' बटन पर टैप करके अपनी पहली भोजन योजना बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izradi svoj prvi plan prehrane dodirom na gumb '+' ispod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozd létre az első étkezési tervedet az alábbi „+” gombra koppintva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat rencana makan pertama Anda dengan mengetuk tombol '+' di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea il tuo primo piano alimentare toccando il pulsante '+' qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「+」ボタンをタップして、最初の食事プランを作成してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төмендегі «+» түймесін басып, алғашқы тамақтану жоспарыңызды жасаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಳಗಿನ '+' ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಮೊದಲ ಊಟದ ಯೋಜನೆಯನ್ನು ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 '+' 버튼을 탭하여 첫 식단 플랜을 만들어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താഴെയുള്ള '+' ബട്ടൺ ടാപ്പ് ചെയ്ത് നിങ്ങളുടെ ആദ്യ ഭക്ഷണ പദ്ധതി സൃഷ്ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खालील '+' बटणावर टॅप करून तुमची पहिली आहार योजना तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta pelan hidangan pertama anda dengan mengetik butang '+' di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett din første måltidsplan ved å trykke på «+»-knappen nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je eerste maaltijdplan door hieronder op de '+'-knop te tikken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତଳେ ଥିବା '+' ବଟନ୍‌ରେ ଟ୍ୟାପ୍ କରି ଆପଣଙ୍କ ପ୍ରଥମ ଭୋଜନ ଯୋଜନା ତିଆରି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇਠਾਂ '+' ਬਟਨ 'ਤੇ ਟੈਪ ਕਰਕੇ ਆਪਣੀ ਪਹਿਲੀ ਭੋਜਨ ਯੋਜਨਾ ਬਣਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz swój pierwszy plan posiłków, stukając przycisk „+” poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie seu primeiro plano alimentar tocando no botão '+' abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria o teu primeiro plano alimentar tocando no botão '+' abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează-ți primul plan alimentar atingând butonul „+” de mai jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте первый план питания, нажав кнопку «+» ниже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte svoj prvý stravovací plán klepnutím na tlačidlo „+“ nižšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarite svoj prvi načrt obrokov tako, da spodaj tapnete gumb '+'."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa din första måltidsplan genom att trycka på '+'-knappen nedan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீழே உள்ள '+' பொத்தானைத் தட்டி உங்கள் முதல் உணவுத் திட்டத்தை உருவாக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిగువ ఉన్న '+' బటన్‌ను నొక్కడం ద్వారా మీ మొదటి భోజన ప్రణాళికను రూపొందించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างแผนมื้ออาหารแรกของคุณโดยแตะปุ่ม '+' ด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki '+' düğmesine dokunarak ilk öğün planınızı oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть свій перший план харчування, натиснувши кнопку «+» нижче."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے '+' بٹن پر ٹیپ کر کے کھانے کا اپنا پہلا پلان بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo kế hoạch bữa ăn đầu tiên bằng cách chạm vào nút '+' bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点下方的“+”按钮创建你的第一个膳食计划。"
