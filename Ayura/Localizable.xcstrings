    "Tap the ✨ button on training screens to start a new generation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زر ✨ في شاشات التدريب لبدء توليد جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни бутона ✨ на екраните за тренировки, за да започнеш ново генериране."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন জেনারেশন শুরু করতে প্রশিক্ষণ স্ক্রিনে ✨ বোতামে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó ✨ a les pantalles d'entrenament per iniciar una nova generació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové generování spustíte klepnutím na tlačítko ✨ na obrazovkách tréninku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ✨-knappen på træningsskærmene for at starte en ny generering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Trainingsbildschirmen auf die Taste „✨“, um eine neue Generierung zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το κουμπί ✨ στις οθόνες προπόνησης για να ξεκινήσεις νέα δημιουργία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón ✨ en las pantallas de entrenamiento para iniciar una nueva generación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón ✨ en las pantallas de entrenamiento para iniciar una nueva generación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita uusi generointi napauttamalla ✨-painiketta treeninäkymissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur le bouton ✨ sur les écrans d'entraînement pour lancer une nouvelle génération."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton ✨ sur les écrans d'entraînement pour lancer une nouvelle génération."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નવું જનરેશન શરૂ કરવા માટે તાલીમ સ્ક્રીન પર ✨ બટન પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על כפתור ✨ במסכי האימון כדי להתחיל יצירה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया जनरेशन शुरू करने के लिए प्रशिक्षण स्क्रीन पर ✨ बटन पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni gumb ✨ na zaslonima treninga za pokretanje novog generiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új generálás indításához koppints a ✨ gombra az edzésképernyőkön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol ✨ di layar latihan untuk memulai pembuatan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante ✨ nelle schermate di allenamento per avviare una nuova generazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニング画面の✨ボタンをタップして新しい生成を開始してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа генерация бастау үшін жаттығу экрандарындағы ✨ түймесін түртіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ರಚನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ತರಬೇತಿ ಪರದೆಗಳಲ್ಲಿ ✨ ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 생성하려면 트레이닝 화면의 ✨ 버튼을 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ ജനറേഷൻ ആരംഭിക്കാൻ പരിശീലന സ്ക്രീനുകളിലെ ✨ ബട്ടണിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन निर्मिती सुरू करण्यासाठी प्रशिक्षण स्क्रीनवरील ✨ बटणावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang ✨ pada skrin latihan untuk memulakan penjanaan baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ✨-knappen på treningsskjermene for å starte en ny generering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop ✨ op trainingsschermen om een nieuwe generatie te starten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ନୂଆ ଜେନେରେସନ୍ ଆରମ୍ଭ କରିବାକୁ ପ୍ରଶିକ୍ଷଣ ସ୍କ୍ରିନ୍‌ରେ ✨ ବଟନ୍ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਵੀਂ ਜਨਰੇਸ਼ਨ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਸਿਖਲਾਈ ਸਕ੍ਰੀਨਾਂ 'ਤੇ ✨ ਬਟਨ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk ✨ na ekranach treningów, aby rozpocząć nowe generowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão ✨ nas telas de treino para iniciar uma nova geração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão ✨ nos ecrãs de treino para iniciar uma nova geração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul ✨ din ecranele de antrenament pentru a începe o nouă generare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ✨ на экранах тренировок, чтобы начать новую генерацию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na tlačidlo ✨ na obrazovkách tréningu spustíte nové generovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite gumb ✨ na zaslonih za vadbo, da začnete novo ustvarjanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ✨-knappen på träningsskärmarna för att starta en ny generering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய உருவாக்கத்தைத் தொடங்க பயிற்சித் திரைகளில் உள்ள ✨ பொத்தானைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త జనరేషన్‌ను ప్రారంభించడానికి శిక్షణ స్క్రీన్‌లపై ✨ బటన్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่ม ✨ บนหน้าจอการฝึกเพื่อเริ่มสร้างรายการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir oluşturma başlatmak için antrenman ekranlarındaki ✨ düğmesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться кнопки ✨ на екранах тренувань, щоб почати нову генерацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی جنریشن شروع کرنے کے لیے ٹریننگ اسکرینز پر ✨ بٹن پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào nút ✨ trên màn hình tập luyện để bắt đầu tạo mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点训练页面上的 ✨ 按钮即可开始新的生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下鍛鍊畫面上的 ✨ 按鈕即可開始新的生成。"
          }
        }
      }
    },
