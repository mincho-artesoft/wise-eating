    "All meals for all days already have items. Clear some meals if you want to generate new ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع الوجبات لكل الأيام تحتوي بالفعل على عناصر. امسح بعض الوجبات إذا كنت تريد توليد وجبات جديدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички хранения за всички дни вече имат добавени храни. Изчисти някои хранения, ако искаш да генерираш нови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব দিনের সব বেলার খাবারে ইতিমধ্যেই আইটেম রয়েছে। নতুন খাবার তৈরি করতে চাইলে কিছু খাবার খালি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els àpats de tots els dies ja tenen elements. Buida alguns àpats si en vols generar de nous."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna jídla pro všechny dny již obsahují položky. Pokud chcete vygenerovat nová, některá jídla vymažte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle måltider på alle dage har allerede fødevarer. Ryd nogle måltider, hvis du vil generere nye."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Mahlzeiten für alle Tage enthalten bereits Einträge. Leere einige Mahlzeiten, wenn du neue generieren möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα γεύματα για όλες τις ημέρες έχουν ήδη στοιχεία. Άδειασε μερικά γεύματα αν θέλεις να δημιουργήσεις νέα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las comidas de todos los días ya tienen elementos. Vacía algunas comidas si quieres generar otras nuevas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las comidas de todos los días ya tienen elementos. Vacía algunas comidas si quieres generar otras nuevas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikilla kaikkien päivien aterioilla on jo ruokia. Tyhjennä joitakin aterioita, jos haluat luoda uusia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les repas de tous les jours contiennent déjà des éléments. Vide certains repas si tu veux en générer de nouveaux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les repas de tous les jours contiennent déjà des aliments. Videz certains repas si vous voulez en générer de nouveaux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધા દિવસોના તમામ ભોજનમાં પહેલેથી જ વસ્તુઓ છે. જો તમે નવું જનરેટ કરવા માંગતા હો, તો કેટલાક ભોજન સાફ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכל הארוחות בכל הימים כבר יש פריטים. נקה חלק מהארוחות אם תרצה ליצור חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी दिनों के सभी भोजन में पहले से ही आइटम हैं। यदि आप नए भोजन बनाना चाहते हैं, तो कुछ भोजन साफ़ करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi obroci za sve dane već imaju stavke. Očisti neke obroke ako želiš generirati nove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden nap minden étkezéséhez tartozik már elem. Törölj néhány étkezést, ha újakat szeretnél generálni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua waktu makan untuk semua hari sudah memiliki item. Kosongkan beberapa waktu makan jika Anda ingin membuat yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i pasti di tutti i giorni contengono già degli alimenti. Svuota alcuni pasti se vuoi generarne di nuovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての日のすべての食事にすでに食品が登録されています。新しく生成するには、いくつかの食事をクリアしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық күндердегі барлық тамақтану уақытында тағамдар бар. Жаңаларын жасағыңыз келсе, кейбірін тазалаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ದಿನಗಳ ಎಲ್ಲಾ ಊಟಗಳಲ್ಲಿ ಈಗಾಗಲೇ ಪದಾರ್ಥಗಳಿವೆ. ನೀವು ಹೊಸದನ್ನು ರಚಿಸಲು ಬಯಸಿದರೆ ಕೆಲವು ಊಟಗಳನ್ನು ತೆರವುಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 날의 모든 식사에 이미 항목이 있습니다. 새로 생성하려면 일부 식사를 비워 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ദിവസങ്ങളിലെയും എല്ലാ ഭക്ഷണങ്ങളിലും ഇതിനകം ഇനങ്ങൾ ഉണ്ട്. പുതിയവ സൃഷ്ടിക്കണമെങ്കിൽ ചില ഭക്ഷണങ്ങൾ മായ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व दिवसांच्या सर्व जेवणांमध्ये आधीच पदार्थ आहेत. तुम्हाला नवीन तयार करायचे असल्यास काही जेवण साफ करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua hidangan untuk semua hari sudah mempunyai item. Kosongkan beberapa hidangan jika anda mahu menjana yang baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle måltider for alle dager har allerede matvarer. Tøm noen måltider hvis du vil generere nye."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle maaltijden voor alle dagen bevatten al items. Maak enkele maaltijden leeg als je nieuwe wilt genereren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁ ଦିନର ସମସ୍ତ ଭୋଜନରେ ପୂର୍ବରୁ ସାମଗ୍ରୀ ଅଛି। ଯଦି ଆପଣ ନୂଆ ଭୋଜନ ଜେନେରେଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି, ତେବେ କିଛି ଭୋଜନ ଖାଲି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੇ ਦਿਨਾਂ ਦੇ ਸਾਰੇ ਭੋਜਨਾਂ ਵਿੱਚ ਪਹਿਲਾਂ ਹੀ ਚੀਜ਼ਾਂ ਹਨ। ਜੇ ਤੁਸੀਂ ਨਵੇਂ ਭੋਜਨ ਤਿਆਰ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ ਤਾਂ ਕੁਝ ਭੋਜਨ ਸਾਫ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie posiłki we wszystkich dniach mają już produkty. Wyczyść niektóre posiłki, jeśli chcesz wygenerować nowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as refeições de todos os dias já têm itens. Limpe algumas refeições se quiser gerar novas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as refeições de todos os dias já têm itens. Limpa algumas refeições se quiseres gerar novas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate mesele din toate zilele au deja elemente. Golește câteva mese dacă vrei să generezi altele noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во всех приёмах пищи на все дни уже есть продукты. Очистите некоторые приёмы пищи, если хотите сгенерировать новые."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky jedlá pre všetky dni už obsahujú položky. Ak chcete vygenerovať nové, niektoré jedlá vyprázdnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi obroki za vse dni že vsebujejo postavke. Počistite nekaj obrokov, če želite ustvariti nove."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla måltider för alla dagar har redan innehåll. Rensa några måltider om du vill generera nya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து நாட்களுக்குமான எல்லா உணவு வேளைகளிலும் ஏற்கனவே உருப்படிகள் உள்ளன. புதியவற்றை உருவாக்க விரும்பினால் சில உணவு வேளைகளை அழிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని రోజులలోని అన్ని భోజనాలలో ఇప్పటికే పదార్థాలు ఉన్నాయి. మీరు కొత్తవాటిని రూపొందించాలనుకుంటే కొన్ని భోజనాలను క్లియర్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกมื้ออาหารในทุกวันมีรายการอยู่แล้ว ล้างบางมื้อออกหากคุณต้องการสร้างรายการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm günlerdeki tüm öğünlerde zaten öğe var. Yenilerini oluşturmak istiyorsanız bazı öğünleri temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі прийоми їжі на всі дні вже містять продукти. Очистіть деякі прийоми їжі, якщо хочете згенерувати нові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام دنوں کے تمام کھانوں میں پہلے سے اشیاء موجود ہیں۔ اگر آپ نئے کھانے تیار کرنا چاہتے ہیں تو کچھ کھانے صاف کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả bữa ăn của mọi ngày đều đã có món. Hãy xóa bớt một số bữa nếu bạn muốn tạo món mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有日期的所有餐食均已包含项目。如需生成新的餐食，请先清空部分餐食。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有天數的所有餐點都已有項目。如果想生成新的餐點，請先清除部分餐點。"
          }
        }
      }
    },
