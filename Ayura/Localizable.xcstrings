                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "У цього плану тренувань є %lld пов’язане тренування.\n\n• «Видалити лише план» вилучить план, але збереже тренування у вашій бібліотеці вправ.\n• «Видалити план і тренування» видалить і план, і ці пов’язані тренування.\n\nЩо ви хочете зробити?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "У цього плану тренувань є %lld пов’язані тренування.\n\n• «Видалити лише план» вилучить план, але збереже тренування у вашій бібліотеці вправ.\n• «Видалити план і тренування» видалить і план, і ці пов’язані тренування.\n\nЩо ви хочете зробити?"
                }
