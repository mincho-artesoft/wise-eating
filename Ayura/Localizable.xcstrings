    "This profile will have its own private storage and shopping lists.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيكون لهذا الملف الشخصي مخزنه الخاص وقوائم تسوقه الخاصة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този профил ще има собствен склад и списъци за пазаруване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রোফাইলের নিজস্ব আলাদা স্টোরেজ ও কেনাকাটার তালিকা থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest perfil tindrà rebost i llistes de la compra propis i privats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento profil bude mít vlastní soukromé zásoby a nákupní seznamy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne profil får sit eget private lager og egne indkøbslister."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil erhält einen eigenen privaten Vorrat und eigene Einkaufslisten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το προφίλ θα έχει τη δική του ιδιωτική αποθήκη και λίστες αγορών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil tendrá su propio almacén privado y sus propias listas de la compra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil tendrá su propio almacenamiento privado y listas de compras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä profiililla on oma yksityinen varasto ja omat ostoslistat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil disposera de son propre stock privé et de ses propres listes de courses."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil aura son propre stock privé et ses propres listes d'épicerie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રોફાઇલ પાસે તેનો પોતાનો ખાનગી સંગ્રહ અને ખરીદીની યાદીઓ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפרופיל זה יהיו אחסון פרטי ורשימות קניות פרטיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल में अपना निजी भंडार और खरीदारी सूचियाँ होंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj će profil imati vlastito privatno spremište i popise za kupnju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a profilnak saját, privát készlete és bevásárlólistái lesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ini akan memiliki penyimpanan dan daftar belanja pribadi tersendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo avrà la propria dispensa e le proprie liste della spesa private."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールには専用の在庫と買い物リストが割り当てられます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл профильдің өз жеке қоймасы мен сатып алу тізімдері болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರೊಫೈಲ್ ತನ್ನದೇ ಆದ ಖಾಸಗಿ ದಾಸ್ತಾನು ಮತ್ತು ಶಾಪಿಂಗ್ ಪಟ್ಟಿಗಳನ್ನು ಹೊಂದಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필은 전용 보관함과 장보기 목록을 사용합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രൊഫൈലിന് സ്വന്തമായി സ്വകാര്യ സ്റ്റോറേജും ഷോപ്പിംഗ് ലിസ്റ്റുകളും ഉണ്ടായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्रोफाइलचा स्वतःचा खाजगी साठा आणि खरेदीच्या याद्या असतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ini akan mempunyai storan dan senarai beli-belah peribadinya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne profilen får sitt eget private lager og sine egne handlelister."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit profiel krijgt een eigen privévoorraad en eigen boodschappenlijsten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପ୍ରୋଫାଇଲ୍‌ର ନିଜସ୍ୱ ବ୍ୟକ୍ତିଗତ ଷ୍ଟୋରେଜ୍ ଏବଂ କିଣାକିଣି ତାଲିକା ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪ੍ਰੋਫਾਈਲ ਦੀ ਆਪਣੀ ਨਿੱਜੀ ਸਟੋਰੇਜ ਅਤੇ ਖ਼ਰੀਦਦਾਰੀ ਸੂਚੀਆਂ ਹੋਣਗੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten profil będzie mieć własne prywatne zapasy i listy zakupów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil terá sua própria despensa e listas de compras privadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil terá a sua própria despensa e listas de compras privadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest profil va avea propriul stoc privat și propriile liste de cumpărături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого профиля будут собственные запасы и списки покупок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento profil bude mať vlastné súkromné zásoby a nákupné zoznamy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta profil bo imel svojo zasebno shrambo in nakupovalne sezname."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här profilen kommer att ha sitt eget privata förråd och egna inköpslistor."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுயவிவரத்திற்குத் தனிப்பட்ட சேமிப்பகமும் ஷாப்பிங் பட்டியல்களும் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రొఫైల్‌కు తన సొంత ప్రైవేట్ నిల్వ మరియు షాపింగ్ జాబితాలు ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์นี้จะมีคลังอาหารและรายการซื้อของส่วนตัวแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin kendine ait özel deposu ve alışveriş listeleri olacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей профіль матиме власні приватні запаси та списки покупок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پروفائل کا اپنا نجی ذخیرہ اور خریداری کی فہرستیں ہوں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này sẽ có kho lưu trữ và danh sách mua sắm riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此档案将拥有专属的私有库存和购物清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此個人檔案將擁有獨立的私人儲藏庫與購物清單。"
          }
        }
      }
    },
    "Generate First Weekly Meal Plan": {
      "localizations": {
