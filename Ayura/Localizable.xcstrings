        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas het datumbereik aan of wis het filter om al je notities te bekijken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ସମସ୍ତ ନୋଟ୍ ଦେଖିବାକୁ ତାରିଖ ପରିସର ସଜାଡ଼ନ୍ତୁ କିମ୍ବା ଫିଲ୍ଟର୍ ସଫା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਸਾਰੇ ਨੋਡ ਦੇਖਣ ਲਈ ਮਿਤੀ ਸੀਮਾ ਨੂੰ ਵਿਵਸਥਿਤ ਕਰਨ ਜਾਂ ਫ਼ਿਲਟਰ ਸਾਫ਼ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj zmienić zakres dat lub wyczyścić filtr, aby zobaczyć wszystkie swoje notatki."
