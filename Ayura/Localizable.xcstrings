        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବ୍ୟକ୍ତିଗତ ଉପଯୁକ୍ତତା ଦେଖିବା ପାଇଁ %@ ଙ୍କ ନିମନ୍ତେ ଏକ ଆୟୁର୍ବେଦୀୟ ପ୍ରୋଫାଇଲ୍ ତିଆରି କରନ୍ତୁ।"
          }
