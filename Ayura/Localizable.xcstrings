    "Buying Lifetime does not cancel your subscription. Manage your subscription to avoid future renewal charges.": {
      "extractionState": "manual",
      "localizations": {
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਫਟਾਈਮ ਖਰੀਦਣਾ ਤੁਹਾਡੀ ਗਾਹਕੀ ਨੂੰ ਰੱਦ ਨਹੀਂ ਕਰਦਾ ਹੈ। ਭਵਿੱਖ ਵਿੱਚ ਨਵਿਆਉਣ ਦੇ ਖਰਚਿਆਂ ਤੋਂ ਬਚਣ ਲਈ ਆਪਣੀ ਗਾਹਕੀ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpărarea Lifetime nu anulează abonamentul. Gestionați-vă abonamentul pentru a evita taxele viitoare de reînnoire."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Купуването на Lifetime не анулира вашия абонамент. Управлявайте абонамента си, за да избегнете бъдещи такси за подновяване."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar Lifetime no cancela su suscripción. Administre su suscripción para evitar futuros cargos de renovación."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membeli Seumur Hidup tidak membatalkan langganan Anda. Kelola langganan Anda untuk menghindari biaya perpanjangan di masa mendatang."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈഫ്‌ടൈം വാങ്ങുന്നത് നിങ്ങളുടെ സബ്‌സ്‌ക്രിപ്‌ഷൻ റദ്ദാക്കില്ല. ഭാവിയിലെ പുതുക്കൽ നിരക്കുകൾ ഒഴിവാക്കാൻ നിങ്ങളുടെ സബ്‌സ്‌ക്രിപ്‌ഷൻ നിയന്ത്രിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லைஃப்டைம் வாங்குவது உங்கள் சந்தாவை ரத்து செய்யாது. எதிர்கால புதுப்பித்தல் கட்டணங்களைத் தவிர்க்க உங்கள் சந்தாவை நிர்வகிக்கவும்."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar Lifetime no cancela su suscripción. Administre su suscripción para evitar futuros cargos de renovación."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup Lifetime nie powoduje anulowania subskrypcji. Zarządzaj swoją subskrypcją, aby uniknąć przyszłych opłat za przedłużenie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইফটাইম কেনা আপনার সাবস্ক্রিপশন বাতিল করে না। ভবিষ্যতে পুনর্নবীকরণ চার্জ এড়াতে আপনার সদস্যতা পরিচালনা করুন।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto di Lifetime non annulla l'abbonamento. Gestisci il tuo abbonamento per evitare futuri addebiti per rinnovi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائف ٹائم خریدنا آپ کی رکنیت منسوخ نہیں کرتا ہے۔ مستقبل کی تجدید کے چارجز سے بچنے کے لیے اپنی رکنیت کا نظم کریں۔"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar Lifetime no cancel·la la vostra subscripció. Gestioneu la vostra subscripció per evitar futurs càrrecs de renovació."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua trọn đời không hủy đăng ký của bạn. Quản lý đăng ký của bạn để tránh phí gia hạn trong tương lai."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buying Lifetime does not cancel your subscription. Manage your subscription to avoid future renewal charges."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å kjøpe Lifetime kansellerer ikke abonnementet ditt. Administrer abonnementet ditt for å unngå fremtidige fornyelseskostnader."
