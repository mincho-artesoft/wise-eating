    "Length": {},
    "Choose your pace": {},
    "Options shorter than the spoken practice were hidden.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إخفاء الخيارات الأقصر من الممارسة الصوتية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опциите, по-кратки от озвучената практика, бяха скрити."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কণ্ঠ-নির্দেশিত অভ্যাসের চেয়ে কম সময়ের বিকল্পগুলো লুকানো হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han amagat les opcions més curtes que la pràctica parlada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti kratší než mluvená praxe byly skryty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Muligheder, der er kortere end den indtalte øvelse, blev skjult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionen, die kürzer als die gesprochene Übung sind, wurden ausgeblendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές που είναι μικρότερες από την εκφωνούμενη πρακτική αποκρύφθηκαν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han ocultado las opciones más cortas que la práctica narrada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ocultaron las opciones más cortas que la práctica narrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhuttua harjoitusta lyhyemmät vaihtoehdot piilotettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options plus courtes que la pratique audio ont été masquées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options plus courtes que la pratique parlée ont été masquées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બોલાયેલા અભ્યાસ કરતાં ટૂંકા વિકલ્પો છુપાવવામાં આવ્યા હતા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרויות קצרות יותר מהתרגול הקולי הוסתרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोले गए अभ्यास से छोटे विकल्प छिपाए गए थे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcije kraće od govorne prakse skrivene su."
          }
        },
        "hu": {
