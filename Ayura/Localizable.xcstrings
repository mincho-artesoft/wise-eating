          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не се предлага като храна. Показано е само за справка — не се предоставят порция или препоръка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খাবার হিসেবে প্রযোজ্য নয়। কেবল তথ্যের জন্য দেখানো হয়েছে — কোনো পরিবেশন বা সুপারিশ দেওয়া হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible com a aliment. Es mostra només com a referència — no s'ofereix cap ració ni recomanació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není k dispozici jako potravina. Zobrazeno pouze pro informaci — bez porcí a doporučení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilgængelig som fødevare. Vises kun som reference — ingen portion eller anbefaling gives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht als Lebensmittel verfügbar. Nur zur Information angezeigt — ohne Portionsangabe oder Empfehlung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν διατίθεται ως τρόφιμο. Εμφανίζεται μόνο για αναφορά — δεν παρέχεται μερίδα ή σύσταση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible como alimento. Se muestra solo como referencia; no se ofrece ración ni recomendación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No está disponible como alimento. Se muestra solo como referencia; no se ofrece porción ni recomendación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei saatavilla elintarvikkeena. Näytetään vain viitteeksi — annoskokoa tai suositusta ei anneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponible comme aliment. Affiché à titre indicatif uniquement — aucune portion ni recommandation n'est fournie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponible comme aliment. Affiché à titre de référence uniquement — aucune portion ni recommandation n'est fournie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોરાક તરીકે ઉપલબ્ધ નથી. ફક્ત સંદર્ભ માટે દર્શાવેલ છે — કોઈ સર્વિંગ કે ભલામણ આપવામાં આવતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינו זמין כמזון. מוצג לעיון בלבד — לא מסופקת מנה או המלצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन के रूप में उपलब्ध नहीं। केवल संदर्भ के लिए दिखाया गया है — कोई सर्विंग या अनुशंसा नहीं दी जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije dostupno kao namirnica. Prikazano samo informativno — bez porcije i bez preporuke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élelmiszerként nem elérhető. Csak tájékoztatásként szerepel — adagolást vagy ajánlást nem adunk meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia sebagai makanan. Ditampilkan hanya sebagai referensi — tidak ada takaran saji atau rekomendasi yang diberikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile come alimento. Mostrato solo come riferimento — non sono fornite porzioni né raccomandazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品としては利用できません。参考情報としてのみ表示されており、摂取量や推奨は提供されません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағам ретінде қолжетімсіз. Тек анықтама үшін көрсетілген — порция не ұсыныс берілмейді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಹಾರವಾಗಿ ಲಭ್ಯವಿಲ್ಲ. ಕೇವಲ ಉಲ್ಲೇಖಕ್ಕಾಗಿ ತೋರಿಸಲಾಗಿದೆ — ಯಾವುದೇ ಪ್ರಮಾಣ ಅಥವಾ ಶಿಫಾರಸು ನೀಡಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식품으로 섭취할 수 없습니다. 참고용으로만 표시되며 제공량이나 추천은 제공되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭക്ഷണമായി ലഭ്യമല്ല. റഫറൻസിനായി മാത്രം കാണിക്കുന്നു — അളവോ ശുപാർശയോ നൽകുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्न म्हणून उपलब्ध नाही. केवळ संदर्भासाठी दाखवले आहे — कोणतेही सर्व्हिंग किंवा शिफारस दिलेली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia sebagai makanan. Dipaparkan untuk rujukan sahaja — tiada hidangan atau syor disediakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilgjengelig som matvare. Vises kun som referanse — ingen porsjon eller anbefaling gis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet beschikbaar als voedingsmiddel. Alleen ter referentie getoond — er wordt geen portie of aanbeveling gegeven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଖାଦ୍ୟ ଭାବରେ ଉପଲବ୍ଧ ନୁହେଁ। କେବଳ ସନ୍ଦର୍ଭ ପାଇଁ ଦେଖାଯାଇଛି — କୌଣସି ପରିବେଷଣ କିମ୍ବା ସୁପାରିଶ ପ୍ରଦାନ କରାଯାଇନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੋਜਨ ਵਜੋਂ ਉਪਲਬਧ ਨਹੀਂ। ਸਿਰਫ਼ ਜਾਣਕਾਰੀ ਲਈ ਦਿਖਾਇਆ ਗਿਆ ਹੈ — ਕੋਈ ਸਰਵਿੰਗ ਜਾਂ ਸਿਫ਼ਾਰਸ਼ ਨਹੀਂ ਦਿੱਤੀ ਜਾਂਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne jako żywność. Wyświetlane wyłącznie informacyjnie — bez porcji ani zaleceń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não disponível como alimento. Exibido apenas para referência — nenhuma porção ou recomendação é fornecida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não disponível como alimento. Mostrado apenas para referência — não é fornecida porção nem recomendação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponibil ca aliment. Afișat doar ca referință — nu se oferă porție sau recomandare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не используется как продукт питания. Показано только для справки — порции и рекомендации не приводятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je určené ako potravina. Zobrazené len pre informáciu — bez porcie a odporúčania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni na voljo kot živilo. Prikazano le informativno — brez navedbe porcije ali priporočila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej tillgängligt som livsmedel. Visas endast som referens — ingen portion eller rekommendation ges."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவாகக் கிடைப்பதில்லை. தகவலுக்காக மட்டுமே காட்டப்படுகிறது — பரிமாறும் அளவோ பரிந்துரையோ வழங்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహారంగా అందుబాటులో లేదు. సూచన కోసం మాత్రమే చూపబడింది — సర్వింగ్ లేదా సిఫార్సు అందించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่จัดเป็นอาหาร แสดงไว้เพื่ออ้างอิงเท่านั้น — ไม่มีข้อมูลหน่วยบริโภคหรือคำแนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besin olarak kullanılmaz. Yalnızca referans olarak gösterilir — porsiyon veya öneri sunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не призначено для вживання як їжа. Показано лише для довідки — порція та рекомендації не надаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غذا کے طور پر دستیاب نہیں۔ صرف حوالے کے لیے دکھایا گیا ہے — کوئی سرونگ یا تجویز فراہم نہیں کی جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng làm thực phẩm. Chỉ hiển thị để tham khảo — không cung cấp khẩu phần hay khuyến nghị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可作为食物食用。仅供参考——不提供份量或食用建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不可作為食物。僅供參考——不提供份量或食用建議。"
          }
        }
      }
    },
