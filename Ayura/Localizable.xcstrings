        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε ένα αγιουρβεδικό προφίλ για %@ ώστε να βλέπεις το προσωπικό ταίριασμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil ayurvédico para %@ para ver la afinidad personal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil ayurvédico para %@ para ver la afinidad personal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ayurvedinen profiili käyttäjälle %@ nähdäksesi henkilökohtaisen sopivuuden."
          }
        },
        "fr": {
          "stringUnit": {
